<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <title>Admin – IFD Meet</title>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500&family=Roboto&display=swap" rel="stylesheet"/>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Roboto',sans-serif;background:#f1f3f4;min-height:100vh;padding:40px 20px}
    .container{max-width:560px;margin:0 auto}
    h1{font-family:'Google Sans',sans-serif;font-size:28px;font-weight:400;color:#6d1a2e;margin-bottom:28px}
    .card{background:#fff;border-radius:12px;padding:28px;box-shadow:0 1px 4px rgba(0,0,0,.1);margin-bottom:20px}
    .card h2{font-family:'Google Sans',sans-serif;font-size:18px;margin-bottom:20px}
    label{display:block;font-size:13px;color:#5f6368;margin-bottom:5px;margin-top:14px}
    input,textarea{width:100%;border:1px solid #dadce0;border-radius:4px;padding:10px 14px;font-size:14px;outline:none}
    input:focus,textarea:focus{border-color:#6d1a2e}
    textarea{min-height:80px;resize:vertical;font-family:'Roboto',sans-serif}
    .radio-row{display:flex;gap:24px;margin-top:6px}
    .radio-row label{display:flex;align-items:center;gap:8px;color:#202124;cursor:pointer;margin:0;font-size:14px}
    .btn{background:#6d1a2e;color:#fff;border:none;padding:12px 24px;border-radius:4px;font-size:14px;cursor:pointer;margin-top:20px;font-family:'Google Sans',sans-serif}
    .btn:hover{background:#8b2239}
    #result{margin-top:14px;padding:10px 14px;border-radius:6px;font-size:14px;display:none}
    .ok{background:#e6f4ea;color:#1e7e34}.err{background:#fce8eb;color:#9c1f2e}
    a{color:#6d1a2e;font-size:14px;display:inline-block;margin-bottom:20px}
    .status-pill{display:inline-block;padding:6px 14px;border-radius:20px;font-size:13px;font-weight:500;margin-bottom:16px}
    .pill-ok{background:#e6f4ea;color:#1e7e34}.pill-warn{background:#fef7e0;color:#856404}
  </style>
</head>
<body>
  <div class="container">
    <a href="/">← Volver al inicio</a>
    <h1>⚙️ Panel de administración</h1>
    <div class="card">
      <h2>Estado del servidor</h2>
      <div class="status-pill <%= status.maintenance ? 'pill-warn' : 'pill-ok' %>">
        <%= status.maintenance ? '⚠️ En mantenimiento' : '✅ En línea' %>
      </div>
      <form id="form">
        <label>Contraseña admin</label>
        <input type="password" name="password" required placeholder="••••••••"/>
        <label>Estado</label>
        <div class="radio-row">
          <label><input type="radio" name="maintenance" value="false" <%= !status.maintenance?'checked':'' %>/> Normal (en línea)</label>
          <label><input type="radio" name="maintenance" value="true" <%= status.maintenance?'checked':'' %>/> En mantenimiento</label>
        </div>
        <label>Mensaje para usuarios</label>
        <textarea name="message" placeholder="Ej: Sistema en mantenimiento. Volvemos en 30 min."><%= status.message||'' %></textarea>
        <button type="submit" class="btn">Actualizar en tiempo real</button>
      </form>
      <div id="result"></div>
    </div>
    <div class="card">
      <h2>Info</h2>
      <p style="font-size:14px;color:#5f6368;line-height:1.7">Los cambios se notifican a todos los usuarios conectados en tiempo real via WebSocket.<br/>Contraseña actual: <strong>ifd2024</strong> (cambiala en server.js)</p>
    </div>
  </div>
  <script>
    document.getElementById("form").addEventListener("submit", async e => {
      e.preventDefault();
      const fd = new FormData(e.target);
      const body = Object.fromEntries(fd);
      const res = document.getElementById("result");
      try {
        const r = await fetch("/admin/status", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify(body) });
        const d = await r.json();
        res.style.display = "block";
        res.className = d.ok ? "ok" : "err";
        res.textContent = d.ok ? "✅ Estado actualizado correctamente" : "❌ " + d.error;
      } catch { res.style.display="block"; res.className="err"; res.textContent="❌ Error de conexión"; }
    });
  </script>
</body>
</html>