//  SALA PRINCIPAL
// ════════════════════════════════════════════════════════
const socket = io();
let miPeer = null, miStream = null, screenStream = null;
const peers = {}, participantes = {};
const state = { micOn: true, camOn: true, screenOn: false };

async function iniciarSala() {
  document.getElementById('room-code').textContent = window.ROOM_ID;
  iniciarReloj();
  await iniciarMedia();
  iniciarPeerJS();
  renderParticipantes();
}

async function iniciarMedia() {
  try {
    miStream = await navigator.mediaDevices.getUserMedia({
      video: { width:{ideal:1280}, height:{ideal:720} },
      audio: { echoCancellation:true, noiseSuppression:true }
    });
    state.micOn = lobbyMicOn;
    state.camOn = lobbyCamOn;
    miStream.getAudioTracks().forEach(t => t.enabled = state.micOn);
    miStream.getVideoTracks().forEach(t => t.enabled = state.camOn);
    if (!state.micOn) { document.getElementById('btn-mic').classList.add('muted'); document.getElementById('icon-mic').textContent='mic_off'; }
    if (!state.camOn) { document.getElementById('btn-cam').classList.add('muted'); document.getElementById('icon-cam').textContent='videocam_off'; }
  } catch(err) { console.warn('Sin cámara/mic:', err); }
  if (miStream) agregarVideo(miStream, 'yo', 'Tú (' + window.USER_NAME + ')', true);
}

function iniciarPeerJS() {
  miPeer = new Peer(undefined, {
    path: '/peerjs', host: location.hostname,
    port: location.port || (location.protocol === 'https:' ? 443 : 80)
  });
  miPeer.on('open', id => {
    socket.emit('join-room', window.ROOM_ID, id, window.USER_NAME, window.IS_HOST, window.USER_EMAIL, window.USER_PHOTO);
  });
  miPeer.on('call', call => {
    if (miStream) call.answer(miStream);
    call.on('stream', s => {
      const p = participantes[call.peer];
      agregarVideo(s, call.peer, p?.nombre || 'Participante', false);
    });
    peers[call.peer] = call;
  });
}

