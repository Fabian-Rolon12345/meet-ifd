<!-- ══════════════════════════════════════════════
     MODAL IFD PASSWORD (para invitados sin Google)
══════════════════════════════════════════════ -->
<!-- MODAL NOMBRE INVITADO: solo para quien no está logueado con Google -->
<div id="ifd-modal">
  <div class="ifd-card">
    <div style="text-align:center;margin-bottom:22px">
      <div class="ifd-logo">
        <img src="/img/logo-ifd.png" alt="IFD"
             onerror="this.style.display='none';this.parentNode.querySelector('.fb').style.display='block'"/>
        <span class="fb" style="display:none">🎓</span>
      </div>
      <h2>IFD Meet</h2>
      <p class="ifd-sub">Instituto de Formación Docente<br>Santa Rosa, Misiones</p>
    </div>
    <!-- Solo pide nombre — sin contraseña para invitados -->
    <label class="ifd-lbl">Tu nombre completo</label>
    <div class="ifd-iw">
      <input type="text" id="ifd-name" placeholder="Nombre y Apellido Completo "
             onkeydown="if(event.key==='Enter')ifdEnter()"
             style="letter-spacing:0"/>
    </div>
    <p class="ifd-hint" style="margin-bottom:16px">Este nombre se verá en la reunión</p>
    <div class="ifd-err" id="ifd-err"><span>⚠️</span><span id="ifd-err-txt">Escribí tu nombre para continuar</span></div>
    <button class="ifd-btn" onclick="ifdEnter()">
      <span style="font-size:18px">📹</span> Solicitar unirse
