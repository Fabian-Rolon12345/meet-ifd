// Nuevo usuario de video conectado
socket.on('user-connected', (peerId, nombre, email, foto) => {
  parts[peerId] = { name: nombre, email: email||'', photo: foto||'', mic:true, cam:true };
  if (myStream) {
    const tryCall = (attempt) => {
      if (attempt > 3) return;
      setTimeout(() => {
        try {
          const call = myPeer.call(peerId, myStream);
          if (call) {
            call.on('stream', s => addTile(s, peerId, nombre, false));
            call.on('error', () => tryCall(attempt + 1));
            peers[peerId] = call;
          } else { tryCall(attempt + 1); }
        } catch(e) { tryCall(attempt + 1); }
      }, 800 * attempt);
    };
    tryCall(1);
  }
  sysMsg(nombre + ' se unió a la reunión'); renderParts(); updCount(); playSound('join');
});

socket.on('peer-id-updated', ({ tempId, peerId, userName, userEmail, userPhoto }) => {
  // Registrar participante con peerId real
  if (!parts[peerId]) {
    parts[peerId] = { name: userName || parts[tempId]?.name || 'Participante', email: userEmail, photo: userPhoto, mic: true, cam: true };
  }
  // Llamar para video
  if (myStream && myPeer && !peers[peerId]) {
    setTimeout(() => {
      try {
        const call = myPeer.call(peerId, myStream);
        if (call) {
          const nombre = parts[peerId]?.name || 'Participante';
          call.on('stream', s => addTile(s, peerId, nombre, false));
          call.on('error', e => console.warn('call error:', e));
          peers[peerId] = call;
        }
      } catch(e) { console.warn('peer-id-updated call error:', e); }
    }, 600);
  }
  renderParts(); updCount();
});

socket.on('user-disconnected', (peerId, nombre) => {
  // 1. Cerrar conexión peer
  try { if (peers[peerId]) { peers[peerId].close(); delete peers[peerId]; } } catch(e) {}
  // 2. Si estaba en spotlight, limpiar primero
  if (spotlightId === peerId) clearSpotlight();
  // 3. Animar salida del tile
  const tile = document.getElementById('tile-' + peerId);
  if (tile) {
    tile.style.transition = 'opacity .3s, transform .3s';
    tile.style.opacity = '0';
    tile.style.transform = 'scale(.9)';
    setTimeout(() => {
      // Mover al grid normal si estaba en strip o mainWrap
      try { document.getElementById('vgrid').appendChild(tile); } catch(e) {}
      tile.remove();
      fixGrid();
    }, 300);
  }
  const n = nombre || parts[peerId]?.name || 'Alguien';
  delete parts[peerId];
  sysMsg(n + ' salió de la reunión');
  toast('👋 ' + n + ' salió de la reunión', '#5f6368', 3000);
  renderParts();
  updCount();
  if (!tile) fixGrid(); // si no había tile, igual recalcular
  playSound('leave');
});

