//  SALA
// ═══════════════════════════════════════════
let myPeer = null, myStream = null, screenStream = null;
const peers = {}, parts = {};
const st = { mic:true, cam:true, screen:false };

async function initRoom() {
  document.getElementById('room-code').textContent = ROOM_ID.slice(0,8) + '...';
  startClock();
  await initMedia();
  if (IS_CREATOR) {
    initPeer(); // host: initPeer emite join-room
  } else {
    initPeerAdmitted(); // invitado admitido: solo conecta peer sin re-emitir join-room
  }
  renderParts();
}

async function initMedia() {
  try {
    myStream = await navigator.mediaDevices.getUserMedia({
      video:{ width:{ideal:1280}, height:{ideal:720} },
      audio:{ echoCancellation:true, noiseSuppression:true }
    });
    st.mic = lMicOn; st.cam = lCamOn;
    myStream.getAudioTracks().forEach(t => t.enabled = st.mic);
    myStream.getVideoTracks().forEach(t => t.enabled = st.cam);
    if (!st.mic) { document.getElementById('btn-mic').classList.add('muted'); document.getElementById('ic-mic').textContent='mic_off'; }
    if (!st.cam) { document.getElementById('btn-cam').classList.add('muted'); document.getElementById('ic-cam').textContent='videocam_off'; }
  } catch(e) { console.warn('Sin cam/mic:', e); }
  if (myStream) addTile(myStream, 'yo', 'Tú (' + myName + ')', true);
}

function initPeer() {
  const peerPort = location.port ? parseInt(location.port) : (location.protocol === 'https:' ? 443 : 80);

  myPeer = new Peer(undefined, {
    path:'/peerjs', host: location.hostname, port: peerPort,
    config: {
      iceServers: [
        { urls: 'stun:stun.l.google.com:19302' },
        { urls: 'stun:stun1.l.google.com:19302' },
        { urls: 'turn:openrelay.metered.ca:80',  username: 'openrelayproject', credential: 'openrelayproject' },
        { urls: 'turn:openrelay.metered.ca:443', username: 'openrelayproject', credential: 'openrelayproject' },
        { urls: 'turn:openrelay.metered.ca:443?transport=tcp', username: 'openrelayproject', credential: 'openrelayproject' }
      ]
    }
  });

  // ✅ CLAVE: emitir join-room por socket INMEDIATAMENTE con id temporal.
  // No esperamos a PeerJS para registrarnos en el servidor.
  const tempId = 'tmp-' + Math.random().toString(36).slice(2, 10);
  console.log('📡 join-room enviado, tempId:', tempId, 'IS_CREATOR:', IS_CREATOR);
  socket.emit('join-room', ROOM_ID, tempId, myName, myEmail, myPhoto, IS_CREATOR);

  myPeer.on('open', id => {
    console.log('✅ PeerJS listo, ID:', id);
    // Actualizar el servidor con el peerId real para llamadas de video
    socket.emit('peer-ready', { roomId: ROOM_ID, peerId: id, tempId });
  });

  myPeer.on('call', call => {
    call.answer(myStream || undefined);
    call.on('stream', s => {
      const p = parts[call.peer];
      addTile(s, call.peer, p?.name || 'Participante', false);
    });
    call.on('error', e => console.warn('Call error:', e));
    peers[call.peer] = call;
  });

  myPeer.on('error', e => {
    console.warn('PeerJS error:', e.type);
    if (['disconnected','network','server-error'].includes(e.type)) {
      setTimeout(() => { try { if (myPeer.disconnected) myPeer.reconnect(); } catch(_) {} }, 2000);
    }
  });

  myPeer.on('disconnected', () => {
    setTimeout(() => { try { myPeer.reconnect(); } catch(_) {} }, 2000);
  });
}

// Invitado admitido: conectar PeerJS sin emitir join-room (ya está en la sala)
function initPeerAdmitted() {
  const peerPort = location.port ? parseInt(location.port) : (location.protocol === 'https:' ? 443 : 80);
  myPeer = new Peer(undefined, {
    path:'/peerjs', host: location.hostname, port: peerPort,
    config: { iceServers: [
      { urls: 'stun:stun.l.google.com:19302' },
      { urls: 'stun:stun1.l.google.com:19302' },
      { urls: 'turn:openrelay.metered.ca:80',  username: 'openrelayproject', credential: 'openrelayproject' },
      { urls: 'turn:openrelay.metered.ca:443', username: 'openrelayproject', credential: 'openrelayproject' }
    ]}
  });
  myPeer.on('open', id => {
    console.log('✅ PeerJS admitido, ID:', id);
    // Avisar al servidor el peerId real para que el host pueda llamar
    socket.emit('peer-ready', { roomId: ROOM_ID, peerId: id, tempId: 'admitted' });
    // Llamar a todos los que ya están en la sala
    Object.keys(parts).forEach(peerId => {
      if (!peers[peerId]) {
        setTimeout(() => {
          try {
            const call = myPeer.call(peerId, myStream);
            if (call) {
              call.on('stream', s => addTile(s, peerId, parts[peerId]?.name || 'Participante', false));
              peers[peerId] = call;
            }
          } catch(e) {}
        }, 600);
      }
    });
  });
  myPeer.on('call', call => {
    call.answer(myStream || undefined);
    call.on('stream', s => {
      const p = parts[call.peer];
      addTile(s, call.peer, p?.name || 'Participante', false);
    });
    peers[call.peer] = call;
  });
  myPeer.on('error', e => console.warn('PeerJS error:', e.type));
}

// ═══════════════════════════════════════════
//  SONIDOS
// ═══════════════════════════════════════════
function playSound(type) {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.connect(gain); gain.connect(ctx.destination);
    if (type === 'join') {
      osc.frequency.setValueAtTime(523, ctx.currentTime);
      osc.frequency.setValueAtTime(659, ctx.currentTime + 0.1);
      osc.frequency.setValueAtTime(784, ctx.currentTime + 0.2);
      gain.gain.setValueAtTime(0.3, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.5);
      osc.start(); osc.stop(ctx.currentTime + 0.5);
    } else if (type === 'leave') {
      osc.frequency.setValueAtTime(784, ctx.currentTime);
      osc.frequency.setValueAtTime(523, ctx.currentTime + 0.15);
      gain.gain.setValueAtTime(0.3, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
      osc.start(); osc.stop(ctx.currentTime + 0.4);
    }
  } catch(e) {}
}

// ═══════════════════════════════════════════
//  DETECTOR DE VOZ (quién habla)
// ═══════════════════════════════════════════
function startSpeakingDetector(stream, tileId) {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const src = ctx.createMediaStreamSource(stream);
    const analyser = ctx.createAnalyser();
    analyser.fftSize = 512;
    src.connect(analyser);
    const data = new Uint8Array(analyser.frequencyBinCount);
    let speaking = false;
    setInterval(() => {
      analyser.getByteFrequencyData(data);
      const vol = data.reduce((a, b) => a + b, 0) / data.length;
      const tile = document.getElementById('tile-' + tileId);
      if (!tile) return;
      const isSpeaking = vol > 15;
      if (isSpeaking !== speaking) {
        speaking = isSpeaking;
        tile.classList.toggle('speaking', isSpeaking);
        // Mostrar nombre del que habla
        const lbl = tile.querySelector('.vlbl');
        if (lbl) lbl.style.background = isSpeaking ? 'rgba(30,142,62,0.85)' : 'rgba(0,0,0,0.65)';
      }
    }, 100);
  } catch(e) {}
}

