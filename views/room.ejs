// ═══ NOTIFICACIÓN DE SOLICITUD ═══
function mostrarSolicitud(sid, nombre, email, foto) {
  if (notifQueue.find(u => u.sid === sid) || (notifActual && notifActual.sid === sid)) return;
  // 1. Agregar al panel de solicitudes
  addRequest(sid, nombre, email, foto);
  // 2. Mostrar botón de solicitudes en header
  const btnSol = document.getElementById('btn-solicitudes');
  if (btnSol) btnSol.style.display = 'flex';
  // 3. Mostrar pestaña Solicitudes
  const reqTab = document.getElementById('tab-requests');
  if (reqTab && amIHost) reqTab.style.display = 'flex';
  // 4. Encolar para notif emergente (3 segundos)
  notifQueue.push({ sid, nombre, email, foto });
  if (!notifActual) mostrarSiguienteNotif();
}

function mostrarSiguienteNotif() {
  if (!notifQueue.length) { notifActual = null; return; }
  notifActual = notifQueue.shift();
  const n = document.getElementById('admit-notif');
  document.getElementById('admit-name').textContent = notifActual.nombre || 'Invitado';
  n.style.display = 'block';
  // Auto-ocultar después de 3 segundos → queda en el panel
  clearTimeout(window._notifTimer);
  window._notifTimer = setTimeout(() => {
    n.style.display = 'none';
    notifActual = null;
    setTimeout(mostrarSiguienteNotif, 500);
  }, 3000);
}

function admitirDesdeNotif() {
  if (!notifActual) return;
  admitUser(notifActual.sid);
  document.getElementById('admit-notif').style.display = 'none';
  notifActual = null;
  setTimeout(mostrarSiguienteNotif, 300);
}

function rechazarDesdeNotif() {
  if (!notifActual) return;
  rejectUser(notifActual.sid);
  document.getElementById('admit-notif').style.display = 'none';
  notifActual = null;
  setTimeout(mostrarSiguienteNotif, 300);
}

function toggleSolicitudes() {
  if (amIHost) {
    openPanel('requests');
  } else {
    openPanel('people');
  }
}

function updBadgeSol() {
  updReqCount();
}

function addRequest(sid, nombre, email, foto) {
  if (document.getElementById('req-' + sid)) return;
  const list = document.getElementById('req-list');
  const ini  = (nombre || '?')[0].toUpperCase();
  const item = document.createElement('div');
  item.className = 'rpi'; item.id = 'req-' + sid;
  item.innerHTML = `
    <div class="rpi-ava">
      ${foto ? `<img src="${escH(foto)}" style="width:100%;height:100%;object-fit:cover;border-radius:50%" onerror="this.style.display='none'"/>` : escH(ini)}
    </div>
    <div class="rpi-info">
