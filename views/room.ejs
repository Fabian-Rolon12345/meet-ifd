// ════════════════════════════════════════════════════════
//  CHAT
// ════════════════════════════════════════════════════════
let pendingFiles=[], lastDateShown='';

function chatKeyDown(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendMessage();}}
function autoResize(el){el.style.height='auto';el.style.height=Math.min(el.scrollHeight,130)+'px';}

function handlePaste(e) {
  const items=e.clipboardData?.items; if(!items) return;
  for(const item of items){
    if(item.type.startsWith('image/')){e.preventDefault();const f=item.getAsFile();if(f)addPendingFile(f);return;}
  }
}

function triggerImagePick(){
  const inp=document.createElement('input');inp.type='file';inp.accept='image/*';inp.multiple=true;
  inp.onchange=()=>handleFileSelect(inp.files);inp.click();
}

function handleFileSelect(files){for(const f of files)addPendingFile(f);document.getElementById('file-input').value='';}
function addPendingFile(f){pendingFiles.push(f);renderAttachPreview();}
function cancelAttach(){pendingFiles=[];renderAttachPreview();}

function renderAttachPreview(){
  const box=document.getElementById('attach-preview'),inner=document.getElementById('attach-preview-inner');
  if(!pendingFiles.length){box.style.display='none';inner.innerHTML='';return;}
  box.style.display='flex';inner.innerHTML='';
  pendingFiles.forEach(f=>{
    const w=document.createElement('div');
    if(f.type.startsWith('image/')){
      w.className='preview-thumb';const img=document.createElement('img');img.src=URL.createObjectURL(f);w.appendChild(img);
    }else{
      w.className='preview-file-info';
      w.innerHTML=`<span class="material-icons-round">${fileIcon(f.name)}</span><span class="preview-filename">${escHtml(f.name)}</span>`;
    }
    inner.appendChild(w);
  });
}

async function sendMessage(){
  const input=document.getElementById('chat-input'),texto=input.value.trim();
  if(pendingFiles.length>0){for(const f of pendingFiles)await uploadAndSend(f);pendingFiles=[];renderAttachPreview();}
  if(texto){
    const data={roomId:window.ROOM_ID,nombre:window.USER_NAME,texto,tipo:'text'};
    socket.emit('send-message',data);renderMensaje({...data,propio:true});
    input.value='';input.style.height='auto';
  }
}

async function uploadAndSend(file){
  const fd=new FormData();fd.append('file',file);
  try{
    const res=await fetch('/upload',{method:'POST',body:fd});
    const json=await res.json();if(!json.ok)return;
    const data={roomId:window.ROOM_ID,nombre:window.USER_NAME,tipo:json.isImage?'image':'file',
      url:json.url,fileName:json.name,fileSize:formatSize(json.size),texto:''};
    socket.emit('share-file',data);renderMensaje({...data,propio:true});
  }catch(err){console.error(err);}
}

function bumpUnread(){
  if(activeTab!=='chat'||!panelOpen){
    unreadChat++;
    const b=document.getElementById('badge-chat');
    b.textContent=unreadChat>9?'9+':unreadChat;b.style.display='flex';
  }
}

function renderMensaje(data){
  const c=document.getElementById('chat-msgs'),propio=data.propio===true;
  const now=new Date();
  const hora=now.getHours().toString().padStart(2,'0')+':'+now.getMinutes().toString().padStart(2,'0');
  const fecha=now.toLocaleDateString('es-PY',{day:'numeric',month:'long',year:'numeric'});
  if(fecha!==lastDateShown){
    lastDateShown=fecha;
    const sep=document.createElement('div');sep.className='c-date-sep';sep.textContent=fecha;c.appendChild(sep);
  }
  const wrap=document.createElement('div');wrap.className='c-msg '+(propio?'own':'other');
  let content='';const tipo=data.tipo||'text';
  if(tipo==='image'){
    const su=escAttr(data.url||''),sn=escAttr(data.fileName||'imagen');
    content=`<div class="c-img-wrap" onclick="openLightbox('${su}','${sn}')">
      <img src="${su}" alt="${sn}" loading="lazy">
      <div class="c-img-overlay"><span class="material-icons-round" style="font-size:36px;opacity:.9">zoom_in</span></div>
      <a class="c-img-dl" href="${su}" download="${sn}" onclick="event.stopPropagation()">
        <span class="material-icons-round">download</span></a></div>`;
  }else if(tipo==='file'){
    const su=escAttr(data.url||''),sn=escAttr(data.fileName||'archivo');
    content=`<a class="c-file" href="${su}" download="${sn}" target="_blank">
      <span class="material-icons-round c-file-icon">${fileIcon(data.fileName||'')}</span>
      <div class="c-file-info">
        <span class="c-file-name">${escHtml(data.fileName||'Archivo')}</span>
        <span class="c-file-size">${escHtml(data.fileSize||'')}</span>
      </div>
      <span class="c-file-dl"><span class="material-icons-round">download</span></span></a>`;
  }else{
    content=`<div class="c-bubble">${escHtml(data.texto)}</div>`;
  }
  wrap.innerHTML=`${!propio?`<div class="c-name">${escHtml(data.nombre)}</div>`:''}${content}<div class="c-time">${hora}</div>`;
  c.appendChild(wrap);c.scrollTop=c.scrollHeight;
}

function addSysMsg(txt){
  const c=document.getElementById('chat-msgs');
  const d=document.createElement('div');d.className='c-sys';d.textContent=txt;
  c.appendChild(d);c.scrollTop=c.scrollHeight;
}

// ════════════════════════════════════════════════════════
//  OTRAS FUNCIONES
// ════════════════════════════════════════════════════════
function sendQuickReaction() {
  const emojis=['👍','❤️','😂','👏','🔥','🎉','😮'];
  const e=emojis[Math.floor(Math.random()*emojis.length)];
  const el=document.createElement('div');
  el.textContent=e;
  el.style.cssText='position:fixed;bottom:90px;left:'+(20+Math.random()*60)+'%;font-size:32px;z-index:999;pointer-events:none;transition:all 2s ease';
  document.body.appendChild(el);
  setTimeout(()=>{el.style.transform='translateY(-120px)';el.style.opacity='0';},50);
  setTimeout(()=>el.remove(),2100);
}

function leaveMeeting() {
  if (isRecording) detenerGrabacion();
  if (!confirm('¿Salir de la reunión?')) return;
  Object.values(peers).forEach(c=>c.close());
  miStream?.getTracks().forEach(t=>t.stop());
  screenStream?.getTracks().forEach(t=>t.stop());
  socket.disconnect(); location.href='/';
}

function openLightbox(url,name){
  document.getElementById('lightbox-img').src=url;
  const dl=document.getElementById('lightbox-dl');dl.href=url;dl.download=name;
  document.getElementById('lightbox').style.display='flex';document.body.style.overflow='hidden';
}
function closeLightbox(){document.getElementById('lightbox').style.display='none';document.body.style.overflow='';}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeLightbox();});

function copyLink(){
  navigator.clipboard.writeText((window.APP_URL||location.origin)+'/sala/'+window.ROOM_ID)
    .then(()=>showToast('✅ Enlace copiado','#1e8e3e'));
}

function iniciarReloj(){
  const u=()=>{const n=new Date();document.getElementById('room-time').textContent=n.toLocaleTimeString('es-PY',{hour:'2-digit',minute:'2-digit'});};
  u();setInterval(u,30000);
}

// ════════════════════════════════════════════════════════
//  TOAST
// ════════════════════════════════════════════════════════
let toastTimeout;
function showToast(msg, color='#323232', duration=4000) {
  const t = document.getElementById('global-toast');
  t.textContent = msg;
  t.style.background = color;
  t.style.color = 'white';
  t.classList.add('show');
  clearTimeout(toastTimeout);
  if (duration > 0) toastTimeout = setTimeout(()=>t.classList.remove('show'), duration);
}

// ════════════════════════════════════════════════════════
//  HELPERS
// ════════════════════════════════════════════════════════
function escHtml(t){if(!t)return'';return t.replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));}
function escAttr(t){return(t||'').replace(/"/g,'&quot;').replace(/'/g,'&#039;');}
function formatSize(b){if(!b)return'';if(b<1024)return b+' B';if(b<1048576)return(b/1024).toFixed(1)+' KB';return(b/1048576).toFixed(1)+' MB';}
function fileIcon(name){
  const ext=(name||'').split('.').pop().toLowerCase();
  const m={pdf:'picture_as_pdf',doc:'description',docx:'description',xls:'table_chart',xlsx:'table_chart',ppt:'slideshow',pptx:'slideshow',txt:'text_snippet',zip:'folder_zip',rar:'folder_zip',mp4:'videocam',mp3:'audio_file',jpg:'image',jpeg:'image',png:'image',gif:'image',webp:'image'};
  return m[ext]||'insert_drive_file';
}
