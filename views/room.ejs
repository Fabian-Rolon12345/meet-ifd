  const item = document.createElement('div');
  item.className = 'req-item';
  item.id = 'req-' + socketId;
  item.innerHTML = `
    <div class="req-ava">
      ${foto ? `<img src="${foto}" onerror="this.parentNode.textContent='${ini}'" />` : ini}
    </div>
    <div class="req-info">
      <div class="req-name">${escHtml(nombre || 'Invitado')}</div>
      <div class="req-email">${escHtml(email || 'Invitado')}</div>
    </div>
    <div class="req-actions">
      <button class="req-admit" onclick="admitirUsuario('${socketId}')">✓ Admitir</button>
