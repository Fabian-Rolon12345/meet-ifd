<script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
// ═══════════════════════════════════════════
//  VARIABLES DEL SERVIDOR
// ═══════════════════════════════════════════
const ROOM_ID    = "<%- roomId %>";
const APP_URL_JS = "<%= typeof APP_URL !== 'undefined' ? APP_URL : '' %>";
const SRV_USER   = <%- JSON.stringify(typeof user !== 'undefined' && user ? user : null) %>;
const IFD_OK     = <%= typeof ifdVerified !== 'undefined' ? ifdVerified : false %>;
const IS_CREATOR = <%= typeof isCreator !== 'undefined' ? isCreator : false %>; // creó la sala con /nueva
const USER_ROLE  = '<%- typeof userRole !== "undefined" && userRole ? userRole : "invitado" %>';

let myName  = SRV_USER ? SRV_USER.name  : 'Invitado';
let myEmail = SRV_USER ? SRV_USER.email : '';
let myPhoto = SRV_USER ? (SRV_USER.photo || '') : '';
let amIHost = false; // el SERVIDOR confirma esto

// ═══════════════════════════════════════════
//  SOCKET — se crea una sola vez al cargar
// ═══════════════════════════════════════════
const socket = io();

// ═══════════════════════════════════════════
//  MODAL IFD PASSWORD
// ═══════════════════════════════════════════
let ifdVerified = IFD_OK;

window.addEventListener('DOMContentLoaded', async () => {
  document.getElementById('lobby-link').value = (APP_URL_JS || location.origin) + '/sala/' + ROOM_ID;

  if (!ifdVerified) {
    try {
      const r = await fetch('/api/ifd-status');
      const d = await r.json();
      if (d.ifdVerified) {
        ifdVerified = true;
        if (d.user) {
          myName  = d.user.name  || myName;
          myEmail = d.user.email || myEmail;
          myPhoto = d.user.photo || myPhoto;
        }
      }
    } catch(e) {}
  }

  // Solo mostrar modal IFD si tiene Google pero NO verificó (docente que no ingresó la clave)
  // Para invitados sin Google, el lobby ya tiene el campo de nombre - NO mostrar modal doble
  if (SRV_USER && !ifdVerified) {
    document.getElementById('ifd-modal').classList.add('show');
    setTimeout(() => document.getElementById('ifd-pw')?.focus(), 200);
  }
});

function ifdEye() {
  const i = document.getElementById('ifd-pw');
  const b = document.querySelector('.ifd-eye');
  i.type = i.type === 'password' ? 'text' : 'password';
  b.textContent = i.type === 'password' ? '👁️' : '🙈';
}

async function ifdCheck() {
  const pw  = document.getElementById('ifd-pw').value.trim();
  const btn = document.getElementById('ifd-check-btn');
  const err = document.getElementById('ifd-err');
  const etx = document.getElementById('ifd-err-txt');
  if (!pw) return;
  btn.disabled = true;
  btn.innerHTML = '<span class="ifd-spin"></span>Verificando...';
  err.classList.remove('show');
  try {
    const res  = await fetch('/api/verificar-password', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ password: pw }) });
    const data = await res.json();
    if (data.ok) {
      ifdVerified = true;
      if (SRV_USER) {
        document.getElementById('ifd-modal').classList.remove('show');
      } else {
        document.getElementById('step1').style.display = 'none';
        document.getElementById('step2').style.display = 'block';
        document.getElementById('d1').classList.remove('on');
        document.getElementById('d2').classList.add('on');
        setTimeout(() => document.getElementById('ifd-name')?.focus(), 100);
      }
    } else {
      etx.textContent = data.error || 'Contraseña incorrecta. Intentá de nuevo.';
      err.classList.add('show');
      document.getElementById('ifd-pw').value = '';
      document.getElementById('ifd-pw').focus();
    }
  } catch(e) {
    etx.textContent = 'Error de conexión. Intentá de nuevo.';
    err.classList.add('show');
  } finally {
    btn.disabled = false;
    btn.textContent = 'Verificar contraseña';
  }
}

