});

socket.on('rejected', (msg) => {
  document.getElementById('waiting-modal').classList.remove('show');
  toast('❌ ' + (msg||'No fuiste admitido.'), '#ea4335');
  setTimeout(() => location.href = '/', 3000);
});

socket.on('kicked', (msg) => {
  toast('⛔ ' + (msg||'Fuiste expulsado.'), '#ea4335');
  setTimeout(() => location.href = '/', 3000);
});

socket.on('force-muted', () => {
  if (myStream) myStream.getAudioTracks().forEach(t => t.enabled = false);
  st.mic = false;
  document.getElementById('btn-mic').classList.add('muted');
  document.getElementById('ic-mic').textContent = 'mic_off';
  toast('🔇 El anfitrión te silenció', '#ea4335');
});

socket.on('host-left', () => toast('ℹ️ El anfitrión abandonó la reunión', '#f9ab00'));

// ✅ HOST: solicitudes de ingreso
socket.on('user-waiting', ({ socketId, userName, userEmail, userPhoto }) => {
  if (!IS_HOST) return;
  addRequest(socketId, userName, userEmail, userPhoto);
  toast('🙋 ' + userName + ' quiere entrar', '#f9ab00');
});

// ✅ HOST: lista completa de espera (al reconectar)
socket.on('waiting-list', (list) => {
  if (!IS_HOST) return;
  document.getElementById('req-list').innerHTML = '';
  list.forEach(u => addRequest(u.socketId, u.userName, u.userEmail, u.userPhoto));
  updReqCount();
});

// Grabación
socket.on('user-recording-started', ({ userName }) => toast('🎥 ' + userName + ' está grabando', '#f9ab00'));
socket.on('user-recording-stopped', ({ userName }) => toast('⏹️ ' + userName + ' detuvo la grabación', '#9aa0a6'));

// Chat
socket.on('receive-message', d => { if (d.nombre !== myName) { renderMsg({...d, own:false}); bumpUnread(); } });
socket.on('receive-file',    d => { if (d.nombre !== myName) { renderMsg({...d, own:false}); bumpUnread(); } });

