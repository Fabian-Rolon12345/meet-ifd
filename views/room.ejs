function toggleMic() {
  if (!myStream) return;
  st.mic = !st.mic;
  myStream.getAudioTracks().forEach(t => t.enabled = st.mic);
  document.getElementById('btn-mic').classList.toggle('muted', !st.mic);
  document.getElementById('ic-mic').textContent = st.mic ? 'mic' : 'mic_off';
}
function toggleCam() {
  if (!myStream) return;
  st.cam = !st.cam;
  myStream.getVideoTracks().forEach(t => t.enabled = st.cam);
  document.getElementById('btn-cam').classList.toggle('muted', !st.cam);
  document.getElementById('ic-cam').textContent = st.cam ? 'videocam' : 'videocam_off';
  const p = document.getElementById('ph-yo'); if (p) p.style.display = st.cam ? 'none' : 'flex';
}
async function toggleScreen() {
  if (st.screen) {
    screenStream?.getTracks().forEach(t => t.stop()); screenStream = null; st.screen = false;
    document.getElementById('btn-screen').classList.remove('screen-on');
    if (myStream) { const t=document.getElementById('tile-yo'); if(t) t.querySelector('video').srcObject=myStream; }
    return;
  }
  try {
    screenStream = await navigator.mediaDevices.getDisplayMedia({ video:true });
    st.screen = true; document.getElementById('btn-screen').classList.add('screen-on');
    const track = screenStream.getVideoTracks()[0];
    Object.values(peers).forEach(call => {
      const s = call.peerConnection.getSenders().find(s => s.track?.kind==='video');
      if (s) s.replaceTrack(track);
    });
    const mv = document.querySelector('#tile-yo video'); if (mv) mv.srcObject = screenStream;
    track.onended = toggleScreen;
  } catch(e) {}
}

