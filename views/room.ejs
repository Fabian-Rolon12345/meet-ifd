<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>IFD Meet - Reunión</title>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons+Round">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:       #202124;
      --surface:  #2d2e31;
      --elevated: #3c4043;
      --maroon:   #6d1a2e;
      --maroon-d: #4a1220;
      --red:      #ea4335;
      --green:    #1e8e3e;
      --t1:       #e8eaed;
      --t2:       #9aa0a6;
      --brd:      rgba(255,255,255,0.1);
    }

    html, body {
      height: 100%;
      overflow: hidden;
      font-family: 'Roboto', sans-serif;
      background: var(--bg);
      color: var(--t1);
    }

    #app {
      display: flex;
      flex-direction: column;
      height: 100vh;
    }

    /* HEADER */
    #header {
      height: 64px;
      min-height: 64px;
      background: var(--surface);
      border-bottom: 1px solid var(--brd);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      z-index: 100;
      flex-shrink: 0;
    }

    .h-brand { display: flex; align-items: center; gap: 10px; flex: 1; }
    .h-logo { width: 36px; height: 36px; border-radius: 8px; object-fit: cover; flex-shrink: 0; }
    .h-name { font-family: 'Google Sans', sans-serif; font-size: 18px; font-weight: 500; white-space: nowrap; }

    .h-center {
      display: flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,0.07);
      padding: 7px 14px; border-radius: 20px; flex-shrink: 0;
    }
    .h-time, .h-code { font-size: 14px; color: var(--t2); }
    .h-sep { color: var(--t2); font-size: 12px; }

    .h-actions { display: flex; align-items: center; gap: 4px; flex: 1; justify-content: flex-end; }
    .icon-btn {
      width: 40px; height: 40px; border-radius: 50%;
      background: transparent; border: none; color: var(--t2);
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: .15s; position: relative;
    }
    .icon-btn:hover { background: rgba(255,255,255,0.1); color: var(--t1); }
    .icon-btn .material-icons-round { font-size: 22px; }
    .badge {
      position: absolute; top: 4px; right: 4px;
      min-width: 16px; height: 16px;
      background: var(--maroon); color: white;
      border-radius: 8px; font-size: 10px; font-weight: 700;
      display: flex; align-items: center; justify-content: center; padding: 0 3px;
    }

    /* ÁREA CENTRAL */
    #main { flex: 1; display: flex; overflow: hidden; position: relative; }

    /* VIDEO GRID */
    #video-area {
      flex: 1; display: flex; align-items: center; justify-content: center;
      padding: 16px; overflow: hidden; background: var(--bg);
    }
    #videos-grid {
      width: 100%; height: 100%; display: grid; gap: 12px;
      align-content: center; justify-content: center; align-items: center;
    }
    #videos-grid.n1 { grid-template-columns: 1fr; }
    #videos-grid.n2 { grid-template-columns: repeat(2, 1fr); }
    #videos-grid.n3, #videos-grid.n4 { grid-template-columns: repeat(2, 1fr); }
    #videos-grid.n5, #videos-grid.n6 { grid-template-columns: repeat(3, 1fr); }

    .video-tile {
      position: relative; background: var(--surface);
      border-radius: 12px; overflow: hidden;
      aspect-ratio: 16/9; min-height: 0;
      border: 2px solid transparent; transition: border-color .2s;
    }
    .video-tile.speaking { border-color: var(--green); box-shadow: 0 0 0 2px rgba(30,142,62,.3); }
    .video-tile video { width: 100%; height: 100%; object-fit: cover; display: block; }
    .video-tile.self video { transform: scaleX(-1); }

    .tile-placeholder {
      position: absolute; inset: 0;
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
      background: linear-gradient(135deg, var(--maroon), var(--maroon-d));
    }
    .tile-avatar {
      width: 72px; height: 72px; border-radius: 50%;
      background: rgba(255,255,255,0.15);
      border: 3px solid rgba(255,255,255,0.25);
      display: flex; align-items: center; justify-content: center;
      font-size: 28px; font-weight: 700; color: white;
    }
    .tile-label {
      position: absolute; bottom: 10px; left: 10px;
      background: rgba(0,0,0,0.6); backdrop-filter: blur(6px);
      padding: 5px 10px; border-radius: 8px;
      font-size: 13px; font-weight: 500; color: white;
      display: flex; align-items: center; gap: 6px;
    }
    .tile-label .material-icons-round { font-size: 14px; }
    .tile-label .m { color: var(--red); }

    /* PANEL LATERAL */
    #side-panel {
      width: 360px; background: var(--surface);
      border-left: 1px solid var(--brd);
      display: none; flex-direction: column; flex-shrink: 0; z-index: 50;
    }
    #side-panel.open { display: flex; }

    .panel-tabs { display: flex; border-bottom: 1px solid var(--brd); flex-shrink: 0; }
    .p-tab {
      flex: 1; padding: 14px 8px; text-align: center;
      font-size: 13px; font-weight: 500; color: var(--t2);
      cursor: pointer; border: none; background: none;
      border-bottom: 2px solid transparent; transition: .15s;
      display: flex; align-items: center; justify-content: center; gap: 6px;
    }
    .p-tab.on { color: var(--t1); border-bottom-color: var(--maroon); }
    .p-tab:hover:not(.on) { color: var(--t1); }
    .p-tab .material-icons-round { font-size: 16px; }

    .panel-pane { display: none; flex: 1; flex-direction: column; overflow: hidden; }
    .panel-pane.on { display: flex; }

    /* PERSONAS */
    .p-list { flex: 1; overflow-y: auto; padding: 8px; }
    .p-item {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 12px; border-radius: 10px; transition: .15s;
    }
    .p-item:hover { background: rgba(255,255,255,0.05); }
    .p-ava {
      width: 38px; height: 38px; border-radius: 50%;
      background: var(--maroon);
      display: flex; align-items: center; justify-content: center;
      font-size: 15px; font-weight: 600; color: white; flex-shrink: 0;
    }
    .p-name { flex: 1; font-size: 14px; font-weight: 500; }
    .p-role { font-size: 11px; color: #f9ab00; }
    .p-icons { display: flex; gap: 4px; color: var(--t2); }
    .p-icons .material-icons-round { font-size: 16px; }
    .p-icons .m { color: var(--red); }

    /* ══════════════════════════════════
       CHAT ESTILO WHATSAPP
    ══════════════════════════════════ */
    #pane-chat {
      display: none; flex-direction: column; flex: 1;
      overflow: hidden; background: #1a1a1d;
    }
    #pane-chat.on { display: flex; }

    .chat-msgs {
      flex: 1; overflow-y: auto;
      padding: 12px 10px;
      display: flex; flex-direction: column; gap: 4px;
      scroll-behavior: smooth;
    }
    .chat-msgs::-webkit-scrollbar { width: 4px; }
    .chat-msgs::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 2px; }

    /* Burbujas */
    .c-msg {
      display: flex; flex-direction: column;
      max-width: 82%;
      animation: msgIn .18s ease;
    }
    @keyframes msgIn {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .c-msg.own   { align-self: flex-end; align-items: flex-end; }
    .c-msg.other { align-self: flex-start; }

    .c-name { font-size: 11px; font-weight: 600; color: #9aa0a6; margin-bottom: 3px; padding-left: 2px; }
    .c-bubble {
      background: #2d2e31; color: #e8eaed;
      padding: 9px 13px;
      border-radius: 18px 18px 18px 4px;
      font-size: 14px; line-height: 1.5;
      word-break: break-word; white-space: pre-wrap;
    }
    .c-msg.own .c-bubble {
      background: #6d1a2e;
      border-radius: 18px 18px 4px 18px;
    }
    .c-time { font-size: 10px; color: #5f6368; margin-top: 3px; padding: 0 2px; }

    .c-sys { text-align: center; font-size: 11px; color: #5f6368; padding: 6px 0; font-style: italic; }

    .c-date-sep {
      text-align: center; font-size: 11px; color: #5f6368;
      padding: 8px 0;
      display: flex; align-items: center; gap: 8px;
    }
    .c-date-sep::before, .c-date-sep::after {
      content: ''; flex: 1; height: 1px; background: rgba(255,255,255,0.07);
    }

    /* Imagen inline */
    .c-img-wrap {
      position: relative; max-width: 240px;
      border-radius: 14px; overflow: hidden;
      cursor: zoom-in; background: #2d2e31;
    }
    .c-img-wrap img {
      width: 100%; display: block; border-radius: 14px;
      transition: filter .15s;
    }
    .c-img-wrap:hover img { filter: brightness(.82); }
    .c-img-overlay {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity .15s; color: white;
    }
    .c-img-wrap:hover .c-img-overlay { opacity: 1; }
    .c-img-dl {
      position: absolute; bottom: 8px; right: 8px;
      background: rgba(0,0,0,.65); border: none; color: white;
      border-radius: 50%; width: 32px; height: 32px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; opacity: 0; transition: opacity .15s;
      text-decoration: none;
    }
    .c-img-wrap:hover .c-img-dl { opacity: 1; }
    .c-img-dl .material-icons-round { font-size: 16px; }

    /* Archivo */
    .c-file {
      display: flex; align-items: center; gap: 10px;
      background: rgba(255,255,255,0.07);
      padding: 10px 14px; border-radius: 12px;
      max-width: 260px; text-decoration: none; color: #e8eaed;
      transition: background .15s;
    }
    .c-file:hover { background: rgba(255,255,255,0.13); }
    .c-file-icon { font-size: 26px; flex-shrink: 0; }
    .c-file-info { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
    .c-file-name { font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .c-file-size { font-size: 11px; color: #9aa0a6; }
    .c-file-dl { color: #9aa0a6; flex-shrink: 0; }
    .c-file-dl .material-icons-round { font-size: 20px; }

    /* Vista previa adjunto */
    #attach-preview {
      background: #252528;
      border-top: 1px solid rgba(255,255,255,0.08);
      padding: 10px 12px;
      display: flex; align-items: center; gap: 10px; flex-shrink: 0;
    }
    #attach-preview-inner {
      flex: 1; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    }
    .preview-thumb {
      position: relative; width: 64px; height: 64px;
      border-radius: 10px; overflow: hidden; background: #3c3c3c; flex-shrink: 0;
    }
    .preview-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .preview-file-info {
      display: flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,0.07);
      padding: 8px 12px; border-radius: 10px;
      font-size: 13px; color: #e8eaed; max-width: 200px;
    }
    .preview-file-info .material-icons-round { font-size: 22px; color: #9aa0a6; }
    .preview-filename { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .attach-cancel {
      background: rgba(255,255,255,0.1); border: none; color: #9aa0a6;
      border-radius: 50%; width: 32px; height: 32px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; flex-shrink: 0;
    }
    .attach-cancel:hover { background: rgba(255,255,255,0.18); color: white; }
    .attach-cancel .material-icons-round { font-size: 18px; }

    /* Input row */
    .chat-input-row {
      display: flex; align-items: flex-end; gap: 6px;
      padding: 10px; border-top: 1px solid rgba(255,255,255,0.08);
      background: #202124; flex-shrink: 0;
    }
    .chat-tool-btn {
      width: 36px; height: 36px; border-radius: 50%;
      background: transparent; border: none; color: #9aa0a6;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; transition: .15s;
    }
    .chat-tool-btn:hover { background: rgba(255,255,255,0.1); color: #e8eaed; }
    .chat-tool-btn .material-icons-round { font-size: 20px; }

    .chat-textarea {
      flex: 1; background: #2d2e31;
      border: 1px solid rgba(255,255,255,0.1); border-radius: 20px;
      color: #e8eaed; padding: 9px 15px;
      font-family: inherit; font-size: 14px;
      resize: none; outline: none;
      min-height: 38px; max-height: 130px;
      line-height: 1.45; transition: border-color .15s; overflow-y: auto;
    }
    .chat-textarea:focus { border-color: #6d1a2e; }
    .chat-textarea::placeholder { color: #5f6368; }

    .chat-send {
      width: 38px; height: 38px; border-radius: 50%;
      background: #6d1a2e; border: none; color: white;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; transition: .15s;
    }
    .chat-send:hover { background: #4a1220; transform: scale(1.08); }
    .chat-send .material-icons-round { font-size: 20px; }

    /* Lightbox */
    #lightbox {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.92);
      z-index: 9999; display: flex; align-items: center; justify-content: center;
      backdrop-filter: blur(8px); cursor: zoom-out;
      animation: lbIn .2s ease;
    }
    @keyframes lbIn { from { opacity: 0; } to { opacity: 1; } }
    #lightbox-inner { position: relative; max-width: 90vw; max-height: 90vh; cursor: default; }
    #lightbox-img {
      max-width: 90vw; max-height: 82vh;
      border-radius: 12px; display: block;
      box-shadow: 0 20px 60px rgba(0,0,0,.6);
    }
    .lightbox-close {
      position: absolute; top: -16px; right: -16px;
      background: rgba(0,0,0,.7); border: none; color: white;
      border-radius: 50%; width: 36px; height: 36px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: background .15s;
    }
    .lightbox-close:hover { background: rgba(255,255,255,0.2); }
    .lightbox-dl-btn {
      position: absolute; bottom: -52px; left: 50%; transform: translateX(-50%);
      background: #6d1a2e; color: white; border-radius: 20px;
      padding: 9px 24px; font-size: 14px; font-weight: 500;
      text-decoration: none; display: flex; align-items: center; gap: 6px;
      transition: background .15s; white-space: nowrap;
    }
    .lightbox-dl-btn:hover { background: #4a1220; }

    /* CONTROLES */
    #controls {
      height: 76px; min-height: 76px;
      background: var(--surface); border-top: 1px solid var(--brd);
      display: flex; align-items: center; justify-content: center;
      padding: 0 20px; flex-shrink: 0; z-index: 100; gap: 8px;
    }
    .ctrl-btn {
      width: 48px; height: 48px; border-radius: 50%; border: none;
      background: var(--elevated); color: var(--t1); cursor: pointer;
      display: flex; align-items: center; justify-content: center; transition: .15s;
    }
    .ctrl-btn:hover { background: rgba(255,255,255,0.15); transform: translateY(-1px); }
    .ctrl-btn .material-icons-round { font-size: 22px; }
    .ctrl-btn.muted { background: var(--red); }
    .ctrl-btn.screen-on { background: rgba(0,121,107,0.9); }
    .ctrl-divider { width: 1px; height: 30px; background: var(--brd); margin: 0 4px; }
    .ctrl-leave { background: var(--red); width: 56px; height: 48px; border-radius: 28px; }
    .ctrl-leave:hover { background: #c5291e; }

    ::-webkit-scrollbar { width: 5px; }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 3px; }

    @media (max-width: 768px) {
      #header { padding: 0 10px; }
      .h-name { display: none; }
      #side-panel { position: absolute; right: 0; top: 64px; bottom: 76px; width: 100%; max-width: 340px; }
      #controls { gap: 4px; }
      .ctrl-btn { width: 44px; height: 44px; }
    }
  </style>
</head>
<body>

<div id="app">

  <!-- HEADER -->
  <header id="header">
    <div class="h-brand">
      <img src="/img/logo-ifd.png" alt="IFD" class="h-logo"
        onerror="this.style.display='none';document.getElementById('logo-fb').style.display='flex'">
      <div id="logo-fb" style="display:none;width:36px;height:36px;border-radius:8px;background:var(--maroon);align-items:center;justify-content:center;font-size:13px;font-weight:700;color:white;flex-shrink:0;">IFD</div>
      <span class="h-name">IFD Meet</span>
    </div>

    <div class="h-center">
      <span class="h-time" id="room-time">--:--</span>
      <span class="h-sep">•</span>
      <span class="h-code" id="room-code"></span>
      <button class="icon-btn" onclick="copyLink()" title="Copiar enlace" style="width:28px;height:28px">
        <span class="material-icons-round" style="font-size:16px">content_copy</span>
      </button>
    </div>

    <div class="h-actions">
      <button class="icon-btn" onclick="openPanel('people')" title="Participantes">
        <span class="material-icons-round">people</span>
        <span class="badge" id="badge-people">1</span>
      </button>
      <button class="icon-btn" onclick="openPanel('chat')" title="Chat">
        <span class="material-icons-round">chat</span>
        <span class="badge" id="badge-chat" style="display:none"></span>
      </button>
      <button class="icon-btn" title="Más">
        <span class="material-icons-round">more_vert</span>
      </button>
    </div>
  </header>

  <!-- ÁREA CENTRAL -->
  <div id="main">

    <div id="video-area">
      <div id="videos-grid" class="n1"></div>
    </div>

    <!-- PANEL LATERAL -->
    <aside id="side-panel">
      <div class="panel-tabs">
        <button class="p-tab on" id="tab-people" onclick="switchTab('people')">
          <span class="material-icons-round">people</span> Personas
        </button>
        <button class="p-tab" id="tab-chat" onclick="switchTab('chat')">
          <span class="material-icons-round">chat</span> Chat
        </button>
      </div>

      <!-- PESTAÑA PERSONAS -->
      <div class="panel-pane on" id="pane-people">
        <div class="p-list" id="p-list"></div>
      </div>

      <!-- PESTAÑA CHAT -->
      <div class="panel-pane" id="pane-chat">

        <!-- mensajes -->
        <div class="chat-msgs" id="chat-msgs"></div>

        <!-- preview de adjunto -->
        <div id="attach-preview" style="display:none">
          <div id="attach-preview-inner"></div>
          <button class="attach-cancel" onclick="cancelAttach()" title="Cancelar">
            <span class="material-icons-round">close</span>
          </button>
        </div>

        <!-- input -->
        <div class="chat-input-row">
          <!-- adjuntar archivo -->
          <label class="chat-tool-btn" title="Adjuntar archivo">
            <span class="material-icons-round">attach_file</span>
            <input type="file" id="file-input" multiple
              accept="image/*,video/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.zip,.rar,.mp3,.mp4"
              onchange="handleFileSelect(this.files)" style="display:none">
          </label>

          <!-- adjuntar imagen -->
          <button class="chat-tool-btn" title="Agregar imagen" onclick="triggerImagePick()">
            <span class="material-icons-round">image</span>
          </button>

          <!-- textarea -->
          <textarea
            id="chat-input"
            class="chat-textarea"
            placeholder="Mensaje…"
            rows="1"
            onkeydown="chatKeyDown(event)"
            oninput="autoResize(this)"
            onpaste="handlePaste(event)"
          ></textarea>

          <!-- enviar -->
          <button class="chat-send" onclick="sendMessage()" title="Enviar">
            <span class="material-icons-round">send</span>
          </button>
        </div>
      </div>
    </aside>

  </div>

  <!-- CONTROLES -->
  <footer id="controls">
    <button class="ctrl-btn" id="btn-mic" onclick="toggleMic()" title="Micrófono">
      <span class="material-icons-round" id="icon-mic">mic</span>
    </button>
    <button class="ctrl-btn" id="btn-cam" onclick="toggleCam()" title="Cámara">
      <span class="material-icons-round" id="icon-cam">videocam</span>
    </button>
    <button class="ctrl-btn" id="btn-screen" onclick="toggleScreen()" title="Compartir pantalla">
      <span class="material-icons-round">present_to_all</span>
    </button>
    <div class="ctrl-divider"></div>
    <button class="ctrl-btn" title="Reacción" onclick="sendQuickReaction()">
      <span class="material-icons-round">emoji_emotions</span>
    </button>
    <button class="ctrl-btn" onclick="openPanel('people')" title="Participantes">
      <span class="material-icons-round">people</span>
    </button>
    <div class="ctrl-divider"></div>
    <button class="ctrl-btn ctrl-leave" onclick="leaveMeeting()" title="Salir">
      <span class="material-icons-round">call_end</span>
    </button>
  </footer>

</div>

<!-- LIGHTBOX -->
<div id="lightbox" onclick="closeLightbox()" style="display:none">
  <div id="lightbox-inner" onclick="event.stopPropagation()">
    <img id="lightbox-img" src="" alt="">
    <a id="lightbox-dl" download href="" class="lightbox-dl-btn">
      <span class="material-icons-round">download</span> Descargar
    </a>
    <button class="lightbox-close" onclick="closeLightbox()">
      <span class="material-icons-round">close</span>
    </button>
  </div>
</div>

<!-- SCRIPTS -->
<script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
  window.ROOM_ID    = "<%= roomId %>";
  window.IS_HOST    = "<%= typeof user !== 'undefined' && user ? 'true' : 'false' %>" === "true";
  window.USER_NAME  = "<%= typeof user !== 'undefined' && user ? user.name.replace(/'/g, "\\'") : 'Invitado' %>";
  window.USER_PHOTO = "<%= typeof user !== 'undefined' && user && user.photo ? user.photo : '' %>";
</script>
<script>
// ════════════════════════════════════
//  WEBRTC + SOCKET
// ════════════════════════════════════
const socket = io();
let miPeer = null, miStream = null, screenStream = null;
const peers = {}, participantes = {};
const state = { micOn: true, camOn: true, screenOn: false };

document.addEventListener('DOMContentLoaded', async () => {
  document.getElementById('room-code').textContent = window.ROOM_ID;
  iniciarReloj();
  await iniciarMedia();
  iniciarPeerJS();
  renderParticipantes();
});

async function iniciarMedia() {
  try {
    miStream = await navigator.mediaDevices.getUserMedia({
      video: { width: { ideal: 1280 }, height: { ideal: 720 } },
      audio: { echoCancellation: true, noiseSuppression: true }
    });
  } catch (err) { console.warn('Sin cámara/mic:', err); }
  if (miStream) agregarVideo(miStream, 'yo', `Tú (${window.USER_NAME})`, true);
}

function iniciarPeerJS() {
  miPeer = new Peer(undefined, {
    path: '/peerjs',
    host: location.hostname,
    port: location.port || (location.protocol === 'https:' ? 443 : 80)
  });
  miPeer.on('open', id => {
    socket.emit('join-room', window.ROOM_ID, id, window.USER_NAME, window.IS_HOST, '', window.USER_PHOTO);
  });
  miPeer.on('call', call => {
    if (miStream) call.answer(miStream);
    call.on('stream', s => {
      const p = participantes[call.peer];
      agregarVideo(s, call.peer, p?.nombre || 'Participante', false);
    });
    peers[call.peer] = call;
  });
}

socket.on('user-connected', (peerId, nombre) => {
  participantes[peerId] = { nombre, micOn: true, camOn: true };
  if (miStream) {
    setTimeout(() => {
      const call = miPeer.call(peerId, miStream);
      if (call) {
        call.on('stream', s => agregarVideo(s, peerId, nombre, false));
        peers[peerId] = call;
      }
    }, 600);
  }
  addSysMsg(`${escHtml(nombre)} se unió`);
  renderParticipantes();
  actualizarContador();
});

socket.on('user-disconnected', peerId => {
  if (peers[peerId]) { peers[peerId].close(); delete peers[peerId]; }
  document.getElementById('tile-' + peerId)?.remove();
  const nombre = participantes[peerId]?.nombre || 'Alguien';
  delete participantes[peerId];
  addSysMsg(`${escHtml(nombre)} salió`);
  renderParticipantes();
  actualizarContador();
  ajustarGrid();
});

// ════════════════════════════════════
//  VIDEO
// ════════════════════════════════════
function agregarVideo(stream, id, nombre, esSelf) {
  let tile = document.getElementById('tile-' + id);
  if (tile) { tile.querySelector('video').srcObject = stream; return; }

  tile = document.createElement('div');
  tile.className = 'video-tile' + (esSelf ? ' self' : '');
  tile.id = 'tile-' + id;

  const ini = nombre.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();
  tile.innerHTML = `
    <div class="tile-placeholder" id="ph-${id}">
      <div class="tile-avatar">${ini}</div>
    </div>
    <video autoplay playsinline ${esSelf ? 'muted' : ''}></video>
    <div class="tile-label">
      <span class="material-icons-round" id="mic-icon-${id}">mic</span>
      ${escHtml(nombre)}
    </div>
  `;
  const video = tile.querySelector('video');
  video.srcObject = stream;
  video.onloadedmetadata = () => {
    const ph = document.getElementById('ph-' + id);
    if (ph) ph.style.display = 'none';
  };
  document.getElementById('videos-grid').appendChild(tile);
  ajustarGrid();
}

function ajustarGrid() {
  const grid = document.getElementById('videos-grid');
  const n = grid.children.length;
  grid.className = 'n' + Math.min(n, 6);
}

function toggleMic() {
  if (!miStream) return;
  state.micOn = !state.micOn;
  miStream.getAudioTracks().forEach(t => t.enabled = state.micOn);
  document.getElementById('btn-mic').classList.toggle('muted', !state.micOn);
  document.getElementById('icon-mic').textContent = state.micOn ? 'mic' : 'mic_off';
}

function toggleCam() {
  if (!miStream) return;
  state.camOn = !state.camOn;
  miStream.getVideoTracks().forEach(t => t.enabled = state.camOn);
  document.getElementById('btn-cam').classList.toggle('muted', !state.camOn);
  document.getElementById('icon-cam').textContent = state.camOn ? 'videocam' : 'videocam_off';
  const ph = document.getElementById('ph-yo');
  if (ph) ph.style.display = state.camOn ? 'none' : 'flex';
}

async function toggleScreen() {
  if (state.screenOn) {
    screenStream?.getTracks().forEach(t => t.stop());
    screenStream = null; state.screenOn = false;
    document.getElementById('btn-screen').classList.remove('screen-on');
    if (miStream) {
      const tile = document.getElementById('tile-yo');
      if (tile) tile.querySelector('video').srcObject = miStream;
    }
    return;
  }
  try {
    screenStream = await navigator.mediaDevices.getDisplayMedia({ video: true });
    state.screenOn = true;
    document.getElementById('btn-screen').classList.add('screen-on');
    const track = screenStream.getVideoTracks()[0];
    Object.values(peers).forEach(call => {
      const sender = call.peerConnection.getSenders().find(s => s.track?.kind === 'video');
      if (sender) sender.replaceTrack(track);
    });
    const myVideo = document.querySelector('#tile-yo video');
    if (myVideo) myVideo.srcObject = screenStream;
    track.onended = toggleScreen;
  } catch(e) { console.log('Cancelado'); }
}

function sendQuickReaction() {
  const emojis = ['👍','❤️','😂','👏','🔥','🎉','😮'];
  const e = emojis[Math.floor(Math.random() * emojis.length)];
  const el = document.createElement('div');
  el.textContent = e;
  el.style.cssText = `position:fixed;bottom:90px;left:${20+Math.random()*60}%;font-size:32px;z-index:999;pointer-events:none;transition:all 2s ease`;
  document.body.appendChild(el);
  setTimeout(() => { el.style.transform = 'translateY(-120px)'; el.style.opacity = '0'; }, 50);
  setTimeout(() => el.remove(), 2100);
}

function leaveMeeting() {
  if (!confirm('¿Salir de la reunión?')) return;
  Object.values(peers).forEach(c => c.close());
  miStream?.getTracks().forEach(t => t.stop());
  screenStream?.getTracks().forEach(t => t.stop());
  socket.disconnect();
  location.href = '/';
}

// ════════════════════════════════════
//  PANEL / TABS
// ════════════════════════════════════
let panelOpen = false, activeTab = 'people';
let unreadChat = 0;

function openPanel(tab) {
  const panel = document.getElementById('side-panel');
  if (panelOpen && activeTab === tab) {
    panel.classList.remove('open');
    panelOpen = false;
  } else {
    panel.classList.add('open');
    panelOpen = true;
    switchTab(tab);
  }
}

function switchTab(tab) {
  activeTab = tab;
  ['people','chat'].forEach(t => {
    document.getElementById('tab-' + t).classList.toggle('on', t === tab);
    document.getElementById('pane-' + t).classList.toggle('on', t === tab);
  });
  if (tab === 'chat') {
    unreadChat = 0;
    const badge = document.getElementById('badge-chat');
    badge.style.display = 'none';
    // scroll al final
    const msgs = document.getElementById('chat-msgs');
    msgs.scrollTop = msgs.scrollHeight;
  }
}

function renderParticipantes() {
  const list = document.getElementById('p-list');
  const todos = [
    { nombre: window.USER_NAME, role: 'Tú', micOn: state.micOn, camOn: state.camOn }
  ].concat(Object.values(participantes).map(p => ({ nombre: p.nombre, micOn: p.micOn ?? true, camOn: p.camOn ?? true })));

  list.innerHTML = todos.map(p => {
    const ini = p.nombre.split(' ').map(n => n[0]).join('').slice(0,2).toUpperCase();
    return `
      <div class="p-item">
        <div class="p-ava">${ini}</div>
        <div style="flex:1">
          <div class="p-name">${escHtml(p.nombre)}</div>
          ${p.role ? `<div class="p-role">${p.role}</div>` : ''}
        </div>
        <div class="p-icons">
          <span class="material-icons-round ${p.micOn ? '' : 'm'}">${p.micOn ? 'mic' : 'mic_off'}</span>
          <span class="material-icons-round">${p.camOn ? 'videocam' : 'videocam_off'}</span>
        </div>
      </div>
    `;
  }).join('');
}

function actualizarContador() {
  document.getElementById('badge-people').textContent = Object.keys(participantes).length + 1;
}

// ════════════════════════════════════
//  CHAT — WHATSAPP STYLE
// ════════════════════════════════════
let pendingFiles = [];
let lastDateShown = '';

// Enter = enviar / Shift+Enter = nueva línea
function chatKeyDown(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendMessage();
  }
}

// Auto-resize textarea
function autoResize(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 130) + 'px';
}

// Pegar imagen con Ctrl+V
function handlePaste(e) {
  const items = e.clipboardData?.items;
  if (!items) return;
  for (const item of items) {
    if (item.type.startsWith('image/')) {
      e.preventDefault();
      const file = item.getAsFile();
      if (file) addPendingFile(file);
      return;
    }
  }
}

// Botón imagen manual
function triggerImagePick() {
  const inp = document.createElement('input');
  inp.type = 'file';
  inp.accept = 'image/*';
  inp.multiple = true;
  inp.onchange = () => handleFileSelect(inp.files);
  inp.click();
}

// Selección de archivos
function handleFileSelect(files) {
  for (const f of files) addPendingFile(f);
  document.getElementById('file-input').value = '';
}

function addPendingFile(file) {
  pendingFiles.push(file);
  renderAttachPreview();
}

function cancelAttach() {
  pendingFiles = [];
  renderAttachPreview();
}

function renderAttachPreview() {
  const box   = document.getElementById('attach-preview');
  const inner = document.getElementById('attach-preview-inner');
  if (!pendingFiles.length) { box.style.display = 'none'; inner.innerHTML = ''; return; }

  box.style.display = 'flex';
  inner.innerHTML = '';
  pendingFiles.forEach(f => {
    const wrap = document.createElement('div');
    if (f.type.startsWith('image/')) {
      wrap.className = 'preview-thumb';
      const img = document.createElement('img');
      img.src = URL.createObjectURL(f);
      wrap.appendChild(img);
    } else {
      wrap.className = 'preview-file-info';
      wrap.innerHTML = `
        <span class="material-icons-round">${fileIcon(f.name)}</span>
        <span class="preview-filename">${escHtml(f.name)}</span>
      `;
    }
    inner.appendChild(wrap);
  });
}

// ENVIAR
async function sendMessage() {
  const input = document.getElementById('chat-input');
  const texto = input.value.trim();

  if (pendingFiles.length > 0) {
    for (const file of pendingFiles) await uploadAndSend(file);
    pendingFiles = [];
    renderAttachPreview();
  }

  if (texto) {
    const data = { roomId: window.ROOM_ID, nombre: window.USER_NAME, texto, tipo: 'text' };
    socket.emit('send-message', data);
    renderMensaje({ ...data, propio: true });
    input.value = '';
    input.style.height = 'auto';
  }
}

// SUBIR ARCHIVO
async function uploadAndSend(file) {
  const fd = new FormData();
  fd.append('file', file);
  try {
    const res  = await fetch('/upload', { method: 'POST', body: fd });
    const json = await res.json();
    if (!json.ok) return;
    const data = {
      roomId: window.ROOM_ID,
      nombre: window.USER_NAME,
      tipo: json.isImage ? 'image' : 'file',
      url: json.url,
      fileName: json.name,
      fileSize: formatSize(json.size),
      texto: ''
    };
    socket.emit('share-file', data);
    renderMensaje({ ...data, propio: true });
  } catch(err) { console.error('Upload error:', err); }
}

// SOCKETS ENTRANTES
socket.on('receive-message', data => {
  if (data.nombre !== window.USER_NAME) {
    renderMensaje({ ...data, propio: false });
    bumpUnread();
  }
});
socket.on('receive-file', data => {
  if (data.nombre !== window.USER_NAME) {
    renderMensaje({ ...data, propio: false });
    bumpUnread();
  }
});

function bumpUnread() {
  if (activeTab !== 'chat' || !panelOpen) {
    unreadChat++;
    const badge = document.getElementById('badge-chat');
    badge.textContent = unreadChat > 9 ? '9+' : unreadChat;
    badge.style.display = 'flex';
  }
}

// RENDER MENSAJE
function renderMensaje(data) {
  const c = document.getElementById('chat-msgs');
  const propio = data.propio === true;
  const now  = new Date();
  const hora = now.getHours().toString().padStart(2,'0') + ':' + now.getMinutes().toString().padStart(2,'0');
  const fechaStr = now.toLocaleDateString('es-PY', { day: 'numeric', month: 'long', year: 'numeric' });

  // Separador de fecha
  if (fechaStr !== lastDateShown) {
    lastDateShown = fechaStr;
    const sep = document.createElement('div');
    sep.className = 'c-date-sep';
    sep.textContent = fechaStr;
    c.appendChild(sep);
  }

  const wrap = document.createElement('div');
  wrap.className = 'c-msg ' + (propio ? 'own' : 'other');

  let content = '';
  const tipo = data.tipo || 'text';

  if (tipo === 'image') {
    const safeUrl  = escAttr(data.url || '');
    const safeName = escAttr(data.fileName || 'imagen');
    content = `
      <div class="c-img-wrap" onclick="openLightbox('${safeUrl}','${safeName}')">
        <img src="${safeUrl}" alt="${safeName}" loading="lazy">
        <div class="c-img-overlay">
          <span class="material-icons-round" style="font-size:36px;opacity:.9">zoom_in</span>
        </div>
        <a class="c-img-dl" href="${safeUrl}" download="${safeName}"
           onclick="event.stopPropagation()" title="Descargar">
          <span class="material-icons-round">download</span>
        </a>
      </div>`;
  } else if (tipo === 'file') {
    const safeUrl  = escAttr(data.url || '');
    const safeName = escAttr(data.fileName || 'archivo');
    content = `
      <a class="c-file" href="${safeUrl}" download="${safeName}" target="_blank">
        <span class="material-icons-round c-file-icon">${fileIcon(data.fileName || '')}</span>
        <div class="c-file-info">
          <span class="c-file-name">${escHtml(data.fileName || 'Archivo')}</span>
          <span class="c-file-size">${escHtml(data.fileSize || '')}</span>
        </div>
        <span class="c-file-dl">
          <span class="material-icons-round">download</span>
        </span>
      </a>`;
  } else {
    content = `<div class="c-bubble">${escHtml(data.texto)}</div>`;
  }

  wrap.innerHTML = `
    ${!propio ? `<div class="c-name">${escHtml(data.nombre)}</div>` : ''}
    ${content}
    <div class="c-time">${hora}</div>
  `;
  c.appendChild(wrap);
  c.scrollTop = c.scrollHeight;
}

function addSysMsg(txt) {
  const c = document.getElementById('chat-msgs');
  const div = document.createElement('div');
  div.className = 'c-sys';
  div.textContent = txt;
  c.appendChild(div);
  c.scrollTop = c.scrollHeight;
}

// LIGHTBOX
function openLightbox(url, name) {
  document.getElementById('lightbox-img').src = url;
  const dl = document.getElementById('lightbox-dl');
  dl.href = url; dl.download = name;
  document.getElementById('lightbox').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function closeLightbox() {
  document.getElementById('lightbox').style.display = 'none';
  document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });

// ════════════════════════════════════
//  HELPERS
// ════════════════════════════════════
function iniciarReloj() {
  const upd = () => {
    const n = new Date();
    document.getElementById('room-time').textContent =
      n.toLocaleTimeString('es-PY', { hour: '2-digit', minute: '2-digit' });
  };
  upd(); setInterval(upd, 30000);
}

function copyLink() {
  navigator.clipboard.writeText(location.href.split('?')[0])
    .then(() => alert('✅ Enlace copiado al portapapeles'));
}

function escHtml(t) {
  if (!t) return '';
  return t.replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
}
function escAttr(t) {
  return (t || '').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
}
function formatSize(bytes) {
  if (!bytes) return '';
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1048576) return (bytes/1024).toFixed(1) + ' KB';
  return (bytes/1048576).toFixed(1) + ' MB';
}
function fileIcon(name) {
  const ext = (name || '').split('.').pop().toLowerCase();
  const map = {
    pdf:'picture_as_pdf',
    doc:'description', docx:'description',
    xls:'table_chart', xlsx:'table_chart',
    ppt:'slideshow',   pptx:'slideshow',
    txt:'text_snippet',
    zip:'folder_zip',  rar:'folder_zip',
    mp4:'videocam',    mp3:'audio_file',
    jpg:'image', jpeg:'image', png:'image', gif:'image', webp:'image'
  };
  return map[ext] || 'insert_drive_file';
}
</script>
</body>
</html>
