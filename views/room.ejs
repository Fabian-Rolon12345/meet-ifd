<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>IFD Meet - Reunión</title>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons+Round"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:#202124;--surface:#2d2e31;--elevated:#3c4043;
      --maroon:#6d1a2e;--maroon-d:#4a1220;
      --red:#ea4335;--green:#1e8e3e;
      --t1:#e8eaed;--t2:#9aa0a6;--brd:rgba(255,255,255,0.1);
    }
    html,body{height:100%;overflow:hidden;font-family:'Roboto',sans-serif;background:var(--bg);color:var(--t1)}

    /* ══════════ MODAL IFD PASSWORD ══════════ */
    #ifd-modal{
      position:fixed;inset:0;z-index:99999;
      background:rgba(0,0,0,0.9);backdrop-filter:blur(12px);
      display:none;align-items:center;justify-content:center;padding:20px;
    }
    #ifd-modal.show{display:flex}
    .ifd-card{
      background:#fff;border-radius:24px;padding:40px 36px;
      width:100%;max-width:430px;color:#202124;
      box-shadow:0 28px 72px rgba(0,0,0,.6);
      position:relative;overflow:hidden;
      animation:modalIn .4s cubic-bezier(0.16,1,0.3,1);
    }
    .ifd-card::before{content:'';position:absolute;top:0;left:0;right:0;height:5px;background:linear-gradient(90deg,#6d1a2e,#a02040,#6d1a2e)}
    @keyframes modalIn{from{opacity:0;transform:translateY(24px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
    .ifd-logo{width:72px;height:72px;border-radius:18px;background:linear-gradient(135deg,#6d1a2e,#a02040);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;box-shadow:0 10px 28px rgba(109,26,46,.4);overflow:hidden}
    .ifd-logo img{width:100%;height:100%;object-fit:cover;border-radius:18px}
    .ifd-logo .fb{font-size:34px}
    .ifd-card h2{font-family:'Google Sans',sans-serif;font-size:23px;font-weight:700;text-align:center;margin-bottom:4px}
    .ifd-sub{font-size:13px;color:#5f6368;text-align:center;line-height:1.5;margin-bottom:24px}
    .ifd-dots{display:flex;gap:7px;justify-content:center;margin-bottom:22px}
    .ifd-dot{width:8px;height:8px;border-radius:50%;background:#ddd;transition:background .3s}
    .ifd-dot.on{background:#6d1a2e}
    .ifd-user{display:flex;align-items:center;gap:11px;background:#f8f9fa;border-radius:12px;padding:11px 15px;margin-bottom:20px;border:1px solid #e8eaed}
    .ifd-ava{width:40px;height:40px;border-radius:50%;object-fit:cover;border:2px solid #dadce0;flex-shrink:0}
    .ifd-ava-ph{width:40px;height:40px;border-radius:50%;background:#6d1a2e;color:#fff;font-weight:700;font-size:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .ifd-uname{font-size:13.5px;font-weight:600}
    .ifd-uemail{font-size:11.5px;color:#888}
    .ifd-lbl{display:block;font-size:11px;font-weight:700;color:#444;text-transform:uppercase;letter-spacing:.6px;margin-bottom:7px}
    .ifd-iw{position:relative;margin-bottom:6px}
    .ifd-iw input{width:100%;padding:13px 44px 13px 14px;border:2px solid #e0e0e0;border-radius:11px;font-size:15px;font-family:inherit;color:#202124;background:#fafafa;letter-spacing:1.5px;transition:border-color .2s,box-shadow .2s}
    .ifd-iw input:focus{outline:none;border-color:#6d1a2e;box-shadow:0 0 0 3px rgba(109,26,46,.12);background:#fff}
    .ifd-eye{position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;font-size:18px;color:#aaa}
    .ifd-eye:hover{color:#6d1a2e}
    .ifd-hint{font-size:12px;color:#aaa;margin-bottom:16px}
    .ifd-err{background:#fce8e6;border:1px solid #f5c6c4;border-radius:9px;padding:9px 13px;font-size:13px;color:#c62828;display:none;align-items:center;gap:7px;margin-bottom:14px}
    .ifd-err.show{display:flex;animation:shake .3s}
    @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-4px)}75%{transform:translateX(4px)}}
    .ifd-ok{background:#e8f5e9;border:1px solid #c8e6c9;border-radius:9px;padding:9px 13px;font-size:13px;color:#2e7d32;margin-bottom:14px;display:flex;align-items:center;gap:7px}
    .ifd-btn{width:100%;padding:14px;border:none;border-radius:11px;background:linear-gradient(135deg,#6d1a2e,#a02040);color:#fff;font-size:15px;font-weight:600;font-family:inherit;cursor:pointer;margin-bottom:12px;transition:transform .15s,box-shadow .15s;box-shadow:0 4px 16px rgba(109,26,46,.35)}
    .ifd-btn:hover{transform:translateY(-1px);box-shadow:0 7px 26px rgba(109,26,46,.45)}
    .ifd-btn:disabled{opacity:.65;cursor:not-allowed;transform:none}
    .ifd-div{text-align:center;color:#ccc;font-size:12px;margin:2px 0 12px;position:relative}
    .ifd-div::before,.ifd-div::after{content:'';position:absolute;top:50%;width:42%;height:1px;background:#e8eaed}
    .ifd-div::before{left:0}.ifd-div::after{right:0}
    .ifd-gbtn{width:100%;padding:12px;border:1.5px solid #dadce0;border-radius:11px;background:#fff;color:#202124;font-size:14px;font-family:inherit;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:9px;text-decoration:none;transition:background .2s,box-shadow .2s;margin-bottom:8px}
    .ifd-gbtn:hover{background:#f8f9fa;box-shadow:0 2px 8px rgba(0,0,0,.1)}
    .ifd-gbtn img{width:17px}
    .ifd-back{width:100%;padding:10px;border:1px solid #e0e0e0;border-radius:11px;background:transparent;color:#888;font-size:13px;font-family:inherit;cursor:pointer;transition:background .2s}
    .ifd-back:hover{background:#f5f5f5}
    .ifd-spin{display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle;margin-right:6px}
    @keyframes spin{to{transform:rotate(360deg)}}

    /* ══════════ MODAL SALA DE ESPERA ══════════ */
    #waiting-modal{position:fixed;inset:0;z-index:99998;background:rgba(0,0,0,.85);backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center;padding:20px}
    #waiting-modal.show{display:flex}
    .wcard{background:#fff;border-radius:22px;padding:40px 32px;max-width:360px;width:100%;text-align:center;box-shadow:0 24px 64px rgba(0,0,0,.4);animation:modalIn .4s ease}
    .wicon{width:72px;height:72px;border-radius:50%;background:#f5f5f5;display:flex;align-items:center;justify-content:center;font-size:34px;margin:0 auto 18px}
    .wcard h3{font-family:'Google Sans',sans-serif;font-size:20px;color:#202124;margin-bottom:8px}
    .wcard p{color:#666;font-size:14px;margin-bottom:0}
    .wbar{width:100%;height:4px;background:#f0f0f0;border-radius:2px;overflow:hidden;margin:20px 0}
    .wbar-fill{height:100%;width:35%;background:linear-gradient(90deg,#6d1a2e,#a02040);border-radius:2px;animation:wbar 1.8s ease-in-out infinite}
    @keyframes wbar{0%{transform:translateX(-100%)}100%{transform:translateX(380%)}}
    .wcancel{padding:10px 26px;background:#f5f5f5;border:none;border-radius:9px;cursor:pointer;color:#666;font-family:inherit;font-size:14px;transition:background .2s}
    .wcancel:hover{background:#fce8e6;color:#c62828}

    /* ══════════ PANEL SOLICITUDES HOST ══════════ */
    #req-panel{position:fixed;top:80px;right:16px;z-index:9000;width:316px;display:none;flex-direction:column}
    #req-panel.show{display:flex}
    .rph{background:linear-gradient(135deg,#6d1a2e,#a02040);color:#fff;padding:11px 15px;border-radius:14px 14px 0 0;font-size:13px;font-weight:600;display:flex;align-items:center;justify-content:space-between}
    .rph-badge{background:rgba(255,255,255,.25);border-radius:10px;padding:2px 8px;font-size:12px;font-weight:700}
    .rpl{background:#fff;border-radius:0 0 14px 14px;box-shadow:0 8px 32px rgba(0,0,0,.2);overflow:hidden;max-height:70vh;overflow-y:auto}
    .rpi{display:flex;align-items:center;gap:10px;padding:12px 14px;border-bottom:1px solid #f5f5f5}
    .rpi:last-child{border-bottom:none}
    .rpi-ava{width:38px;height:38px;border-radius:50%;background:#6d1a2e;color:#fff;font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden}
    .rpi-ava img{width:100%;height:100%;object-fit:cover}
    .rpi-info{flex:1;min-width:0}
    .rpi-name{font-size:13px;font-weight:600;color:#202124;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .rpi-email{font-size:11px;color:#888;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .rpi-btns{display:flex;gap:5px;flex-shrink:0}
    .btn-admit{padding:6px 11px;background:#1e8e3e;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;transition:background .2s}
    .btn-admit:hover{background:#137333}
    .btn-reject{padding:6px 10px;background:#f5f5f5;color:#c62828;border:1px solid #ffcdd2;border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;transition:background .2s}
    .btn-reject:hover{background:#fce8e6}

    /* ══════════ EMOJI PICKER ══════════ */
    #emoji-picker{
      position:fixed;bottom:90px;left:50%;transform:translateX(-50%);
      background:#2d2e31;border:1px solid rgba(255,255,255,.15);
      border-radius:16px;padding:14px 16px;z-index:5000;
      box-shadow:0 12px 40px rgba(0,0,0,.5);
      display:none;flex-wrap:wrap;gap:8px;max-width:320px;justify-content:center;
      animation:emojiIn .2s ease;
    }
    #emoji-picker.show{display:flex}
    @keyframes emojiIn{from{opacity:0;transform:translateX(-50%) translateY(10px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}
    .ep-btn{font-size:26px;cursor:pointer;padding:6px;border-radius:10px;border:none;background:transparent;transition:transform .15s,background .15s;line-height:1}
    .ep-btn:hover{transform:scale(1.3);background:rgba(255,255,255,.1)}

    /* ══════════ INDICADOR GRABACIÓN ══════════ */
    #rec-ind{display:none;align-items:center;gap:6px;background:rgba(234,67,53,.15);border:1px solid rgba(234,67,53,.4);border-radius:20px;padding:5px 12px;font-size:12px;color:#ea4335}
    #rec-ind.show{display:flex}
    .rdot{width:7px;height:7px;background:#ea4335;border-radius:50%;animation:rpulse 1s infinite}
    @keyframes rpulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.7)}}
    #btn-record.recording{background:var(--red)!important}

    /* ══════════ TOAST ══════════ */
    #toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);padding:11px 22px;border-radius:11px;font-size:14px;font-weight:500;z-index:9997;pointer-events:none;opacity:0;transition:opacity .3s;max-width:380px;text-align:center;box-shadow:0 8px 28px rgba(0,0,0,.3)}
    #toast.show{opacity:1}

    /* ══════════ LOBBY ══════════ */
    #lobby{position:fixed;inset:0;z-index:1000;background:#111214;display:flex;flex-direction:column}
    .lhdr{height:64px;display:flex;align-items:center;padding:0 24px;gap:12px;border-bottom:1px solid var(--brd);flex-shrink:0}
    .lhdr-logo{width:36px;height:36px;border-radius:8px;object-fit:cover}
    .lhdr-brand{font-family:'Google Sans',sans-serif;font-size:20px;font-weight:500}
    .lbody{flex:1;display:flex;align-items:center;justify-content:center;gap:40px;padding:32px;flex-wrap:wrap;overflow-y:auto}
    .lprev{position:relative;width:560px;max-width:100%;aspect-ratio:16/9;background:#1a1a1d;border-radius:20px;overflow:hidden;box-shadow:0 8px 40px rgba(0,0,0,.5);flex-shrink:0}
    #lobby-video{width:100%;height:100%;object-fit:cover;display:block;transform:scaleX(-1)}
    .lcamoff{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:#1a1a1d}
    .lcamoff .material-icons-round{font-size:64px;color:#5f6368}
    .lcamoff .txt{font-size:14px;color:#5f6368}
    .luser-tag{position:absolute;bottom:16px;left:16px;background:rgba(0,0,0,.6);backdrop-filter:blur(6px);padding:6px 14px;border-radius:20px;font-size:14px;font-weight:500}
    .lctrl-wrap{position:absolute;bottom:16px;right:16px;display:flex;gap:8px}
    .lctrl{width:44px;height:44px;border-radius:50%;border:none;background:rgba(60,64,67,.9);color:var(--t1);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.15s;backdrop-filter:blur(6px)}
    .lctrl:hover{background:rgba(82,87,92,.9)}.lctrl.off{background:var(--red)}
    .lctrl .material-icons-round{font-size:20px}
    .lpanel{width:340px;max-width:100%;background:#fff;border-radius:16px;padding:28px 24px;color:#202124;box-shadow:0 4px 20px rgba(0,0,0,.3);display:flex;flex-direction:column;gap:20px}
    .lpanel h2{font-family:'Google Sans',sans-serif;font-size:22px;font-weight:500}
    .llink-box{display:flex;align-items:center;border:1px solid #dadce0;border-radius:8px;padding:10px 14px;gap:8px;background:#f8f9fa}
    .llink-box .material-icons-round{font-size:18px;color:#5f6368}
    .llink-txt{flex:1;font-size:13px;color:#202124;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;background:none;border:none;outline:none;cursor:pointer}
    .lcopy-btn{background:none;border:none;cursor:pointer;color:#1a73e8;padding:4px;border-radius:4px;display:flex;align-items:center;justify-content:center;transition:background .15s}
    .lcopy-btn:hover{background:rgba(26,115,232,.08)}
    .lcopy-btn .material-icons-round{font-size:18px}
    .linfo{font-size:13px;color:#5f6368;line-height:1.5;display:flex;align-items:flex-start;gap:8px}
    .linfo .material-icons-round{font-size:16px;color:#1a73e8;flex-shrink:0;margin-top:1px}
    .luser{display:flex;align-items:center;gap:10px;padding:10px 0;border-top:1px solid #f1f3f4}
    .luser-ava{width:36px;height:36px;border-radius:50%;object-fit:cover}
    .luser-name{font-size:13px;color:#202124;font-weight:500}
    .luser-email{font-size:11px;color:#9aa0a6}
    .ljoin-btn{width:100%;padding:14px;background:var(--maroon);color:#fff;border:none;border-radius:28px;font-size:15px;font-weight:500;cursor:pointer;transition:.15s;display:flex;align-items:center;justify-content:center;gap:8px}
    .ljoin-btn:hover{background:var(--maroon-d);transform:translateY(-1px)}
    .ljoin-btn .material-icons-round{font-size:20px}
    .ltoast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#323232;color:#fff;padding:12px 24px;border-radius:8px;font-size:14px;font-weight:500;opacity:0;transition:opacity .3s;pointer-events:none;z-index:9999}
    .ltoast.show{opacity:1}

    /* ══════════ SALA ══════════ */
    #app{display:flex;flex-direction:column;height:100vh}
    #header{height:64px;min-height:64px;background:var(--surface);border-bottom:1px solid var(--brd);display:flex;align-items:center;justify-content:space-between;padding:0 16px;z-index:100;flex-shrink:0}
    .hbrand{display:flex;align-items:center;gap:10px;flex:1}
    .hlogo{width:36px;height:36px;border-radius:8px;object-fit:cover;flex-shrink:0}
    .hname{font-family:'Google Sans',sans-serif;font-size:18px;font-weight:500;white-space:nowrap}
    .hcenter{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.07);padding:7px 14px;border-radius:20px;flex-shrink:0}
    .htime,.hcode{font-size:14px;color:var(--t2)}
    .hsep{color:var(--t2);font-size:12px}
    .hactions{display:flex;align-items:center;gap:4px;flex:1;justify-content:flex-end}
    .icon-btn{width:40px;height:40px;border-radius:50%;background:transparent;border:none;color:var(--t2);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.15s;position:relative}
    .icon-btn:hover{background:rgba(255,255,255,.1);color:var(--t1)}
    .icon-btn .material-icons-round{font-size:22px}
    .badge{position:absolute;top:4px;right:4px;min-width:16px;height:16px;background:var(--maroon);color:#fff;border-radius:8px;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;padding:0 3px}
    #main{flex:1;display:flex;overflow:hidden;position:relative}
    #video-area{flex:1;display:flex;align-items:center;justify-content:center;padding:24px;overflow:hidden;background:var(--bg)}
    #vgrid{width:100%;height:100%;display:grid;gap:16px;align-content:center;justify-content:center;align-items:center;max-width:1280px}
    #vgrid.n1{grid-template-columns:1fr}
    #vgrid.n1 .vtile{width:420px;max-width:100%;margin:0 auto;aspect-ratio:16/9;box-shadow:0 10px 40px rgba(0,0,0,.65);border-radius:16px;transition:transform .25s,box-shadow .25s}
    #vgrid.n1 .vtile:hover{transform:scale(1.03);box-shadow:0 15px 50px rgba(0,0,0,.75)}
    #vgrid.n2{grid-template-columns:repeat(2,1fr)}
    #vgrid.n3,#vgrid.n4{grid-template-columns:repeat(2,1fr)}
    #vgrid.n5,#vgrid.n6{grid-template-columns:repeat(3,1fr)}
    .vtile{position:relative;background:var(--surface);border-radius:16px;overflow:hidden;aspect-ratio:16/9;min-height:0;border:2px solid transparent;transition:border-color .2s,box-shadow .2s;box-shadow:0 4px 20px rgba(0,0,0,.4)}
    .vtile.speaking{border-color:var(--green)}
    .vtile video{width:100%;height:100%;object-fit:cover;display:block}
    .vtile.self video{transform:scaleX(-1)}
    .vph{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:linear-gradient(135deg,var(--maroon),var(--maroon-d))}
    .vava{width:72px;height:72px;border-radius:50%;background:rgba(255,255,255,.15);border:3px solid rgba(255,255,255,.25);display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;color:#fff}
    .vlbl{position:absolute;bottom:12px;left:12px;background:rgba(0,0,0,.65);backdrop-filter:blur(8px);padding:6px 14px;border-radius:20px;font-size:13.5px;font-weight:500;color:#fff;display:flex;align-items:center;gap:6px;box-shadow:0 2px 10px rgba(0,0,0,.4)}
    .vlbl .material-icons-round{font-size:14px}.vlbl .m{color:var(--red)}
    #side-panel{width:360px;background:var(--surface);border-left:1px solid var(--brd);display:none;flex-direction:column;flex-shrink:0;z-index:50}
    #side-panel.open{display:flex}
    .ptabs{display:flex;border-bottom:1px solid var(--brd);flex-shrink:0}
    .ptab{flex:1;padding:14px 8px;text-align:center;font-size:13px;font-weight:500;color:var(--t2);cursor:pointer;border:none;background:none;border-bottom:2px solid transparent;transition:.15s;display:flex;align-items:center;justify-content:center;gap:6px}
    .ptab.on{color:var(--t1);border-bottom-color:var(--maroon)}.ptab:hover:not(.on){color:var(--t1)}
    .ptab .material-icons-round{font-size:16px}
    .ppane{display:none;flex:1;flex-direction:column;overflow:hidden}.ppane.on{display:flex}
    .plist{flex:1;overflow-y:auto;padding:8px}
    .pitem{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;transition:.15s}.pitem:hover{background:rgba(255,255,255,.05)}
    .pava{width:38px;height:38px;border-radius:50%;background:var(--maroon);display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:600;color:#fff;flex-shrink:0}
    .pname{flex:1;font-size:14px;font-weight:500}.prole{font-size:11px;color:#f9ab00}
    .picons{display:flex;gap:4px;color:var(--t2)}.picons .material-icons-round{font-size:16px}.picons .m{color:var(--red)}
    .chat-msgs{flex:1;overflow-y:auto;padding:12px 10px;display:flex;flex-direction:column;gap:4px;scroll-behavior:smooth;background:#1a1a1d}
    .chat-msgs::-webkit-scrollbar{width:4px}.chat-msgs::-webkit-scrollbar-thumb{background:rgba(255,255,255,.12);border-radius:2px}
    .cmsg{display:flex;flex-direction:column;max-width:82%;animation:msgIn .18s ease}
    @keyframes msgIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
    .cmsg.own{align-self:flex-end;align-items:flex-end}.cmsg.other{align-self:flex-start}
    .cname{font-size:11px;font-weight:600;color:#9aa0a6;margin-bottom:3px;padding-left:2px}
    .cbub{background:#2d2e31;color:#e8eaed;padding:9px 13px;border-radius:18px 18px 18px 4px;font-size:14px;line-height:1.5;word-break:break-word;white-space:pre-wrap}
    .cmsg.own .cbub{background:#6d1a2e;border-radius:18px 18px 4px 18px}
    .ctime{font-size:10px;color:#5f6368;margin-top:3px;padding:0 2px}
    .csys{text-align:center;font-size:11px;color:#5f6368;padding:6px 0;font-style:italic}
    .cdatesep{text-align:center;font-size:11px;color:#5f6368;padding:8px 0;display:flex;align-items:center;gap:8px}
    .cdatesep::before,.cdatesep::after{content:'';flex:1;height:1px;background:rgba(255,255,255,.07)}
    .cimgw{position:relative;max-width:240px;border-radius:14px;overflow:hidden;cursor:zoom-in;background:#2d2e31}
    .cimgw img{width:100%;display:block;border-radius:14px;transition:filter .15s}.cimgw:hover img{filter:brightness(.82)}
    .cimgo{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .15s;color:#fff}.cimgw:hover .cimgo{opacity:1}
    .cimgdl{position:absolute;bottom:8px;right:8px;background:rgba(0,0,0,.65);border:none;color:#fff;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;transition:opacity .15s;text-decoration:none}.cimgw:hover .cimgdl{opacity:1}
    .cimgdl .material-icons-round{font-size:16px}
    .cfile{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.07);padding:10px 14px;border-radius:12px;max-width:260px;text-decoration:none;color:#e8eaed;transition:background .15s}.cfile:hover{background:rgba(255,255,255,.13)}
    .cfile-icon{font-size:26px;flex-shrink:0}
    .cfile-info{display:flex;flex-direction:column;gap:2px;min-width:0;flex:1}
    .cfile-name{font-size:13px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .cfile-size{font-size:11px;color:#9aa0a6}
    .cfile-dl .material-icons-round{font-size:20px;color:#9aa0a6}
    #attach-prev{background:#252528;border-top:1px solid rgba(255,255,255,.08);padding:10px 12px;display:flex;align-items:center;gap:10px;flex-shrink:0}
    #attach-prev-inner{flex:1;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    .pthumb{position:relative;width:64px;height:64px;border-radius:10px;overflow:hidden;background:#3c3c3c;flex-shrink:0}
    .pthumb img{width:100%;height:100%;object-fit:cover}
    .pfile-info{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.07);padding:8px 12px;border-radius:10px;font-size:13px;color:#e8eaed;max-width:200px}
    .pfile-info .material-icons-round{font-size:22px;color:#9aa0a6}
    .pfile-name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .acancel{background:rgba(255,255,255,.1);border:none;color:#9aa0a6;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0}
    .acancel:hover{background:rgba(255,255,255,.18);color:#fff}.acancel .material-icons-round{font-size:18px}
    .cin-row{display:flex;align-items:flex-end;gap:6px;padding:10px;border-top:1px solid rgba(255,255,255,.08);background:#202124;flex-shrink:0}
    .ctool-btn{width:36px;height:36px;border-radius:50%;background:transparent;border:none;color:#9aa0a6;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.15s}
    .ctool-btn:hover{background:rgba(255,255,255,.1);color:#e8eaed}.ctool-btn .material-icons-round{font-size:20px}
    .ctextarea{flex:1;background:#2d2e31;border:1px solid rgba(255,255,255,.1);border-radius:20px;color:#e8eaed;padding:9px 15px;font-family:inherit;font-size:14px;resize:none;outline:none;min-height:38px;max-height:130px;line-height:1.45;transition:border-color .15s;overflow-y:auto}
    .ctextarea:focus{border-color:#6d1a2e}.ctextarea::placeholder{color:#5f6368}
    .csend{width:38px;height:38px;border-radius:50%;background:#6d1a2e;border:none;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.15s}
    .csend:hover{background:#4a1220;transform:scale(1.08)}.csend .material-icons-round{font-size:20px}
    #controls{height:76px;min-height:76px;background:var(--surface);border-top:1px solid var(--brd);display:flex;align-items:center;justify-content:center;padding:0 20px;flex-shrink:0;z-index:100;gap:8px}
    .ctrl-btn{width:48px;height:48px;border-radius:50%;border:none;background:var(--elevated);color:var(--t1);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.15s}
    .ctrl-btn:hover{background:rgba(255,255,255,.15);transform:translateY(-1px)}.ctrl-btn .material-icons-round{font-size:22px}
    .ctrl-btn.muted{background:var(--red)}.ctrl-btn.screen-on{background:rgba(0,121,107,.9)}
    .cdiv{width:1px;height:30px;background:var(--brd);margin:0 4px}
    .ctrl-leave{background:var(--red);width:56px;height:48px;border-radius:28px}.ctrl-leave:hover{background:#c5291e}
    #lightbox{position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:9999;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(8px);cursor:zoom-out}
    #lbx-inner{position:relative;max-width:90vw;max-height:90vh;cursor:default}
    #lbx-img{max-width:90vw;max-height:82vh;border-radius:12px;display:block;box-shadow:0 20px 60px rgba(0,0,0,.6)}
    .lbx-close{position:absolute;top:-16px;right:-16px;background:rgba(0,0,0,.7);border:none;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;cursor:pointer}
    .lbx-dl{position:absolute;bottom:-52px;left:50%;transform:translateX(-50%);background:#6d1a2e;color:#fff;border-radius:20px;padding:9px 24px;font-size:14px;font-weight:500;text-decoration:none;display:flex;align-items:center;gap:6px;white-space:nowrap}
    .lbx-dl:hover{background:#4a1220}
    ::-webkit-scrollbar{width:5px}::-webkit-scrollbar-thumb{background:rgba(255,255,255,.15);border-radius:3px}
    @media(max-width:768px){
      .lbody{flex-direction:column;gap:24px;padding:16px}.lprev{width:100%}.lpanel{width:100%}
      #header{padding:0 10px}.hname{display:none}
      #side-panel{position:absolute;right:0;top:64px;bottom:76px;width:100%;max-width:340px}
      #vgrid.n1 .vtile{width:92%}
      #req-panel{width:calc(100% - 32px)}
      #emoji-picker{width:90%}
    }
  </style>
</head>
<body>

<!-- ══════════════════════════════════════════════
     MODAL IFD PASSWORD (para invitados sin Google)
══════════════════════════════════════════════ -->
<div id="ifd-modal">
  <div class="ifd-card">

    <!-- Logo IFD -->
    <div style="text-align:center;margin-bottom:22px">
      <div class="ifd-logo">
        <img src="/img/logo-ifd.png" alt="IFD"
             onerror="this.style.display='none';this.parentNode.querySelector('.fb').style.display='block'"/>
        <span class="fb" style="display:none">🎓</span>
      </div>
      <h2>IFD Meet</h2>
      <p class="ifd-sub">Instituto de Formación Docente<br>Santa Rosa, Misiones</p>
    </div>

    <!-- Indicador de pasos -->
    <div class="ifd-dots">
      <div class="ifd-dot on" id="d1"></div>
      <div class="ifd-dot" id="d2"></div>
    </div>

    <!-- PASO 1: Contraseña -->
    <div id="step1">
      <label class="ifd-lbl">Contraseña institucional</label>
      <div class="ifd-iw">
        <input type="password" id="ifd-pw" placeholder="Contraseña del IFD"
               onkeydown="if(event.key==='Enter')ifdCheck()"
               oninput="document.getElementById('ifd-err').classList.remove('show')"/>
        <button class="ifd-eye" onclick="ifdEye()" type="button">👁️</button>
      </div>
      <p class="ifd-hint">Solo para miembros del IFD Santa Rosa</p>
      <div class="ifd-err" id="ifd-err"><span>🔒</span><span id="ifd-err-txt">Contraseña incorrecta</span></div>
      <button class="ifd-btn" id="ifd-check-btn" onclick="ifdCheck()">Verificar contraseña</button>
      <div class="ifd-div">— o —</div>
      <a href="/auth/google" class="ifd-gbtn">
        <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="G"/>
        Iniciar sesión con Google
      </a>
    </div>

    <!-- PASO 2: Nombre -->
    <div id="step2" style="display:none">
      <div class="ifd-ok">✅ Contraseña correcta</div>
      <label class="ifd-lbl">Tu nombre completo</label>
      <div class="ifd-iw">
        <input type="text" id="ifd-name" placeholder="Ej: María González"
               onkeydown="if(event.key==='Enter')ifdEnter()"/>
      </div>
      <p class="ifd-hint" style="margin-bottom:16px">Se verá en la reunión</p>
      <button class="ifd-btn" onclick="ifdEnter()">Entrar a la reunión →</button>
      <button class="ifd-back" onclick="ifdBack()">← Volver</button>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════
     MODAL SALA DE ESPERA
══════════════════════════════════════════════ -->
<div id="waiting-modal">
  <div class="wcard">
    <div class="wicon">⏳</div>
    <h3>Esperando admisión</h3>
    <p id="wmsg">El anfitrión revisará tu solicitud...</p>
