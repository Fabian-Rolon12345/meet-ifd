// ════════════════════════════════════════════════════════
//  ✅ GRABACIÓN
// ════════════════════════════════════════════════════════
let mediaRecorder = null, recordedChunks = [], isRecording = false;
let recStartTime = null, recTimerInterval = null;

async function toggleRecording() {
  if (isRecording) {
    detenerGrabacion();
  } else {
    await iniciarGrabacion();
  }
}

async function iniciarGrabacion() {
  try {
    // Capturar pantalla
    let displayStream;
    try {
      displayStream = await navigator.mediaDevices.getDisplayMedia({
        video: { width:{ideal:1920}, height:{ideal:1080}, frameRate:{ideal:30} },
        audio: true
      });
    } catch(e) { console.warn('Sin pantalla, grabando solo audio'); }

    // Mezclar audio
    const audioCtx = new AudioContext();
    const dest = audioCtx.createMediaStreamDestination();
    if (displayStream?.getAudioTracks().length > 0) {
      audioCtx.createMediaStreamSource(displayStream).connect(dest);
    }
    if (miStream?.getAudioTracks().length > 0) {
      audioCtx.createMediaStreamSource(miStream).connect(dest);
    }

    // Stream combinado
    const tracks = [];
    if (displayStream?.getVideoTracks().length > 0) tracks.push(...displayStream.getVideoTracks());
    tracks.push(...dest.stream.getAudioTracks());
    const combined = new MediaStream(tracks);

    // Elegir codec
    const mimeType = ['video/webm;codecs=vp9,opus','video/webm;codecs=vp8,opus','video/webm','video/mp4']
      .find(t => MediaRecorder.isTypeSupported(t)) || 'video/webm';

    recordedChunks = [];
    mediaRecorder = new MediaRecorder(combined, { mimeType, videoBitsPerSecond: 2500000 });
    mediaRecorder.ondataavailable = e => { if (e.data?.size > 0) recordedChunks.push(e.data); };
    mediaRecorder.onstop = () => {
      guardarGrabacion();
      combined.getTracks().forEach(t => t.stop());
      if (displayStream) displayStream.getTracks().forEach(t => t.stop());
    };
    mediaRecorder.start(1000);

    isRecording = true;
    recStartTime = Date.now();
    document.getElementById('btn-record').classList.add('recording');
    document.getElementById('icon-record').textContent = 'stop';
    document.getElementById('rec-indicator').classList.add('show');

    recTimerInterval = setInterval(() => {
      const s = Math.round((Date.now() - recStartTime) / 1000);
      const m = Math.floor(s / 60).toString().padStart(2,'0');
      const ss = (s % 60).toString().padStart(2,'0');
      document.getElementById('rec-timer').textContent = m + ':' + ss;
    }, 1000);

    socket.emit('recording-started', { roomId: window.ROOM_ID, userName: window.USER_NAME });
    showToast('🎥 Grabación iniciada', '#1e8e3e');

    if (displayStream) {
      displayStream.getVideoTracks()[0].addEventListener('ended', () => {
        if (isRecording) detenerGrabacion();
      });
    }

  } catch(err) {
    console.error('Error grabación:', err);
    showToast('❌ No se pudo iniciar la grabación', '#ea4335');
  }
}

function detenerGrabacion() {
  if (mediaRecorder && mediaRecorder.state !== 'inactive') mediaRecorder.stop();
  isRecording = false;
  clearInterval(recTimerInterval);
  document.getElementById('btn-record').classList.remove('recording');
  document.getElementById('icon-record').textContent = 'fiber_manual_record';
  document.getElementById('rec-indicator').classList.remove('show');
  document.getElementById('rec-timer').textContent = '00:00';
  socket.emit('recording-stopped', { roomId: window.ROOM_ID, userName: window.USER_NAME });
}

async function guardarGrabacion() {
  if (!recordedChunks.length) return;
  const blob = new Blob(recordedChunks, { type: 'video/webm' });
  const duration = Math.round((Date.now() - recStartTime) / 1000);
  const now = new Date();
  const dateStr = now.toLocaleDateString('es-PY').replace(/\//g, '-');
  const timeStr = now.toLocaleTimeString('es-PY',{hour:'2-digit',minute:'2-digit'}).replace(':','h');
  const filename = `IFD-Clase-${dateStr}-${timeStr}.webm`;
  const mb = (blob.size/1024/1024).toFixed(1);

  showToast(`💾 Guardando grabación (${mb}MB)...`, '#1565c0');

  // Intentar subir al servidor
  try {
    const fd = new FormData();
    fd.append('recording', blob, filename);
    const res = await fetch('/upload-recording', { method: 'POST', body: fd });
    const data = await res.json();
    if (data.ok) {
      showToast(`✅ Grabación guardada: ${data.filename}`, '#1e8e3e', 8000);
      return;
    }
  } catch(e) { console.warn('Servidor no disponible, descargando localmente'); }

  // Fallback: descargar al PC
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename; a.click();
  setTimeout(() => URL.revokeObjectURL(url), 10000);
  showToast(`✅ Grabación descargada: ${filename}`, '#1e8e3e', 8000);
}

