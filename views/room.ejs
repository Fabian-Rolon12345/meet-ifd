function addRequest(sid, nombre, email, foto) {
  // Evitar duplicados
  if (document.getElementById('req-' + sid)) return;
  const panel = document.getElementById('req-panel');
  const list  = document.getElementById('req-list');
  panel.classList.add('show');
  const ini = (nombre||'?')[0].toUpperCase();
  const item = document.createElement('div');
  item.className = 'rpi'; item.id = 'req-' + sid;
  item.innerHTML = `
    <div class="rpi-ava">
      ${foto ? `<img src="${foto}" onerror="this.style.display='none';this.parentNode.textContent='${ini}'"/>` : ini}
    </div>
    <div class="rpi-info">
      <div class="rpi-name">${escH(nombre||'Invitado')}</div>
      <div class="rpi-email">${escH(email||'Invitado')}</div>
    </div>
    <div class="rpi-btns">
      <button class="btn-admit" onclick="admitUser('${sid}')">✓ Admitir</button>
      <button class="btn-reject" onclick="rejectUser('${sid}')">✗</button>
    </div>`;
  list.appendChild(item);
  updReqCount();
}

function admitUser(sid) {
  socket.emit('admit-user', sid, ROOM_ID);
  document.getElementById('req-' + sid)?.remove();
  updReqCount();
}
function rejectUser(sid) {
  socket.emit('reject-user', sid, ROOM_ID);
  document.getElementById('req-' + sid)?.remove();
  updReqCount();
}
function updReqCount() {
  const n = document.getElementById('req-list').children.length;
  document.getElementById('req-count').textContent = n;
  if (n === 0) document.getElementById('req-panel').classList.remove('show');
}

// ══════════════════════════════════════════════
//  VIDEO TILES
// ══════════════════════════════════════════════
function addTile(stream, id, nombre, self) {
  let tile = document.getElementById('tile-'+id);
  if (tile) { tile.querySelector('video').srcObject = stream; return; }
  tile = document.createElement('div');
  tile.className = 'vtile' + (self ? ' self' : '');
  tile.id = 'tile-' + id;
  const ini = nombre.split(' ').map(n=>n[0]).join('').slice(0,2).toUpperCase();
  tile.innerHTML = `
    <div class="vph" id="ph-${id}"><div class="vava">${ini}</div></div>
    <video autoplay playsinline ${self?'muted':''}></video>
    <div class="vlbl"><span class="material-icons-round">mic</span>${escH(nombre)}</div>`;
  const v = tile.querySelector('video');
  v.srcObject = stream;
  v.onloadedmetadata = () => { const p=document.getElementById('ph-'+id); if(p) p.style.display='none'; };
  document.getElementById('vgrid').appendChild(tile);
  fixGrid();
}
function fixGrid() {
  const g = document.getElementById('vgrid');
  g.className = 'n' + Math.min(g.children.length, 6);
}

