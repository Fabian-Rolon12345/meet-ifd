//  ✅ GRABACIÓN
// ══════════════════════════════════════════════
let mediaRec = null, recChunks = [], isRec = false, recStart = null, recInt = null;

async function toggleRec() { isRec ? stopRec() : await startRec(); }

async function startRec() {
  try {
    let display;
    try { display = await navigator.mediaDevices.getDisplayMedia({ video:{ width:{ideal:1920}, height:{ideal:1080} }, audio:true }); } catch(e) {}

    const ctx = new AudioContext(), dest = ctx.createMediaStreamDestination();
    if (display?.getAudioTracks().length) ctx.createMediaStreamSource(display).connect(dest);
    if (myStream?.getAudioTracks().length) ctx.createMediaStreamSource(myStream).connect(dest);

    const tracks = [];
    if (display?.getVideoTracks().length) tracks.push(...display.getVideoTracks());
    tracks.push(...dest.stream.getAudioTracks());
    const combined = new MediaStream(tracks);

    const mime = ['video/webm;codecs=vp9,opus','video/webm;codecs=vp8,opus','video/webm','video/mp4'].find(t=>MediaRecorder.isTypeSupported(t))||'video/webm';
    recChunks = [];
    mediaRec = new MediaRecorder(combined, { mimeType:mime, videoBitsPerSecond:2500000 });
    mediaRec.ondataavailable = e => { if (e.data?.size>0) recChunks.push(e.data); };
    mediaRec.onstop = () => { saveRec(); combined.getTracks().forEach(t=>t.stop()); if(display) display.getTracks().forEach(t=>t.stop()); };
    mediaRec.start(1000);

    isRec = true; recStart = Date.now();
    document.getElementById('btn-record').classList.add('recording');
    document.getElementById('ic-rec').textContent = 'stop';
    document.getElementById('rec-ind').classList.add('show');
    recInt = setInterval(() => {
      const s = Math.round((Date.now()-recStart)/1000);
      document.getElementById('rec-timer').textContent = `${String(Math.floor(s/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')}`;
    }, 1000);
    socket.emit('recording-started', { roomId:ROOM_ID, userName:myName });
    toast('🎥 Grabación iniciada', '#1e8e3e');
    if (display) display.getVideoTracks()[0].addEventListener('ended', () => { if(isRec) stopRec(); });
  } catch(e) { toast('❌ No se pudo iniciar la grabación', '#ea4335'); }
}

function stopRec() {
  if (mediaRec && mediaRec.state !== 'inactive') mediaRec.stop();
  isRec = false; clearInterval(recInt);
  document.getElementById('btn-record').classList.remove('recording');
  document.getElementById('ic-rec').textContent = 'fiber_manual_record';
  document.getElementById('rec-ind').classList.remove('show');
  document.getElementById('rec-timer').textContent = '00:00';
  socket.emit('recording-stopped', { roomId:ROOM_ID, userName:myName });
}

async function saveRec() {
  if (!recChunks.length) return;
  const blob = new Blob(recChunks, { type:'video/webm' });
  const now = new Date();
  const dateStr = now.toLocaleDateString('es-PY').replace(/\//g,'-');
  const timeStr = now.toLocaleTimeString('es-PY',{hour:'2-digit',minute:'2-digit'}).replace(':','h');
  const fn = `IFD-Clase-${dateStr}-${timeStr}.webm`;
  const sizeMB = (blob.size/1024/1024).toFixed(1);
  toast(`💾 Guardando grabación (${sizeMB}MB)...`, '#1565c0');

  // ✅ Intentar guardar con File System Access API (carpeta Grabación IFD en Escritorio)
  try {
    if (window.showSaveFilePicker) {
      const fileHandle = await window.showSaveFilePicker({
        suggestedName: fn,
        startIn: 'desktop',
        types: [{ description: 'Video WebM', accept: { 'video/webm': ['.webm'] } }]
      });
      const writable = await fileHandle.createWritable();
      await writable.write(blob);
      await writable.close();
      toast(`✅ Grabación guardada en tu escritorio: ${fn}`, '#1e8e3e', 10000);
      // También subir al servidor como respaldo
      try {
        const fd = new FormData(); fd.append('recording', blob, fn);
        await fetch('/upload-recording', { method:'POST', body:fd });
      } catch(e) {}
      return;
    }
  } catch(e) {
    if (e.name !== 'AbortError') console.warn('showSaveFilePicker error:', e);
  }

  // ✅ Fallback: guardar al servidor y luego descargar
  try {
    const fd = new FormData(); fd.append('recording', blob, fn);
    const res = await fetch('/upload-recording', { method:'POST', body:fd });
    const d = await res.json();
    if (d.ok) {
      toast(`✅ Grabación guardada en servidor: ${d.filename}`, '#1e8e3e', 8000);
      // También descargar localmente
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href=url; a.download=fn; a.click();
      setTimeout(() => URL.revokeObjectURL(url), 10000);
      return;
    }
  } catch(e) {}

  // ✅ Último fallback: descarga directa al Escritorio
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = fn;
  a.click();
  setTimeout(() => URL.revokeObjectURL(url), 10000);
  toast(`✅ Grabación descargada: ${fn} — Buscala en tu carpeta Descargas`, '#1e8e3e', 10000);
}

