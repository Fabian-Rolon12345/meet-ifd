function addTile(stream, id, nombre, self) {
  let tile = document.getElementById('tile-'+id);
  if (tile) { tile.querySelector('video').srcObject = stream; return; }
  tile = document.createElement('div');
  const isHost = self && IS_CREATOR;
  tile.className = 'vtile' + (self ? ' self' : '') + (isHost ? ' host-tile' : '');
  tile.id = 'tile-' + id;
  tile.dataset.id = id;
  tile.dataset.nombre = nombre;
  tile.dataset.self = self ? '1' : '0';
  tile.dataset.isHost = isHost ? '1' : '0';
  const ini = nombre.split(' ').map(n=>n[0]).join('').slice(0,2).toUpperCase();
  tile.innerHTML = `
    ${isHost ? '<div class="host-badge">Anfitrión</div>' : ''}
    ${self && !IS_CREATOR ? '<div class="self-badge">Tú</div>' : ''}
    ${self && IS_CREATOR ? '<div class="self-badge">Tú (Anfitrión)</div>' : ''}
    <div class="vph" id="ph-${id}"><div class="vava">${ini}</div></div>
    <video autoplay playsinline ${self?'muted':''}></video>
    <div class="vlbl"><span class="material-icons-round">mic</span>${escH(nombre)}</div>
    ${(!self && IS_CREATOR) ? `<div class="vtile-hover-ctrls" onclick="event.stopPropagation()">
      <button class="vtile-ctrl vtile-ctrl-mute" onclick="kickMuteUser('${id}','mute')" title="Silenciar">
        <span class="material-icons-round">mic_off</span>
      </button>
      <button class="vtile-ctrl vtile-ctrl-kick" onclick="kickMuteUser('${id}','kick')" title="Expulsar">
        <span class="material-icons-round">person_remove</span>
      </button>
    </div>` : ''}`;
  const v = tile.querySelector('video');
  v.srcObject = stream;
  v.onloadedmetadata = () => { const p=document.getElementById('ph-'+id); if(p) p.style.display='none'; };
  // Animación de entrada del tile
  tile.style.opacity = '0';
  tile.style.transform = 'scale(.85)';
  tile.style.transition = 'opacity .35s, transform .35s';

  // Click para poner en spotlight
  tile.addEventListener('click', () => setSpotlight(id));
  // Registrar y aplicar layout
  document.getElementById('vgrid').appendChild(tile);
  // Animar entrada (no bloquea el hilo)
  requestAnimationFrame(() => requestAnimationFrame(() => {
    tile.style.opacity = '1';
    tile.style.transform = 'scale(1)';
  }));
  fixGrid();
  if (self) startSpeakingDetector(stream, id);
}

