//  SISTEMA SPOTLIGHT TIPO GOOGLE MEET
// ══════════════════════════════════════════════
let spotlightId = null; // ID del tile actualmente en grande

function setSpotlight(id) {
  const tile = document.getElementById('tile-' + id);
  if (!tile) return;
  // Si ya está en spotlight y se clickea de nuevo → quitar spotlight
  if (spotlightId === id) {
    clearSpotlight();
    return;
  }
  spotlightId = id;
  applySpotlightLayout();
}

function clearSpotlight() {
  spotlightId = null;
  applySpotlightLayout();
}

function applySpotlightLayout() {
  const videoArea = document.getElementById('video-area');
  const mainWrap  = document.getElementById('main-tile-wrap');
  const strip     = document.getElementById('strip');
  const vgrid     = document.getElementById('vgrid');
  const allTiles  = Array.from(document.querySelectorAll('.vtile'));

  if (!spotlightId || (allTiles.length <= 1 && !presenterMode)) {
    // Modo grilla normal
    videoArea.classList.remove('spotlight-mode');
    mainWrap.style.display = 'none';
    strip.style.display = 'none';
    vgrid.style.display = 'grid';
    allTiles.forEach(t => vgrid.appendChild(t));
    fixGrid();
    return;
  }

  // Modo spotlight
  videoArea.classList.add('spotlight-mode');
  mainWrap.style.display = 'flex';
  strip.style.display = 'flex';
  vgrid.style.display = 'none';

  const spotTile = document.getElementById('tile-' + spotlightId);
  if (spotTile) {
    mainWrap.appendChild(spotTile);
    spotTile.style.aspectRatio = 'unset';
    spotTile.style.width  = '100%';
    spotTile.style.height = '100%';
    // Si el tile está compartiendo pantalla → mostrar pantalla completa sin recorte
    const isScreenSharing = spotTile.classList.contains('screen-sharing') || spotTile.querySelector('.screen-badge');
    const spotVideo = spotTile.querySelector('video');
    if (spotVideo) {
      spotVideo.style.objectFit = isScreenSharing ? 'contain' : 'cover';
      spotVideo.style.background = isScreenSharing ? '#000' : '';
    }
  }

  // Resto van al strip
  // Limpiar strip (excepto el label)
  const stripLabel = document.getElementById('strip-label');
  while (strip.lastChild && strip.lastChild !== stripLabel) strip.removeChild(strip.lastChild);

  allTiles.forEach(t => {
    if (t.id !== 'tile-' + spotlightId) {
      t.style.aspectRatio = '';
      t.style.width = '';
      t.style.height = '';
      strip.appendChild(t);
    }
  });
}

// Auto-spotlight al creador cuando entra → lo pone grande por defecto
function autoSpotlightHost() {
  if (IS_CREATOR) {
    // El creador entra en grande automáticamente cuando hay más de 1 persona
    const allTiles = document.querySelectorAll('.vtile');
    if (allTiles.length > 1 && !spotlightId) {
      setSpotlight('yo');
    }
  } else {
    // Invitado: poner al host en grande si existe
    const hostTile = document.querySelector('.vtile.host-tile');
    if (hostTile && !spotlightId) {
      setSpotlight(hostTile.dataset.id);
    }
  }
}

function fixGrid() {
  const g = document.getElementById('vgrid');
  const tiles = Array.from(g.querySelectorAll('.vtile'));
  const n = tiles.length;
  g.className = '';
  g.style.overflowY = '';
  g.style.padding = '8px';

  // ── Layout tipo Google Meet: maximizar uso del espacio disponible ──
  const area = g.parentElement || document.getElementById('video-area');
  const W = area.clientWidth  || window.innerWidth;
  const H = area.clientHeight || window.innerHeight - 140;

  let bestCols = 1, bestRows = 1, bestScale = 0;
  for (let c = 1; c <= n; c++) {
    const r = Math.ceil(n / c);
    const tileW = (W - 8 * (c + 1)) / c;
    const tileH = (H - 8 * (r + 1)) / r;
    const scale = Math.min(tileW, tileH * (16/9));
    if (scale > bestScale) { bestScale = scale; bestCols = c; bestRows = r; }
  }

  // ── Aplicar al grid ──
  g.style.gridTemplateColumns = `repeat(${bestCols}, 1fr)`;
  g.style.gridTemplateRows    = `repeat(${bestRows}, 1fr)`;
  g.style.alignContent  = 'center';
  g.style.justifyContent = 'center';

  // ── Tiles: llenan completamente su celda ──
  tiles.forEach(t => {
    t.style.aspectRatio = 'unset';
    t.style.width    = '100%';
    t.style.height   = '100%';
    t.style.minHeight = '0';
    t.style.minWidth  = '0';
    const v = t.querySelector('video');
    if (v) {
      v.style.width     = '100%';
      v.style.height    = '100%';
      v.style.objectFit = 'cover';
    }
    const ph = t.querySelector('.vph');
    if (ph) { ph.style.position = 'absolute'; ph.style.inset = '0'; }
  });

  // Auto-spotlight: host en grande cuando llega el 2do participante
  if (n >= 2 && !spotlightId) setTimeout(autoSpotlightHost, 300);
}

