<!-- Toast general -->
<div id="toast"></div>

<script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
  <script>
  window.ROOM_ID    = "<%- roomId %>";
  window.IS_HOST    = "<%= typeof user !== 'undefined' && user ? 'true' : 'false' %>" === "true";
  window.USER_NAME  = "<%- typeof user !== 'undefined' && user ? user.name.replace(/\\/g,'\\\\').replace(/"/g,'\\"') : 'Invitado' %>";
  window.USER_PHOTO = "<%= typeof user !== 'undefined' && user && user.photo ? user.photo : '' %>";
  window.APP_URL    = "<%= typeof APP_URL !== 'undefined' ? APP_URL : '' %>";
  
  // ✅ Verificar si es host por URL parameter
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('host') === '1') {
    window.IS_HOST = true;
  }
</script>
<script>
// ══════════════════════════════════════
//  LOBBY
// ══════════════════════════════════════
let lobbyStream = null, lobbyMicOn = true, lobbyCamOn = true;
// ✅ Forzar URL de producción con fallback
const roomLink = window.APP_URL 
  ? window.APP_URL + '/sala/' + window.ROOM_ID 
  : 'https://meet-ifd.onrender.com/sala/' + window.ROOM_ID;
document.getElementById('lobby-link').value = roomLink;

(async () => {
  try {
    lobbyStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
    document.getElementById('lobby-video').srcObject = lobbyStream;
    document.getElementById('lobby-cam-off').style.display = 'none';
  } catch(e) {
    document.getElementById('lobby-cam-off').style.display = 'flex';
  }
})();

function lobbyToggleMic() {
  lobbyMicOn = !lobbyMicOn;
  if (lobbyStream) lobbyStream.getAudioTracks().forEach(t => t.enabled = lobbyMicOn);
  document.getElementById('lbtn-mic').classList.toggle('off', !lobbyMicOn);
  document.getElementById('licon-mic').textContent = lobbyMicOn ? 'mic' : 'mic_off';
}

function lobbyToggleCam() {
  lobbyCamOn = !lobbyCamOn;
  if (lobbyStream) lobbyStream.getVideoTracks().forEach(t => t.enabled = lobbyCamOn);
  document.getElementById('lbtn-cam').classList.toggle('off', !lobbyCamOn);
  document.getElementById('licon-cam').textContent = lobbyCamOn ? 'videocam' : 'videocam_off';
  document.getElementById('lobby-cam-off').style.display = lobbyCamOn ? 'none' : 'flex';
}

function lobbyCopiarLink() {
  navigator.clipboard.writeText(roomLink).then(() => {
    const t = document.getElementById('lobby-toast');
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2500);
  });
}

function entrarSala() {
  if (lobbyStream) { 
    lobbyStream.getTracks().forEach(t => t.stop()); 
    lobbyStream = null; 
  }
  
  document.getElementById('lobby').style.display = 'none';
  document.getElementById('app').style.display = 'flex';
  
  // ✅ Si es HOST → entra directo
  if (window.IS_HOST) {
    iniciarSala();
  } 
  // ❌ Si es INVITADO → muestra espera y envía solicitud
  else {
    document.getElementById('lobby-cam-off').style.display = 'none';
    document.getElementById('screen-waiting').style.display = 'flex';
    document.getElementById('screen-room').style.display = 'none';
    document.getElementById('waiting-message').textContent = 'Esperando que el anfitrión te admita...';
    
    // Iniciar sala pero esperar aprobación
    iniciarSala();
  }
}

async function iniciarMedia() {
  try {
    miStream = await navigator.mediaDevices.getUserMedia({
      video: { width: {ideal:1280}, height: {ideal:720} },
      audio: { echoCancellation: true, noiseSuppression: true }
    });
    state.micOn = lobbyMicOn;
    state.camOn = lobbyCamOn;
    miStream.getAudioTracks().forEach(t => t.enabled = state.micOn);
    miStream.getVideoTracks().forEach(t => t.enabled = state.camOn);
    if (!state.micOn) { document.getElementById('btn-mic').classList.add('muted'); document.getElementById('icon-mic').textContent = 'mic_off'; }
    if (!state.camOn) { document.getElementById('btn-cam').classList.add('muted'); document.getElementById('icon-cam').textContent = 'videocam_off'; }
  } catch(err) { console.warn('Sin cámara/mic:', err); }
  if (miStream) agregarVideo(miStream, 'yo', 'Tú (' + window.USER_NAME + ')', true);
}

function iniciarPeerJS() {
  miPeer = new Peer(undefined, {
    path: '/peerjs', host: location.hostname,
    port: location.port || (location.protocol === 'https:' ? 443 : 80)
  });
  miPeer.on('open', id => {
    socket.emit('join-room', window.ROOM_ID, id, window.USER_NAME, window.IS_HOST, '', window.USER_PHOTO);
  });
  miPeer.on('call', call => {
    if (miStream) call.answer(miStream);
    call.on('stream', s => {
      const p = participantes[call.peer];
      agregarVideo(s, call.peer, p?.nombre || 'Participante', false);
    });
    peers[call.peer] = call;
  });
  miPeer.on('error', err => console.warn('PeerJS error:', err));
}

// ══ EVENTOS SOCKET ══
socket.on('user-connected', (peerId, nombre) => {
  participantes[peerId] = { nombre, micOn: true, camOn: true, handOn: false };
  if (miStream) {
    setTimeout(() => {
      const call = miPeer.call(peerId, miStream);
      if (call) {
        call.on('stream', s => agregarVideo(s, peerId, nombre, false));
        peers[peerId] = call;
      }
    }, 600);
  }
  addSysMsg(nombre + ' se unió');
  renderParticipantes();
  actualizarContador();
});

socket.on('user-disconnected', peerId => {
  if (peers[peerId]) { peers[peerId].close(); delete peers[peerId]; }
  document.getElementById('tile-' + peerId)?.remove();
  const nombre = participantes[peerId]?.nombre || 'Alguien';
  delete participantes[peerId];
  addSysMsg(nombre + ' salió');
  renderParticipantes();
  actualizarContador();
  ajustarGrid();
});

// Mic/cam state de otros
socket.on('user-media-state', (peerId, tipo, valor) => {
  if (!participantes[peerId]) return;
  participantes[peerId][tipo + 'On'] = valor;
  // Actualizar icono en tile
  const tile = document.getElementById('tile-' + peerId);
  if (tile) {
    const micMuted = tile.querySelector('.tile-mic-muted');
    if (tipo === 'mic' && micMuted) {
      micMuted.classList.toggle('visible', !valor);
      const labelMic = tile.querySelector('.tile-label .material-icons-round');
      if (labelMic) { labelMic.textContent = valor ? 'mic' : 'mic_off'; labelMic.className = 'material-icons-round' + (valor ? '' : ' m'); }
    }
  }
  renderParticipantes();
});

// Mano levantada de otros
socket.on('user-hand', (peerId, raised) => {
  if (!participantes[peerId]) return;
  participantes[peerId].handOn = raised;
  const tile = document.getElementById('tile-' + peerId);
  const handEl = tile?.querySelector('.tile-hand');
  if (handEl) handEl.classList.toggle('visible', raised);
  renderParticipantes();
  if (raised) {
    const badge = document.getElementById('hand-raised-badge');
    const nameEl = document.getElementById('hand-raised-name');
    badge.style.display = 'flex';
    nameEl.textContent = participantes[peerId].nombre + ' levantó la mano';
    showToast('✋ ' + participantes[peerId].nombre + ' levantó la mano');
  } else {
    // Verificar si hay alguien más con la mano
    const alguienMano = Object.values(participantes).some(p => p.handOn);
    if (!alguienMano) document.getElementById('hand-raised-badge').style.display = 'none';
  }
});

// Reacción de otros
socket.on('user-reaction', (peerId, emoji) => {
  mostrarFloatingEmoji(emoji);
  const nombre = peerId === 'yo' ? 'Tú' : (participantes[peerId]?.nombre || 'Alguien');
  addSysMsg(nombre + ' reaccionó ' + emoji);
});

// ══ VIDEO ══
function agregarVideo(stream, id, nombre, esSelf) {
  let tile = document.getElementById('tile-' + id);
  if (tile) { tile.querySelector('video').srcObject = stream; return; }
  tile = document.createElement('div');
  tile.className = 'video-tile' + (esSelf ? ' self' : '');
  tile.id = 'tile-' + id;
  const ini = nombre.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();
  tile.innerHTML = `
    <div class="tile-placeholder" id="ph-${id}"><div class="tile-avatar">${ini}</div></div>
    <video autoplay playsinline ${esSelf ? 'muted' : ''}></video>
    <div class="tile-mic-muted" id="mic-muted-${id}"><span class="material-icons-round">mic_off</span></div>
    <div class="tile-hand" id="hand-${id}"><span class="material-icons-round" style="font-size:16px;color:white">back_hand</span></div>
    <div class="tile-label">
      <span class="material-icons-round">mic</span>
      ${escHtml(nombre)}
    </div>
    <button class="tile-menu-btn" onclick="openCtxMenu(event,'tile','${id}')">
      <span class="material-icons-round">more_horiz</span>
    </button>`;
  const v = tile.querySelector('video');
  v.srcObject = stream;
  v.onloadedmetadata = () => {
    const ph = document.getElementById('ph-' + id);
    if (ph) ph.style.display = 'none';
  };
  document.getElementById('videos-grid').appendChild(tile);
  ajustarGrid();
}

function ajustarGrid() {
  const g = document.getElementById('videos-grid');
  const n = Math.min(g.children.length, 6);
  g.className = 'n' + (n || 1);
}

// ══ TOGGLES ══
function toggleMic() {
  if (!miStream) return;
  state.micOn = !state.micOn;
  miStream.getAudioTracks().forEach(t => t.enabled = state.micOn);
  document.getElementById('btn-mic').classList.toggle('muted', !state.micOn);
  document.getElementById('icon-mic').textContent = state.micOn ? 'mic' : 'mic_off';
  // Actualizar tile propio
  const micMuted = document.querySelector('#tile-yo .tile-mic-muted');
  if (micMuted) micMuted.classList.toggle('visible', !state.micOn);
  const labelMic = document.querySelector('#tile-yo .tile-label .material-icons-round');
  if (labelMic) { labelMic.textContent = state.micOn ? 'mic' : 'mic_off'; labelMic.className = 'material-icons-round' + (state.micOn ? '' : ' m'); }
  // Emitir estado
  socket.emit('media-state', window.ROOM_ID, 'mic', state.micOn);
  renderParticipantes();
}

function toggleCam() {
  if (!miStream) return;
  state.camOn = !state.camOn;
  miStream.getVideoTracks().forEach(t => t.enabled = state.camOn);
  document.getElementById('btn-cam').classList.toggle('muted', !state.camOn);
  document.getElementById('icon-cam').textContent = state.camOn ? 'videocam' : 'videocam_off';
  const ph = document.getElementById('ph-yo');
  if (ph) ph.classList.toggle('visible', !state.camOn);
  socket.emit('media-state', window.ROOM_ID, 'cam', state.camOn);
  renderParticipantes();
}

async function toggleScreen() {
  if (state.screenOn) {
    screenStream?.getTracks().forEach(t => t.stop());
    screenStream = null; state.screenOn = false;
    document.getElementById('btn-screen').classList.remove('screen-on');
    // Restaurar video propio
    if (miStream) {
      const tile = document.getElementById('tile-yo');
      if (tile) tile.querySelector('video').srcObject = miStream;
      // Restaurar tracks en peers
      const vTrack = miStream.getVideoTracks()[0];
      if (vTrack) {
        Object.values(peers).forEach(call => {
          const s = call.peerConnection?.getSenders().find(s => s.track?.kind === 'video');
          if (s) s.replaceTrack(vTrack);
        });
      }
    }
    return;
  }
  try {
    screenStream = await navigator.mediaDevices.getDisplayMedia({ video: true, audio: true });
    state.screenOn = true;
    document.getElementById('btn-screen').classList.add('screen-on');
    const track = screenStream.getVideoTracks()[0];
    Object.values(peers).forEach(call => {
      const s = call.peerConnection?.getSenders().find(s => s.track?.kind === 'video');
      if (s) s.replaceTrack(track);
    });
    const mv = document.querySelector('#tile-yo video');
    if (mv) mv.srcObject = screenStream;
    track.onended = () => toggleScreen();
  } catch(e) { console.log('Pantalla cancelada'); }
}

function toggleMano() {
  state.handOn = !state.handOn;
  document.getElementById('btn-hand').classList.toggle('hand-on', state.handOn);
  document.getElementById('icon-hand').style.color = state.handOn ? 'white' : '';
  // Tile propio
  const handEl = document.getElementById('hand-yo');
  if (handEl) handEl.classList.toggle('visible', state.handOn);
  // Badge header
  const badge = document.getElementById('hand-raised-badge');
  const nameEl = document.getElementById('hand-raised-name');
  if (state.handOn) {
    badge.style.display = 'flex';
    nameEl.textContent = window.USER_NAME;
  } else {
    const alguienMano = Object.values(participantes).some(p => p.handOn);
    if (!alguienMano) badge.style.display = 'none';
  }
  socket.emit('raise-hand', window.ROOM_ID, state.handOn);
}

function bajarMano() {
  if (state.handOn) toggleMano();
}

function toggleCC() {
  state.ccOn = !state.ccOn;
  document.getElementById('btn-cc').classList.toggle('active-blue', state.ccOn);
  showToast(state.ccOn ? 'Subtítulos activados' : 'Subtítulos desactivados');
}

// ══ REACCIONES ══
let reactionsTrayOpen = false;
function toggleReactionsTray() {
  reactionsTrayOpen = !reactionsTrayOpen;
  document.getElementById('reactions-tray').classList.toggle('open', reactionsTrayOpen);
  document.getElementById('btn-reactions').classList.toggle('active-blue', reactionsTrayOpen);
}

function sendReaction(emoji) {
  reactionsTrayOpen = false;
  document.getElementById('reactions-tray').classList.remove('open');
  document.getElementById('btn-reactions').classList.remove('active-blue');
  mostrarFloatingEmoji(emoji);
  socket.emit('send-reaction', window.ROOM_ID, emoji);
}

function mostrarFloatingEmoji(emoji) {
  const el = document.createElement('div');
  el.className = 'float-emoji';
  el.textContent = emoji;
  const leftPct = 15 + Math.random() * 65;
  el.style.cssText = `bottom:90px;left:${leftPct}%;position:fixed;font-size:36px;z-index:9997;pointer-events:none;transition:all 2.5s ease;`;
  document.body.appendChild(el);
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      el.style.transform = 'translateY(-140px) scale(1.4)';
      el.style.opacity = '0';
    });
  });
  setTimeout(() => el.remove(), 2700);
}

// ══ DEJAR SALA ══
function leaveMeeting() {
  if (!confirm('¿Salir de la reunión?')) return;
  Object.values(peers).forEach(c => c.close());
  miStream?.getTracks().forEach(t => t.stop());
  screenStream?.getTracks().forEach(t => t.stop());
  socket.disconnect();
  location.href = '/';
}

// ══ PANEL ══
let panelOpen = false, activeTab = 'people', unreadChat = 0;

function openPanel(tab) {
  const p = document.getElementById('side-panel');
  if (panelOpen && activeTab === tab) {
    p.classList.remove('open'); panelOpen = false;
  } else {
    p.classList.add('open'); panelOpen = true; switchTab(tab);
  }
}

function switchTab(tab) {
  activeTab = tab;
  ['people', 'chat'].forEach(t => {
    document.getElementById('tab-' + t).classList.toggle('on', t === tab);
    document.getElementById('pane-' + t).classList.toggle('on', t === tab);
  });
  if (tab === 'chat') {
    unreadChat = 0;
    document.getElementById('badge-chat').style.display = 'none';
    const m = document.getElementById('chat-msgs');
    m.scrollTop = m.scrollHeight;
  }
}

// ══ PARTICIPANTES ══
function renderParticipantes(filtro) {
  const list = document.getElementById('p-list');
  const todos = [
    { id: 'yo', nombre: window.USER_NAME + ' (Tú)', role: 'Anfitrión de la reunión', micOn: state.micOn, camOn: state.camOn, handOn: state.handOn, foto: window.USER_PHOTO }
  ].concat(Object.entries(participantes).map(([id, p]) => ({ id, ...p })));

  const filtrados = filtro
    ? todos.filter(p => p.nombre.toLowerCase().includes(filtro.toLowerCase()))
    : todos;

  document.getElementById('colab-count').textContent = filtrados.length;
  document.getElementById('people-count-label').textContent = `En la reunión · ${filtrados.length}`;

  list.innerHTML = filtrados.map(p => {
    const ini = p.nombre.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();
    const fotoHtml = p.foto
      ? `<img src="${escAttr(p.foto)}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">`
      : '';
    const handIcon = p.handOn ? `<span class="material-icons-round p-hand-icon" title="Mano levantada">back_hand</span>` : '';
    return `<div class="p-item">
      <div class="p-ava">
        ${fotoHtml}
        <span style="${p.foto ? 'display:none' : ''}">${ini}</span>
      </div>
      <div class="p-info">
        <div class="p-name">${escHtml(p.nombre)}</div>
        ${p.role ? `<div class="p-role">${escHtml(p.role)}</div>` : ''}
      </div>
      <div class="p-icons">
        ${handIcon}
        <span class="material-icons-round ${p.micOn ? '' : 'm'}" title="${p.micOn ? 'Mic activo' : 'Silenciado'}">${p.micOn ? 'mic' : 'mic_off'}</span>
        <span class="material-icons-round" title="${p.camOn ? 'Cámara activa' : 'Cámara off'}">${p.camOn ? 'videocam' : 'videocam_off'}</span>
      </div>
      ${p.id !== 'yo' ? `<button class="p-item-menu" onclick="openCtxMenu(event,'participant','${p.id}')"><span class="material-icons-round">more_vert</span></button>` : ''}
    </div>`;
  }).join('');
}

function filtrarParticipantes(val) {
  renderParticipantes(val || undefined);
}

function actualizarContador() {
  document.getElementById('badge-people').textContent = Object.keys(participantes).length + 1;
}

// ══ MENÚ CONTEXTUAL ══
let ctxTarget = null;
function openCtxMenu(e, tipo, id) {
  e.stopPropagation();
  const menu = document.getElementById('ctx-menu');
  ctxTarget = { tipo, id };
  // Reconfigurar según tipo
  if (tipo === 'participant') {
    menu.innerHTML = `
      <div class="ctx-item" onclick="closeCtxMenu();showToast('Silenciando a ${escHtml(participantes[id]?.nombre||'')}')">
        <span class="material-icons-round">mic_off</span> Silenciar
      </div>
      <div class="ctx-item" onclick="closeCtxMenu();showToast('Participante eliminado')">
        <span class="material-icons-round">person_remove</span> Eliminar de la reunión
      </div>
      <div class="ctx-item" onclick="closeCtxMenu();showToast('Mensaje enviado')">
        <span class="material-icons-round">chat</span> Enviar mensaje privado
      </div>`;
  } else if (tipo === 'tile') {
    menu.innerHTML = `
      <div class="ctx-item" onclick="closeCtxMenu();showToast('Vista fijada')">
        <span class="material-icons-round">push_pin</span> Fijar en pantalla
      </div>
      <div class="ctx-item" onclick="closeCtxMenu();showToast('Vista ampliada')">
        <span class="material-icons-round">zoom_in_map</span> Ampliar vista
      </div>`;
  } else {
    // Menú principal
    menu.innerHTML = `
      <div class="ctx-item disabled">
        <span class="material-icons-round">radio_button_checked</span>
        <div><div>Grabación no disponible</div><div class="ctx-item-label">No tienes permiso para grabar</div></div>
      </div>
      <div class="ctx-sep"></div>
      <div class="ctx-item" onclick="closeCtxMenu();ajustarVista()">
        <span class="material-icons-round">grid_view</span> Ajustar vista
      </div>
      <div class="ctx-item" onclick="closeCtxMenu();pantallaCompleta()">
        <span class="material-icons-round">fullscreen</span> Pantalla completa
      </div>
      <div class="ctx-item" onclick="closeCtxMenu();showToast('Función próximamente')">
        <span class="material-icons-round">picture_in_picture</span> Abrir imagen en imagen
      </div>
      <div class="ctx-item" onclick="closeCtxMenu();showToast('Fondos y efectos próximamente')">
        <span class="material-icons-round">auto_awesome</span> Fondos y efectos
      </div>
      <div class="ctx-sep"></div>
      <div class="ctx-item" onclick="closeCtxMenu();openModal('host')">
        <span class="material-icons-round">admin_panel_settings</span> Controles del anfitrión
      </div>
      <div class="ctx-item" onclick="closeCtxMenu();showToast('Notificación enviada')">
        <span class="material-icons-round">flag</span> Notificar un problema
      </div>
      <div class="ctx-sep"></div>
      <div class="ctx-item" onclick="closeCtxMenu();showToast('Abriendo ajustes...')">
        <span class="material-icons-round">settings</span> Ajustes
      </div>`;
  }
  // Posicionar
  menu.style.display = 'none';
  menu.classList.add('open');
  menu.style.display = 'block';
  const rect = menu.getBoundingClientRect();
  const x = Math.min(e.clientX, window.innerWidth - rect.width - 8);
  const y = Math.min(e.clientY, window.innerHeight - rect.height - 8);
  menu.style.left = x + 'px';
  menu.style.top = y + 'px';
}

function closeCtxMenu() {
  document.getElementById('ctx-menu').classList.remove('open');
  document.getElementById('ctx-menu').style.display = 'none';
}

document.addEventListener('click', () => closeCtxMenu());

// ══ MODALES ══
function openModal(id) {
  closeCtxMenu();
  if (id === 'invite') renderContactos('');
  document.getElementById('modal-' + id).classList.add('open');
}
function closeModal(id) {
  document.getElementById('modal-' + id).classList.remove('open');
}
// Cerrar modal al click en overlay
document.querySelectorAll('.modal-overlay').forEach(el => {
  el.addEventListener('click', function(e) { if (e.target === this) this.classList.remove('open'); });
});

// ══ CONTACTOS (DEMO) ══
const DEMO_CONTACTS = [
  { email: 'iacomputer160@gmail.com', color: '#3c4043' },
  { email: 'talentohumanosanign@gmail.com', color: '#1e8e3e' },
  { email: 'rhpysoluciones@gmail.com', color: '#ea4335' },
  { email: 'Playa1@esurgroup.com.py', color: '#1a73e8' },
  { email: 'carlosraulqui@gmail.com', color: '#f9ab00' },
];
let selectedContacts = new Set();

function renderContactos(filtro) {
  const list = document.getElementById('contacts-list');
  const filtrados = filtro
    ? DEMO_CONTACTS.filter(c => c.email.toLowerCase().includes(filtro.toLowerCase()))
    : DEMO_CONTACTS;
  list.innerHTML = filtrados.map((c, i) => {
    const ini = c.email[0].toUpperCase();
    const checked = selectedContacts.has(c.email);
    return `<div class="contact-item" onclick="toggleContacto('${escAttr(c.email)}',${i})">
      <div class="contact-ava" style="background:${c.color}">${ini}</div>
      <div class="contact-info">
        <div class="contact-name">${escHtml(c.email)}</div>
        <div class="contact-email">${escHtml(c.email)}</div>
      </div>
      <div class="contact-check ${checked ? 'checked' : ''}" id="check-${i}"></div>
    </div>`;
  }).join('');
}

function filtrarContactos(val) { renderContactos(val); }

function toggleContacto(email, idx) {
  if (selectedContacts.has(email)) selectedContacts.delete(email);
  else selectedContacts.add(email);
  const el = document.querySelector(`#contacts-list .contact-item:nth-child(${idx + 1}) .contact-check`);
  if (el) el.classList.toggle('checked', selectedContacts.has(email));
}

function enviarInvitaciones() {
  const count = selectedContacts.size;
  closeModal('invite');
  selectedContacts.clear();
  showToast(count > 0 ? `✅ Invitaciones enviadas a ${count} persona(s)` : '✅ Enlace copiado al portapapeles');
}

// ══ HERRAMIENTAS ══
function toolAction(tool) {
  closeModal('tools');
  showToast('Función "' + tool + '" próximamente disponible');
}

// ══ VISTAS ══
let vistaIdx = 0;
const vistas = ['n1', 'n2', 'n3'];
function ajustarVista() {
  vistaIdx = (vistaIdx + 1) % vistas.length;
  const g = document.getElementById('videos-grid');
  const n = g.children.length;
  g.className = 'n' + Math.max(1, Math.min(n, 6));
  showToast('Vista ajustada');
}

function pantallaCompleta() {
  if (!document.fullscreenElement) document.documentElement.requestFullscreen?.();
  else document.exitFullscreen?.();
}

// ══ CHAT ══
let pendingFiles = [], lastDateShown = '';

function chatKeyDown(e) { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); } }
function autoResize(el) { el.style.height = 'auto'; el.style.height = Math.min(el.scrollHeight, 130) + 'px'; }

function handlePaste(e) {
  const items = e.clipboardData?.items; if (!items) return;
  for (const item of items) {
    if (item.type.startsWith('image/')) { e.preventDefault(); const f = item.getAsFile(); if (f) addPendingFile(f); return; }
  }
}

function triggerImagePick() {
  const inp = document.createElement('input'); inp.type = 'file'; inp.accept = 'image/*'; inp.multiple = true;
  inp.onchange = () => handleFileSelect(inp.files); inp.click();
}

function handleFileSelect(files) { for (const f of files) addPendingFile(f); document.getElementById('file-input').value = ''; }
function addPendingFile(f) { pendingFiles.push(f); renderAttachPreview(); }
function cancelAttach() { pendingFiles = []; renderAttachPreview(); }

function renderAttachPreview() {
  const box = document.getElementById('attach-preview'), inner = document.getElementById('attach-preview-inner');
  if (!pendingFiles.length) { box.style.display = 'none'; inner.innerHTML = ''; return; }
  box.style.display = 'flex'; inner.innerHTML = '';
  pendingFiles.forEach(f => {
    const w = document.createElement('div');
    if (f.type.startsWith('image/')) {
      w.className = 'preview-thumb'; const img = document.createElement('img'); img.src = URL.createObjectURL(f); w.appendChild(img);
    } else {
      w.className = 'preview-file-info';
      w.innerHTML = `<span class="material-icons-round">${fileIcon(f.name)}</span><span class="preview-filename">${escHtml(f.name)}</span>`;
    }
    inner.appendChild(w);
  });
}

async function sendMessage() {
  const input = document.getElementById('chat-input'), texto = input.value.trim();
  if (pendingFiles.length > 0) { for (const f of pendingFiles) await uploadAndSend(f); pendingFiles = []; renderAttachPreview(); }
  if (texto) {
    const data = { roomId: window.ROOM_ID, nombre: window.USER_NAME, texto, tipo: 'text' };
    socket.emit('send-message', data);
    renderMensaje({ ...data, propio: true });
    input.value = ''; input.style.height = 'auto';
  }
}

async function uploadAndSend(file) {
  const fd = new FormData(); fd.append('file', file);
  try {
    const res = await fetch('/upload', { method: 'POST', body: fd });
    const json = await res.json(); if (!json.ok) return;
    const data = { roomId: window.ROOM_ID, nombre: window.USER_NAME, tipo: json.isImage ? 'image' : 'file', url: json.url, fileName: json.name, fileSize: formatSize(json.size), texto: '' };
    socket.emit('share-file', data);
    renderMensaje({ ...data, propio: true });
  } catch(err) { console.error(err); }
}

socket.on('receive-message', data => { if (data.nombre !== window.USER_NAME) { renderMensaje({ ...data, propio: false }); bumpUnread(); } });
socket.on('receive-file', data => { if (data.nombre !== window.USER_NAME) { renderMensaje({ ...data, propio: false }); bumpUnread(); } });

function bumpUnread() {
  if (activeTab !== 'chat' || !panelOpen) {
    unreadChat++;
    const b = document.getElementById('badge-chat');
    b.textContent = unreadChat > 9 ? '9+' : unreadChat;
    b.style.display = 'flex';
  }
}

function renderMensaje(data) {
  const c = document.getElementById('chat-msgs'), propio = data.propio === true;
  const now = new Date();
  const hora = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
  const fecha = now.toLocaleDateString('es-PY', { day: 'numeric', month: 'long', year: 'numeric' });
  if (fecha !== lastDateShown) {
    lastDateShown = fecha;
    const sep = document.createElement('div'); sep.className = 'c-date-sep'; sep.textContent = fecha; c.appendChild(sep);
  }
  const wrap = document.createElement('div');
  wrap.className = 'c-msg ' + (propio ? 'own' : 'other');
  let content = ''; const tipo = data.tipo || 'text';
  if (tipo === 'image') {
    const su = escAttr(data.url || ''), sn = escAttr(data.fileName || 'imagen');
    content = `<div class="c-img-wrap" onclick="openLightbox('${su}','${sn}')">
      <img src="${su}" alt="${sn}" loading="lazy">
      <div class="c-img-overlay"><span class="material-icons-round" style="font-size:36px;opacity:.9">zoom_in</span></div>
      <a class="c-img-dl" href="${su}" download="${sn}" onclick="event.stopPropagation()">
        <span class="material-icons-round">download</span></a></div>`;
  } else if (tipo === 'file') {
    const su = escAttr(data.url || ''), sn = escAttr(data.fileName || 'archivo');
    content = `<a class="c-file" href="${su}" download="${sn}" target="_blank">
      <span class="material-icons-round c-file-icon">${fileIcon(data.fileName || '')}</span>
      <div class="c-file-info">
        <span class="c-file-name">${escHtml(data.fileName || 'Archivo')}</span>
        <span class="c-file-size">${escHtml(data.fileSize || '')}</span>
      </div>
      <span class="c-file-dl"><span class="material-icons-round">download</span></span></a>`;
  } else {
    content = `<div class="c-bubble">${escHtml(data.texto)}</div>`;
  }
  wrap.innerHTML = `${!propio ? `<div class="c-name">${escHtml(data.nombre)}</div>` : ''}${content}<div class="c-time">${hora}</div>`;
  c.appendChild(wrap);
  c.scrollTop = c.scrollHeight;
}

function addSysMsg(txt) {
  const c = document.getElementById('chat-msgs');
  const d = document.createElement('div'); d.className = 'c-sys'; d.textContent = txt;
  c.appendChild(d); c.scrollTop = c.scrollHeight;
}

// ══ LIGHTBOX ══
function openLightbox(url, name) {
  document.getElementById('lightbox-img').src = url;
  const dl = document.getElementById('lightbox-dl'); dl.href = url; dl.download = name;
  document.getElementById('lightbox').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function closeLightbox() { document.getElementById('lightbox').style.display = 'none'; document.body.style.overflow = ''; }
document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeLightbox(); closeCtxMenu(); } });

// ══ HELPERS ══
let toastTimer = null;
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2800);
}

function copyLink() {
  navigator.clipboard.writeText(roomLink).then(() => showToast('✅ Enlace copiado'));
}

function iniciarReloj() {
  const u = () => {
    const n = new Date();
    const t = n.toLocaleTimeString('es-PY', { hour: '2-digit', minute: '2-digit' });
    document.getElementById('room-time').textContent = t;
    document.getElementById('ctrl-time').textContent = t;
  };
  u(); setInterval(u, 30000);
}

function escHtml(t) {
  if (!t) return '';
  return t.replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m]));
}
function escAttr(t) { return (t || '').replace(/"/g, '&quot;').replace(/'/g, '&#039;'); }
function formatSize(b) { if (!b) return ''; if (b < 1024) return b + ' B'; if (b < 1048576) return (b / 1024).toFixed(1) + ' KB'; return (b / 1048576).toFixed(1) + ' MB'; }
function fileIcon(name) {
  const ext = (name || '').split('.').pop().toLowerCase();
  const m = { pdf: 'picture_as_pdf', doc: 'description', docx: 'description', xls: 'table_chart', xlsx: 'table_chart', ppt: 'slideshow', pptx: 'slideshow', txt: 'text_snippet', zip: 'folder_zip', rar: 'folder_zip', mp4: 'videocam', mp3: 'audio_file', jpg: 'image', jpeg: 'image', png: 'image', gif: 'image', webp: 'image' };
  return m[ext] || 'insert_drive_file';
}

// Cerrar tray reacciones al click fuera
document.addEventListener('click', e => {
  if (!e.target.closest('#reactions-tray') && !e.target.closest('#btn-reactions')) {
    reactionsTrayOpen = false;
    document.getElementById('reactions-tray').classList.remove('open');
    document.getElementById('btn-reactions').classList.remove('active-blue');
  }
});
</script>
