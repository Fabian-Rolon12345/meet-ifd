// ══════════════════════════════════════════════
//  SALA
// ══════════════════════════════════════════════
const socket = io();
let myPeer = null, myStream = null, screenStream = null;
const peers = {}, parts = {};
const st = { mic:true, cam:true, screen:false };

async function initRoom() {
  document.getElementById('room-code').textContent = ROOM_ID;
  startClock();
  await initMedia();
  initPeer();
  renderParts();
}

async function initMedia() {
  try {
    myStream = await navigator.mediaDevices.getUserMedia({
      video:{ width:{ideal:1280}, height:{ideal:720} },
      audio:{ echoCancellation:true, noiseSuppression:true }
    });
    st.mic = lMicOn; st.cam = lCamOn;
    myStream.getAudioTracks().forEach(t => t.enabled = st.mic);
    myStream.getVideoTracks().forEach(t => t.enabled = st.cam);
    if (!st.mic) { document.getElementById('btn-mic').classList.add('muted'); document.getElementById('ic-mic').textContent='mic_off'; }
    if (!st.cam) { document.getElementById('btn-cam').classList.add('muted'); document.getElementById('ic-cam').textContent='videocam_off'; }
  } catch(e) { console.warn('Sin cam/mic:', e); }
  if (myStream) addTile(myStream, 'yo', 'Tú (' + myName + ')', true);
}

function initPeer() {
  myPeer = new Peer(undefined, {
    path:'/peerjs', host: location.hostname,
    port: location.port || (location.protocol === 'https:' ? 443 : 80)
  });
  myPeer.on('open', id => {
    socket.emit('join-room', ROOM_ID, id, myName, IS_HOST, myEmail, myPhoto);
  });
  myPeer.on('call', call => {
    if (myStream) call.answer(myStream);
    call.on('stream', s => { const p = parts[call.peer]; addTile(s, call.peer, p?.name || 'Participante', false); });
    peers[call.peer] = call;
  });
}

// ══════════════════════════════════════════════
//  SOCKET EVENTS
// ══════════════════════════════════════════════
socket.on('joined-room', () => {});

socket.on('user-connected', (peerId, nombre, email, foto) => {
  parts[peerId] = { name: nombre, email: email||'', photo: foto||'', mic:true, cam:true };
  if (myStream) {
    setTimeout(() => {
      const call = myPeer.call(peerId, myStream);
      if (call) { call.on('stream', s => addTile(s, peerId, nombre, false)); peers[peerId] = call; }
    }, 600);
  }
  sysMsg(nombre + ' se unió'); renderParts(); updCount();
});

socket.on('user-disconnected', (peerId, nombre) => {
  if (peers[peerId]) { peers[peerId].close(); delete peers[peerId]; }
  document.getElementById('tile-'+peerId)?.remove();
  const n = nombre || parts[peerId]?.name || 'Alguien'; delete parts[peerId];
  sysMsg(n + ' salió'); renderParts(); updCount(); fixGrid();
});

// ✅ SALA DE ESPERA
socket.on('waiting-approval', ({ message, position }) => {
  document.getElementById('waiting-modal').classList.add('show');
  document.getElementById('wmsg').textContent = (message||'Esperando...') + (position > 1 ? ` (Posición: ${position})` : '');
});

socket.on('admitted', () => {
  document.getElementById('waiting-modal').classList.remove('show');
