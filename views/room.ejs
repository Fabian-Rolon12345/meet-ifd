function autoResize(el){ el.style.height='auto'; el.style.height=Math.min(el.scrollHeight,130)+'px'; }
function handlePaste(e){ const it=e.clipboardData?.items; if(!it) return; for(const i of it){ if(i.type.startsWith('image/')){e.preventDefault();const f=i.getAsFile();if(f)addFile(f);return;} } }
function triggerImgPick(){ const i=document.createElement('input');i.type='file';i.accept='image/*';i.multiple=true;i.onchange=()=>handleFileSelect(i.files);i.click(); }
function handleFileSelect(files){ for(const f of files) addFile(f); document.getElementById('file-input').value=''; }
function addFile(f){ pendFiles.push(f); renderPrev(); }
function cancelAttach(){ pendFiles=[]; renderPrev(); }
function renderPrev(){
  const b=document.getElementById('attach-prev'),i=document.getElementById('attach-prev-inner');
  if(!pendFiles.length){b.style.display='none';i.innerHTML='';return;}
  b.style.display='flex';i.innerHTML='';
  pendFiles.forEach(f=>{
    const w=document.createElement('div');
    if(f.type.startsWith('image/')){ w.className='pthumb'; const img=document.createElement('img'); img.src=URL.createObjectURL(f); w.appendChild(img); }
    else{ w.className='pfile-info'; w.innerHTML=`<span class="material-icons-round">${fIcon(f.name)}</span><span class="pfile-name">${escH(f.name)}</span>`; }
    i.appendChild(w);
  });
}
async function sendMsg(){
  const inp=document.getElementById('chat-input'), txt=inp.value.trim();
  if(pendFiles.length){ for(const f of pendFiles) await uploadSend(f); pendFiles=[]; renderPrev(); }
  if(txt){
    const d={roomId:ROOM_ID,nombre:myName,texto:txt,tipo:'text'};
    socket.emit('send-message',d); renderMsg({...d,own:true});
    inp.value=''; inp.style.height='auto';
  }
}
async function uploadSend(file){
  const fd=new FormData(); fd.append('file',file);
  try{
    const res=await fetch('/upload',{method:'POST',body:fd}); const j=await res.json(); if(!j.ok) return;
    const d={roomId:ROOM_ID,nombre:myName,tipo:j.isImage?'image':'file',url:j.url,fileName:j.name,fileSize:fmtSize(j.size),texto:''};
    socket.emit('share-file',d); renderMsg({...d,own:true});
  }catch(e){ console.error(e); }
}
function bumpUnread(){
  if(activeTab!=='chat'||!panelOpen){ unread++;
    const b=document.getElementById('bc'); b.textContent=unread>9?'9+':unread; b.style.display='flex'; }
}
function renderMsg(data){
  const c=document.getElementById('chat-msgs'), own=data.own===true;
  const now=new Date();
  const hora=`${now.getHours().toString().padStart(2,'0')}:${now.getMinutes().toString().padStart(2,'0')}`;
  const fecha=now.toLocaleDateString('es-PY',{day:'numeric',month:'long',year:'numeric'});
  if(fecha!==lastDate){ lastDate=fecha; const s=document.createElement('div'); s.className='cdatesep'; s.textContent=fecha; c.appendChild(s); }
  const w=document.createElement('div'); w.className='cmsg '+(own?'own':'other');
  let content=''; const tipo=data.tipo||'text';
  if(tipo==='image'){
    const su=escA(data.url||''),sn=escA(data.fileName||'imagen');
    content=`<div class="cimgw" onclick="openLB('${su}','${sn}')"><img src="${su}" alt="${sn}" loading="lazy">
      <div class="cimgo"><span class="material-icons-round" style="font-size:36px;opacity:.9">zoom_in</span></div>
      <a class="cimgdl" href="${su}" download="${sn}" onclick="event.stopPropagation()"><span class="material-icons-round">download</span></a></div>`;
  } else if(tipo==='file'){
    const su=escA(data.url||''),sn=escA(data.fileName||'archivo');
    content=`<a class="cfile" href="${su}" download="${sn}" target="_blank">
      <span class="material-icons-round cfile-icon">${fIcon(data.fileName||'')}</span>
      <div class="cfile-info"><span class="cfile-name">${escH(data.fileName||'Archivo')}</span><span class="cfile-size">${escH(data.fileSize||'')}</span></div>
      <span class="cfile-dl"><span class="material-icons-round">download</span></span></a>`;
  } else {
    content=`<div class="cbub">${escH(data.texto)}</div>`;
  }
  w.innerHTML=`${!own?`<div class="cname">${escH(data.nombre)}</div>`:''}${content}<div class="ctime">${hora}</div>`;
  c.appendChild(w); c.scrollTop=c.scrollHeight;
}
function sysMsg(txt){ const c=document.getElementById('chat-msgs'); const d=document.createElement('div'); d.className='csys'; d.textContent=txt; c.appendChild(d); c.scrollTop=c.scrollHeight; }

// ══════════════════════════════════════════════
//  OTROS
// ══════════════════════════════════════════════
function leaveMeeting(){
  if(isRec) stopRec();
  if(!confirm('¿Salir de la reunión?')) return;
  Object.values(peers).forEach(c=>c.close());
  myStream?.getTracks().forEach(t=>t.stop());
  screenStream?.getTracks().forEach(t=>t.stop());
  socket.disconnect(); location.href='/';
}
function openLB(url,name){ document.getElementById('lbx-img').src=url; const dl=document.getElementById('lbx-dl'); dl.href=url; dl.download=name; document.getElementById('lightbox').style.display='flex'; document.body.style.overflow='hidden'; }
function closeLB(){ document.getElementById('lightbox').style.display='none'; document.body.style.overflow=''; }
document.addEventListener('keydown', e=>{ if(e.key==='Escape') closeLB(); });
function copyLink(){ navigator.clipboard.writeText((APP_URL_JS||location.origin)+'/sala/'+ROOM_ID).then(()=>toast('✅ Enlace copiado','#1e8e3e')); }
function startClock(){ const u=()=>{ const n=new Date(); document.getElementById('room-time').textContent=n.toLocaleTimeString('es-PY',{hour:'2-digit',minute:'2-digit'}); }; u(); setInterval(u,30000); }

// ══════════════════════════════════════════════
//  TOAST
// ══════════════════════════════════════════════
let toastT;
function toast(msg, color='#323232', dur=4000){
  const t=document.getElementById('toast'); t.textContent=msg; t.style.background=color; t.style.color='#fff';
  t.classList.add('show'); clearTimeout(toastT);
  if(dur>0) toastT=setTimeout(()=>t.classList.remove('show'),dur);
}

// ══════════════════════════════════════════════
//  HELPERS
// ══════════════════════════════════════════════
function escH(t){ if(!t)return''; return t.replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m])); }
function escA(t){ return(t||'').replace(/"/g,'&quot;').replace(/'/g,'&#039;'); }
function fmtSize(b){ if(!b)return''; if(b<1024)return b+' B'; if(b<1048576)return(b/1024).toFixed(1)+' KB'; return(b/1048576).toFixed(1)+' MB'; }
function fIcon(name){ const ext=(name||'').split('.').pop().toLowerCase(); const m={pdf:'picture_as_pdf',doc:'description',docx:'description',xls:'table_chart',xlsx:'table_chart',ppt:'slideshow',pptx:'slideshow',txt:'text_snippet',zip:'folder_zip',rar:'folder_zip',mp4:'videocam',mp3:'audio_file',jpg:'image',jpeg:'image',png:'image',gif:'image',webp:'image'}; return m[ext]||'insert_drive_file'; }


// ══════════════════════════════════════════════
//  ✋ LEVANTAR LA MANO
// ══════════════════════════════════════════════
let handRaised = false;
function toggleHand() {
  handRaised = !handRaised;
  const btn = document.getElementById('btn-hand');
  btn.classList.toggle('btn-hand-active', handRaised);
  btn.title = handRaised ? 'Bajar mano' : 'Levantar mano';
  socket.emit('raise-hand', { roomId: ROOM_ID, userId: 'yo', userName: myName, raised: handRaised });
  if (handRaised) toast('✋ Levantaste la mano', '#f9ab00');
  else toast('Bajaste la mano', '#9aa0a6');
}

socket.on('user-raised-hand', ({ userName, raised }) => {
  if (raised) {
    // Mostrar notificación
    const n = document.createElement('div');
    n.className = 'hand-notif-item';
    n.innerHTML = '✋ ' + escH(userName) + ' levantó la mano';
    document.getElementById('hands-notif').appendChild(n);
    setTimeout(() => n.remove(), 5000);
    playSound('join');
  }
});

// ══════════════════════════════════════════════
//  🖥️ VISTA PRESENTADOR (usa el sistema spotlight)
// ══════════════════════════════════════════════
let presenterMode = false;
function togglePresenterMode() {
  presenterMode = !presenterMode;
  const btn = document.getElementById('btn-presenter');
  if (presenterMode) {
    btn.classList.add('screen-on');
    // Activar spotlight en el tile del host (yo)
    const myTile = document.getElementById('tile-yo');
    if (myTile) {
      spotlightId = 'yo';
      applySpotlightLayout();
    }
    toast('Vista presentador activada — clic en cualquier video para agrandarlo', '#1a73e8', 4000);
  } else {
    btn.classList.remove('screen-on');
    clearSpotlight();
    toast('Vista normal', '#9aa0a6');
  }
}

// ══════════════════════════════════════════════
//  📝 SUBTÍTULOS (Web Speech API)
// ══════════════════════════════════════════════
let captionsOn = false, recognition = null;
function toggleCaptions() {
  const btn = document.getElementById('btn-captions');
  const bar = document.getElementById('captions-bar');
  if (!('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) {
    toast('❌ Tu navegador no soporta subtítulos', '#ea4335'); return;
  }
  captionsOn = !captionsOn;
  btn.classList.toggle('screen-on', captionsOn);
  if (captionsOn) {
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    recognition = new SR();
    recognition.continuous = true;
    recognition.interimResults = true;
    recognition.lang = 'es-PY';
    recognition.onresult = (e) => {
      let txt = '';
      for (let i = e.resultIndex; i < e.results.length; i++) {
        txt += e.results[i][0].transcript;
      }
      bar.textContent = myName + ': ' + txt;
      bar.classList.add('show');
      clearTimeout(bar._t);
      bar._t = setTimeout(() => bar.classList.remove('show'), 3000);
    };
    recognition.onerror = () => {};
    recognition.start();
    toast('🎤 Subtítulos activados', '#1e8e3e');
  } else {
    recognition?.stop();
    bar.classList.remove('show');
    toast('Subtítulos desactivados', '#9aa0a6');
  }
}

// ══════════════════════════════════════════════
//  📊 ENCUESTAS
// ══════════════════════════════════════════════
let currentPoll = null, myVote = null;

function addPollOption() {
  const c = document.getElementById('poll-opts-inputs');
  const n = c.children.length + 1;
  const inp = document.createElement('input');
  inp.className = 'poll-opt-input';
  inp.placeholder = 'Opción ' + n;
  inp.style.cssText = 'width:100%;padding:10px;border:1px solid #ddd;border-radius:8px;font-size:14px;margin-bottom:8px';
  c.appendChild(inp);
}

function submitPoll() {
  const q = document.getElementById('poll-q').value.trim();
  if (!q) { toast('Escribí la pregunta', '#ea4335'); return; }
  const opts = Array.from(document.querySelectorAll('.poll-opt-input')).map(i => i.value.trim()).filter(Boolean);
  if (opts.length < 2) { toast('Necesitás al menos 2 opciones', '#ea4335'); return; }
  socket.emit('create-poll', { roomId: ROOM_ID, question: q, options: opts });
  document.getElementById('create-poll-modal').style.display = 'none';
  document.getElementById('poll-q').value = '';
}

socket.on('poll-created', (poll) => {
  currentPoll = poll; myVote = null;
  const modal = document.getElementById('poll-modal');
  document.getElementById('poll-question').textContent = poll.question;
  const opts = document.getElementById('poll-options');
  opts.innerHTML = '';
  poll.options.forEach((opt, i) => {
    const d = document.createElement('div');
    d.className = 'poll-opt';
    d.id = 'popt-' + i;
    d.innerHTML = '<span style="flex:1;font-size:14px">' + escH(opt) + '</span><div class="poll-bar"><div class="poll-bar-fill" id="pbar-'+i+'" style="width:0%"></div></div>';
    d.onclick = () => votePoll(i, opt);
    opts.appendChild(d);
  });
  modal.classList.add('show');
  playSound('join');
  toast('📊 Nueva encuesta disponible', '#1a73e8');
});

function votePoll(idx, opt) {
  if (myVote !== null) return;
  myVote = idx;
  document.getElementById('popt-' + idx)?.classList.add('voted');
  socket.emit('vote-poll', { roomId: ROOM_ID, pollId: currentPoll.pollId, optionIndex: idx, voterName: myName });
}

socket.on('poll-vote', ({ optionIndex, totalVotes, percentages }) => {
  if (!percentages) return;
  percentages.forEach((pct, i) => {
    const bar = document.getElementById('pbar-' + i);
    if (bar) bar.style.width = pct + '%';
  });
});

function closePoll() {
  document.getElementById('poll-modal').classList.remove('show');
  currentPoll = null; myVote = null;
}

// ══════════════════════════════════════════════
//  🚪 BREAKOUT ROOMS
// ══════════════════════════════════════════════
const breakoutRooms = {};

function createBreakout() {
  const name = document.getElementById('br-name').value.trim();
  if (!name) return;
  const brId = 'br-' + Date.now();
  breakoutRooms[brId] = { name, id: brId, members: [] };
  socket.emit('create-breakout', { roomId: ROOM_ID, breakoutId: brId, name });
  document.getElementById('br-name').value = '';
}

socket.on('breakout-created', ({ breakoutId, name }) => {
  breakoutRooms[breakoutId] = { name, id: breakoutId };
  renderBreakouts();
  toast('🚪 Nueva sala de grupo: ' + name, '#1a73e8');
});

function joinBreakout(brId) {
  socket.emit('join-breakout', { roomId: ROOM_ID, breakoutId: brId, userName: myName });
  toast('Entraste a la sala: ' + breakoutRooms[brId]?.name, '#1e8e3e');
  document.getElementById('breakout-modal').classList.remove('show');
}

socket.on('breakout-user-joined', ({ userName }) => {
  toast(userName + ' entró a una sala de grupo', '#9aa0a6');
});

function renderBreakouts() {
  const list = document.getElementById('breakout-list');
  list.innerHTML = '';
  Object.values(breakoutRooms).forEach(br => {
    const d = document.createElement('div');
    d.className = 'breakout-room-item';
    d.innerHTML = '<span style="font-weight:600">' + escH(br.name) + '</span><button class="btn-join-br" onclick="joinBreakout(\'' + br.id + '\')">Entrar</button>';
    list.appendChild(d);
  });
  if (!Object.keys(breakoutRooms).length) {
    list.innerHTML = '<p style="color:#888;text-align:center;padding:16px">No hay salas de grupo todavía</p>';
  }
}

// ══════════════════════════════════════════════
//  🎥 MIROTALK — IFRAME INTEGRADO EN TU SISTEMA
// ══════════════════════════════════════════════

const MIROTALK_URL  = '<%- MIROTALK_URL || "https://mirotalk-ifd.onrender.com" %>';
const MIROTALK_ROOM = 'IFD-' + ROOM_ID.replace(/-/g,'').slice(0,12).toUpperCase();

function getMiroName() {
  return encodeURIComponent(myName || (SRV_USER && SRV_USER.name) || 'Participante');
}

function buildMiroUrl() {
  return MIROTALK_URL + '/join?room=' + MIROTALK_ROOM
    + '&name=' + getMiroName()
    + '&audio=1&video=1&notify=0';
}

// Abre MiroTalk como iframe dentro de tu sistema
function abrirMiroTalk() {
  const url = buildMiroUrl();
  const overlay = document.getElementById('miro-overlay');
  const iframe  = document.getElementById('miro-iframe');
  iframe.src = url;
  overlay.classList.add('show');
  document.body.style.overflow = 'hidden';
}

// Volver al sistema (el iframe sigue corriendo, no corta la llamada)
function volverAlSistema() {
  document.getElementById('miro-overlay').classList.remove('show');
  document.body.style.overflow = '';
  if (document.getElementById('lobby') &&
      document.getElementById('lobby').style.display !== 'none') {
    enterRoom();
  }
}

// Finalizar llamada completamente
function cerrarMiroTalk() {
  document.getElementById('miro-iframe').src = '';
  document.getElementById('miro-overlay').classList.remove('show');
  document.body.style.overflow = '';
}

// Aliases para botones existentes en el HTML
function launchMiroTalk()  { abrirMiroTalk(); }
function openMiroTalk()    { abrirMiroTalk(); }
function closeMiroModal()  { const m=document.getElementById('mirotalk-modal'); if(m) m.classList.remove('show'); }
function closeMiroFrame()  { cerrarMiroTalk(); }

function notifyMiroTalkOpened() {
  if (typeof socket !== 'undefined' && ROOM_ID) {
    try {
      socket.emit('send-message', {
        roomId: ROOM_ID,
        nombre: myName || 'Alguien',
        texto: '🎥 ' + (myName || 'Alguien') + ' inició la videollamada',
        tipo: 'text'
      });
    } catch(e) {}
  }
}

// Resize grid al cambiar tamaño
window.addEventListener('resize', () => {
  if (!spotlightId) fixGrid(); else applySpotlightLayout();
});
if (typeof ResizeObserver !== 'undefined') {
  const gridResizeObs = new ResizeObserver(() => {
    setTimeout(() => { if (!spotlightId) fixGrid(); else applySpotlightLayout(); }, 50);
  });
  const va = document.getElementById('video-area');
  if (va) gridResizeObs.observe(va);
} 
</script>
