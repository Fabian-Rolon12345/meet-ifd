async function toggleScreen() {
  if (st.screen) {
    // Detener todos los tracks de la pantalla
    if (screenStream) {
      screenStream.getTracks().forEach(t => t.stop());
      screenStream = null;
    }
    st.screen = false;
    document.getElementById('btn-screen').classList.remove('screen-on');
    // Volver a la cámara normal
    if (myStream) {
      const camTrack = myStream.getVideoTracks()[0];
      if (camTrack) {
        // Reemplazar track en todos los peers conectados
        Object.values(peers).forEach(call => {
          try {
            const sender = call.peerConnection.getSenders().find(s => s.track?.kind === 'video');
            if (sender) sender.replaceTrack(camTrack);
          } catch(e) {}
        });
      }
      // Volver a mostrar cámara en mi tile
      const myTile = document.getElementById('tile-yo');
      if (myTile) myTile.querySelector('video').srcObject = myStream;
    }
    // Quitar badge de pantalla
    document.querySelector('#tile-yo .screen-badge')?.remove();
    // Notificar a todos los participantes que dejé de compartir
    socket.emit('screen-share-stop', { roomId: ROOM_ID, userId: 'yo' });
    socket.emit('screen-share', { roomId: ROOM_ID, active: false });
    // Limpiar spotlight
    if (spotlightId === 'yo') clearSpotlight();
    toast('🖥️ Dejaste de compartir pantalla', '#5f6368');
    return;
  }
  try {
    // Solicitar pantalla completa con máxima calidad
    screenStream = await navigator.mediaDevices.getDisplayMedia({
      video: {
        cursor: 'always',
        displaySurface: 'monitor',
        width:  { ideal: 1920, max: 1920 },
        height: { ideal: 1080, max: 1080 },
        frameRate: { ideal: 30 }
      },
      audio: true
    });
    st.screen = true;
    document.getElementById('btn-screen').classList.add('screen-on');
    const track = screenStream.getVideoTracks()[0];

    // Reemplazar track de video en todos los peers → todos ven la pantalla completa
    Object.values(peers).forEach(call => {
      try {
        const sender = call.peerConnection.getSenders().find(s => s.track?.kind === 'video');
        if (sender) sender.replaceTrack(track);
      } catch(e) {}
    });

    // Mostrar pantalla en mi propio tile con object-fit:contain para ver TODO
    const myVideo = document.querySelector('#tile-yo video');
    if (myVideo) {
      myVideo.srcObject = screenStream;
      myVideo.style.objectFit = 'contain'; // pantalla completa sin recortar
    }

    // Badge visual
    const tile = document.getElementById('tile-yo');
    if (tile && !tile.querySelector('.screen-badge')) {
      const badge = document.createElement('div');
      badge.className = 'screen-badge';
      badge.innerHTML = '<span class="material-icons-round" style="font-size:13px">present_to_all</span> Compartiendo pantalla';
      tile.appendChild(badge);
    }

    // Auto-spotlight: el que comparte pantalla aparece grande para todos
    setSpotlight('yo');

    // Notificar a todos
    socket.emit('screen-share-start', { roomId: ROOM_ID, userId: 'yo' });
    socket.emit('screen-share', { roomId: ROOM_ID, active: true });

    // Si el usuario detiene con el botón del navegador, también detener acá
    track.onended = () => {
      if (st.screen) toggleScreen();
    };

    toast('🖥️ Compartiendo pantalla - todos te ven en grande', '#00796b');
  } catch(e) {
    if (e.name !== 'NotAllowedError') console.error('getDisplayMedia error:', e);
  }
}

