<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>IFD Meet - Videoconferencias</title>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
  <link rel="stylesheet" href="/css/landing.css">
</head>
<body>
  <div id="maintenance-banner" class="maintenance-banner" style="display:none">
    <span class="material-icons">warning</span>
    <span id="maintenance-msg"></span>
  </div>

  <header class="header">
    <div class="header-start">
      <button class="icon-btn"><span class="material-icons">menu</span></button>
    </div>
    <div class="header-center">
      <div class="brand">
        <div class="brand-logo">
          <img src="/img/logo-ifd.png" alt="IFD" onerror="this.parentElement.innerHTML='<span class=material-icons>school</span>'">
        </div>
        <div class="brand-text"><span class="brand-name">IFD Meet</span></div>
      </div>
    </div>
    <div class="header-end">
      <% if (user) { %>
        <div class="user-menu">
          <div class="user-info">
            <img src="<%= user.photo %>" alt="<%= user.name %>" class="user-photo">
            <span class="user-name"><%= user.name.split(' ')[0] %></span>
          </div>
          <a href="/logout" class="btn-logout"><span class="material-icons" style="font-size:18px">logout</span></a>
        </div>
      <% } else { %>
        <a href="/auth/google" class="google-signin-btn">
          <img src="https://www.google.com/favicon.ico" alt="Google">
          <span>Iniciar sesión</span>
        </a>
      <% } %>
    </div>
  </header>

  <main class="main-content">
    <section class="hero-section">
      <div class="hero-content">
        <h1 class="hero-title">Videoconferencias seguras para el IFD</h1>
        <p class="hero-subtitle">Conectá con tus compañeros y docentes en tiempo real.</p>
        
        <% if (!user) { %>
          <div class="signin-prompt">
            <p>👋 Iniciar sesión para acceder a todas las funciones</p>
            <p style="color:#5f6368;font-size:13px">Ingresá con Google para crear reuniones</p>
          </div>
        <% } %>
        
        <div class="actions-container">
          <div class="new-meeting-wrapper">
            <button class="btn btn-primary btn-large" onclick="<%= user ? 'toggleMeetingDropdown()' : 'showSigninPrompt()' %>">
              <span class="material-icons">video_camera_front</span>
              Nueva reunión
              <span class="material-icons dropdown-arrow">expand_more</span>
            </button>
            <div class="dropdown-menu" id="meeting-dropdown">
              <div class="dropdown-item" onclick="startInstantMeeting()">
                <span class="material-icons">videocam</span>
                <div class="dropdown-text">
                  <span class="dropdown-title">Iniciar reunión instantánea</span>
                  <span class="dropdown-desc">Comenzar una videollamada ahora</span>
                </div>
              </div>
              <div class="dropdown-item" onclick="createMeetingLink()">
                <span class="material-icons">link</span>
                <div class="dropdown-text">
                  <span class="dropdown-title">Crear enlace para más tarde</span>
                  <span class="dropdown-desc">Generar un link para compartir</span>
                </div>
              </div>
            </div>
          </div>
          <div class="join-with-code">
            <input type="text" id="room-code-input" class="input-code" placeholder="Ingresar código o enlace">
            <button class="btn btn-join" id="btn-join" disabled onclick="joinWithCode()">
              <span class="material-icons">login</span>Unirse
            </button>
          </div>
        </div>
      </div>
    </section>
    <section class="ifd-card-section">
      <div class="ifd-card">
        <img src="/img/logo-ifd.png" alt="IFD" class="ifd-card-logo">
        <h3>Instituto de Formación Docente</h3>
        <p>Santa Rosa, Misiones · Paraguay</p>
        <span class="ifd-res">Res. N°43 del 02-07-1997</span>
      </div>
    </section>
  </main>

  <div class="modal-overlay" id="link-modal" style="display:none">
    <div class="modal-card">
      <div class="modal-header"><h3>Tu reunión está lista</h3><button class="modal-close" onclick="closeModal()"><span class="material-icons">close</span></button></div>
      <div class="modal-body">
        <p>Compartí este enlace:</p>
        <div class="link-container">
          <input type="text" id="generated-link" readonly>
          <button class="btn-copy" onclick="copyLink()"><span class="material-icons">content_copy</span>Copiar</button>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeModal()">Cerrar</button>
        <button class="btn btn-primary" onclick="goToMeeting()">Entrar como anfitrión</button>
      </div>
    </div>
  </div>

  <div id="toast-container"></div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    let pendingLink = "";
    var isLoggedIn = false, currentUser = null;
    <% if (user) { %>isLoggedIn = true; currentUser = <%- JSON.stringify(user) %>;<% } %>

    function updateHeaderTime() {
      const now = new Date();
      // Podés mostrar hora si querés
    }
    setInterval(updateHeaderTime, 30000);

    function toggleMeetingDropdown() {
      if (!isLoggedIn) { showToast("🔐 Iniciá sesión primero", "info"); return; }
      document.getElementById("meeting-dropdown").classList.toggle("show");
    }
    function showSigninPrompt() { showToast("🔐 Iniciá sesión para crear reuniones", "info"); }
    
    document.addEventListener("click", (e) => {
      if (!e.target.closest(".new-meeting-wrapper")) document.getElementById("meeting-dropdown").classList.remove("show");
    });

    document.getElementById("room-code-input").addEventListener("input", (e) => {
      document.getElementById("btn-join").disabled = !e.target.value.trim();
    });

    function generateRoomId() {
      return Math.random().toString(36).substr(2,4) + "-" + Math.random().toString(36).substr(2,4) + "-" + Math.random().toString(36).substr(2,4);
    }

    function startInstantMeeting() {
      if (!isLoggedIn) { showToast("🔐 Iniciá sesión primero", "error"); return; }
      window.location.href = `/sala/${generateRoomId()}?host=1`;
    }
    function createMeetingLink() {
      if (!isLoggedIn) { showToast("🔐 Iniciá sesión primero", "error"); return; }
      pendingLink = `${location.origin}/sala/${generateRoomId()}`;
      document.getElementById("generated-link").value = pendingLink;
      document.getElementById("link-modal").style.display = "flex";
    }
    function closeModal() { document.getElementById("link-modal").style.display = "none"; }
    function copyLink() {
      const input = document.getElementById("generated-link");
      input.select();
      navigator.clipboard.writeText(input.value).then(() => showToast("✅ Copiado", "success"));
    }
    function goToMeeting() {
      if (!isLoggedIn) return;
      window.location.href = pendingLink + "?host=1";
    }
    function joinWithCode() {
      let code = document.getElementById("room-code-input").value.trim();
      if (code.includes("/sala/")) { const m = code.match(/\/sala\/([a-zA-Z0-9\-]+)/); if (m) code = m[1]; }
      if (code) window.location.href = `/sala/${code}`;
    }

    function showToast(msg, type="info") {
      const c = document.getElementById("toast-container");
      const t = document.createElement("div");
      t.className = `toast toast-${type}`;
      t.innerHTML = `<span class="material-icons">${type==="success"?"check_circle":type==="error"?"error":"info"}</span>${msg}`;
      c.appendChild(t);
      setTimeout(() => { t.style.opacity="0"; t.style.transform="translateY(-20px)"; setTimeout(()=>t.remove(),300); }, 3000);
    }

    socket.on("server-status", (s) => {
      const b = document.getElementById("maintenance-banner");
      if (s.maintenance) { b.style.display="flex"; document.getElementById("maintenance-msg").textContent = s.message; }
      else b.style.display = "none";
    });
    fetch("/api/status").then(r=>r.json()).then(s=>{ if(s.maintenance){ document.getElementById("maintenance-msg").textContent=s.message; document.getElementById("maintenance-banner").style.display="flex"; }}).catch(()=>{});
    document.getElementById("room-code-input").addEventListener("keydown", (e) => { if(e.key==="Enter"&&!e.target.disabled) joinWithCode(); });
  </script>
</body>
</html>