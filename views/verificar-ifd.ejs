<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Verificación IFD Meet</title>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{
      font-family:'Roboto',sans-serif;
      min-height:100vh;
      background:linear-gradient(135deg,#111214 0%,#1a0a12 50%,#111214 100%);
      display:flex;align-items:center;justify-content:center;padding:20px;
    }
    body::before{
      content:'';position:fixed;inset:0;
      background:radial-gradient(ellipse at 30% 40%,rgba(109,26,46,0.15) 0%,transparent 60%),
                 radial-gradient(ellipse at 70% 70%,rgba(109,26,46,0.1) 0%,transparent 60%);
      pointer-events:none;
    }
    .card{
      background:#fff;border-radius:24px;padding:44px 40px;
      width:100%;max-width:440px;
      box-shadow:0 32px 80px rgba(0,0,0,0.5);
      position:relative;overflow:hidden;
      animation:slideUp .45s cubic-bezier(0.16,1,0.3,1);
    }
    .card::before{
      content:'';position:absolute;top:0;left:0;right:0;height:5px;
      background:linear-gradient(90deg,#6d1a2e,#a02040,#6d1a2e);
    }
    @keyframes slideUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}

    /* ── LOGO ── */
    .logo-wrap{text-align:center;margin-bottom:28px;}
    .logo-img-wrap{
      width:80px;height:80px;border-radius:20px;
      background:linear-gradient(135deg,#6d1a2e,#a02040);
      display:flex;align-items:center;justify-content:center;
      margin:0 auto 14px;
      box-shadow:0 10px 30px rgba(109,26,46,0.4);
      overflow:hidden;
    }
    .logo-img-wrap img{width:100%;height:100%;object-fit:cover;border-radius:20px;}
    .logo-img-wrap .logo-fallback{font-size:36px;}
    h1{font-family:'Google Sans',sans-serif;font-size:26px;font-weight:700;color:#202124;margin-bottom:4px;}
    .sub{font-size:13.5px;color:#5f6368;line-height:1.5;}

    /* ── USUARIO ── */
    .user-row{
      display:flex;align-items:center;gap:12px;
      background:#f8f9fa;border-radius:14px;padding:12px 16px;margin-bottom:24px;
      border:1px solid #e8eaed;
    }
    .user-ava{width:42px;height:42px;border-radius:50%;object-fit:cover;border:2px solid #dadce0;flex-shrink:0;}
    .user-ava-ph{
      width:42px;height:42px;border-radius:50%;background:#6d1a2e;
      color:white;font-weight:700;font-size:16px;
      display:flex;align-items:center;justify-content:center;flex-shrink:0;
    }
    .user-name{font-size:14px;font-weight:600;color:#202124;}
    .user-email{font-size:12px;color:#9aa0a6;}

    /* ── FORM ── */
    .label{display:block;font-size:11px;font-weight:700;color:#444;text-transform:uppercase;letter-spacing:.6px;margin-bottom:8px;}
    .input-wrap{position:relative;margin-bottom:6px;}
    .input-wrap input{
      width:100%;padding:14px 46px 14px 15px;
      border:2px solid #e0e0e0;border-radius:12px;
      font-size:15px;font-family:inherit;color:#202124;
      background:#fafafa;letter-spacing:1.5px;
      transition:border-color .2s,box-shadow .2s;
    }
    .input-wrap input:focus{outline:none;border-color:#6d1a2e;box-shadow:0 0 0 3px rgba(109,26,46,.12);background:#fff;}
    .eye-btn{
      position:absolute;right:13px;top:50%;transform:translateY(-50%);
      background:none;border:none;cursor:pointer;font-size:18px;color:#999;
      padding:4px;transition:color .2s;
    }
    .eye-btn:hover{color:#6d1a2e;}
    .hint{font-size:12px;color:#9aa0a6;margin-bottom:18px;}

    /* ── ERROR ── */
    .error-box{
      background:#fce8e6;border:1px solid #f5c6c4;border-radius:10px;
      padding:10px 14px;font-size:13px;color:#c62828;
      display:flex;align-items:center;gap:8px;margin-bottom:16px;
      animation:shake .3s ease;
    }
    @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-4px)}75%{transform:translateX(4px)}}

    /* ── BOTONES ── */
    .btn-primary{
      width:100%;padding:15px;border:none;border-radius:12px;
      background:linear-gradient(135deg,#6d1a2e,#a02040);
      color:#fff;font-size:15px;font-weight:600;font-family:inherit;
      cursor:pointer;margin-bottom:14px;
      transition:transform .15s,box-shadow .15s;
      box-shadow:0 4px 18px rgba(109,26,46,.35);
    }
    .btn-primary:hover{transform:translateY(-1px);box-shadow:0 7px 28px rgba(109,26,46,.45);}
    .btn-primary:active{transform:translateY(0);}
    .btn-primary:disabled{opacity:.65;cursor:not-allowed;transform:none;}
    .divider{text-align:center;color:#ccc;font-size:12px;margin:4px 0 14px;position:relative;}
    .divider::before,.divider::after{content:'';position:absolute;top:50%;width:40%;height:1px;background:#e8eaed;}
    .divider::before{left:0;}.divider::after{right:0;}
    .btn-google{
      width:100%;padding:13px;border:1.5px solid #dadce0;border-radius:12px;
      background:#fff;color:#202124;font-size:14px;font-family:inherit;
      cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;
      text-decoration:none;transition:background .2s,box-shadow .2s;margin-bottom:10px;
    }
    .btn-google:hover{background:#f8f9fa;box-shadow:0 2px 8px rgba(0,0,0,.1);}
    .btn-google img{width:18px;height:18px;}
    .btn-logout{
      width:100%;padding:11px;border:1px solid #e0e0e0;border-radius:12px;
      background:transparent;color:#888;font-size:13px;font-family:inherit;
      cursor:pointer;transition:all .2s;
    }
    .btn-logout:hover{background:#fce8e6;color:#c62828;border-color:#f5c6c4;}

    /* ── SPINNER ── */
    .spinner{display:inline-block;width:15px;height:15px;border:2.5px solid rgba(255,255,255,.4);
      border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle;margin-right:7px;}
    @keyframes spin{to{transform:rotate(360deg)}}

    /* ── INFO ── */
    .info-box{
      background:#f1f8e9;border:1px solid #c8e6c9;border-radius:10px;
      padding:11px 15px;font-size:12px;color:#33691e;margin-top:16px;line-height:1.5;
    }
    .info-box strong{display:block;margin-bottom:2px;font-size:12.5px;}
  </style>
</head>
<body>
<div class="card">

  <!-- LOGO IFD -->
  <div class="logo-wrap">
    <div class="logo-img-wrap">
      <img src="/img/logo-ifd.png" alt="IFD"
           onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"/>
      <span class="logo-fallback" style="display:none">🎓</span>
    </div>
    <h1>IFD Meet</h1>
    <p class="sub">Instituto de Formación Docente<br>Santa Rosa, Misiones</p>
  </div>

  <!-- USUARIO LOGUEADO -->
  <div class="user-row">
    <% if (user && user.photo) { %>
      <img class="user-ava" src="<%= user.photo %>" alt=""
           onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"/>
      <div class="user-ava-ph" style="display:none"><%= user.name ? user.name[0].toUpperCase() : '?' %></div>
    <% } else { %>
      <div class="user-ava-ph"><%= user && user.name ? user.name[0].toUpperCase() : '?' %></div>
    <% } %>
    <div>
      <div class="user-name"><%= user ? user.name : '' %></div>
      <div class="user-email"><%= user ? user.email : '' %></div>
    </div>
  </div>

  <!-- ERROR -->
  <% if (error) { %>
    <div class="error-box">🔒 <%= error %></div>
  <% } %>

  <!-- FORMULARIO -->
  <form action="/verificar-ifd" method="POST" onsubmit="onSubmit(this)">
    <label class="label" for="pw">Contraseña institucional</label>
    <div class="input-wrap">
      <input type="password" id="pw" name="password"
             placeholder="Ingresá la contraseña del IFD"
             required autocomplete="current-password"/>
      <button type="button" class="eye-btn" onclick="toggleEye()" title="Ver contraseña">👁️</button>
    </div>
    <p class="hint">Solo para docentes y estudiantes del IFD Santa Rosa</p>

    <button type="submit" class="btn-primary" id="submit-btn">
      Verificar y entrar
    </button>
  </form>

  <div class="divider">o</div>
  <a href="/logout" class="btn-logout">Usar otra cuenta de Google</a>

  <div class="info-box">
    <strong>🔐 ¿Por qué se pide contraseña?</strong>
    Garantiza que solo miembros del IFD accedan. Una vez verificado, no se te pedirá de nuevo en este dispositivo.
  </div>
</div>

<script>
  function toggleEye() {
    const inp = document.getElementById('pw');
    const btn = document.querySelector('.eye-btn');
    inp.type = inp.type === 'password' ? 'text' : 'password';
    btn.textContent = inp.type === 'password' ? '👁️' : '🙈';
  }
  function onSubmit(form) {
    const btn = document.getElementById('submit-btn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span>Verificando...';
  }
  // Auto-focus
  document.getElementById('pw').focus();
</script>
</body>
</html>
