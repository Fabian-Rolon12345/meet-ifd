<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verificación IFD - IFD Meet</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --verde: #1a6b3c;
      --verde-claro: #2d9e5f;
      --blanco: #ffffff;
      --gris: #f5f5f5;
      --texto: #1c1c1e;
      --error: #d32f2f;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: linear-gradient(135deg, #0d3b24 0%, #1a6b3c 50%, #0d3b24 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    /* Fondo animado con partículas */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: 
        radial-gradient(circle at 20% 30%, rgba(255,255,255,0.05) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(255,255,255,0.05) 0%, transparent 50%);
      pointer-events: none;
    }

    .card {
      background: rgba(255,255,255,0.97);
      border-radius: 20px;
      padding: 48px 44px;
      width: 100%;
      max-width: 460px;
      box-shadow: 0 24px 64px rgba(0,0,0,0.3);
      animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--verde), var(--verde-claro), var(--verde));
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .logo-section {
      text-align: center;
      margin-bottom: 32px;
    }

    .logo-icon {
      width: 72px;
      height: 72px;
      background: linear-gradient(135deg, var(--verde), var(--verde-claro));
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
      font-size: 32px;
      box-shadow: 0 8px 24px rgba(26,107,60,0.3);
    }

    h1 {
      font-family: 'Playfair Display', serif;
      font-size: 26px;
      color: var(--texto);
      margin-bottom: 6px;
    }

    .subtitle {
      font-size: 14px;
      color: #666;
      line-height: 1.5;
    }

    /* Avatar del usuario logueado */
    .user-info {
      display: flex;
      align-items: center;
      gap: 12px;
      background: var(--gris);
      border-radius: 12px;
      padding: 12px 16px;
      margin-bottom: 28px;
    }

    .user-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--verde-claro);
    }

    .user-avatar-placeholder {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--verde);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 600;
      font-size: 16px;
      flex-shrink: 0;
    }

    .user-details p {
      font-size: 14px;
      color: var(--texto);
      font-weight: 500;
    }

    .user-details span {
      font-size: 12px;
      color: #888;
    }

    .label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #444;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .input-wrapper {
      position: relative;
      margin-bottom: 8px;
    }

    .input-wrapper input[type="password"],
    .input-wrapper input[type="text"] {
      width: 100%;
      padding: 14px 48px 14px 16px;
      border: 2px solid #e0e0e0;
      border-radius: 10px;
      font-size: 15px;
      font-family: inherit;
      color: var(--texto);
      transition: border-color 0.2s, box-shadow 0.2s;
      background: #fafafa;
      letter-spacing: 2px;
    }

    .input-wrapper input:focus {
      outline: none;
      border-color: var(--verde-claro);
      box-shadow: 0 0 0 3px rgba(45,158,95,0.15);
      background: white;
    }

    .toggle-pw {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      font-size: 18px;
      color: #888;
      padding: 4px;
      transition: color 0.2s;
    }

    .toggle-pw:hover { color: var(--verde); }

    .hint {
      font-size: 12px;
      color: #999;
      margin-bottom: 20px;
    }

    .error-msg {
      background: #ffebee;
      color: var(--error);
      border: 1px solid #ffcdd2;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 13px;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn-verificar {
      width: 100%;
      padding: 15px;
      background: linear-gradient(135deg, var(--verde), var(--verde-claro));
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
      box-shadow: 0 4px 16px rgba(26,107,60,0.3);
      margin-bottom: 16px;
      letter-spacing: 0.3px;
    }

    .btn-verificar:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 24px rgba(26,107,60,0.4);
    }

    .btn-verificar:active {
      transform: translateY(0);
    }

    .btn-verificar:disabled {
      opacity: 0.7;
      cursor: not-allowed;
      transform: none;
    }

    .divider {
      text-align: center;
      font-size: 12px;
      color: #bbb;
      margin-bottom: 16px;
    }

    .btn-logout {
      width: 100%;
      padding: 12px;
      background: transparent;
      color: #888;
      border: 1px solid #e0e0e0;
      border-radius: 10px;
      font-size: 13px;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-logout:hover {
      background: #f5f5f5;
      color: var(--error);
      border-color: #ffcdd2;
    }

    .info-box {
      background: #e8f5e9;
      border: 1px solid #c8e6c9;
      border-radius: 10px;
      padding: 12px 16px;
      margin-top: 20px;
      font-size: 12px;
      color: #2e7d32;
      line-height: 1.5;
    }

    .info-box strong { display: block; margin-bottom: 2px; }

    /* Loading state */
    .spinner {
      display: inline-block;
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255,255,255,0.4);
      border-top-color: white;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      vertical-align: middle;
      margin-right: 6px;
    }

    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>

  <div class="card">
    <div class="logo-section">
      <div class="logo-icon">🎓</div>
      <h1>IFD Meet</h1>
      <p class="subtitle">Instituto de Formación Docente<br/>Santa Rosa - Misiones</p>
    </div>

    <!-- Info del usuario logueado con Google -->
    <div class="user-info">
      <% if (user.photo) { %>
        <img class="user-avatar" src="<%= user.photo %>" alt="Foto" />
      <% } else { %>
        <div class="user-avatar-placeholder"><%= user.name ? user.name[0].toUpperCase() : '?' %></div>
      <% } %>
      <div class="user-details">
        <p><%= user.name %></p>
        <span><%= user.email %></span>
      </div>
    </div>

    <!-- Error si la contraseña fue incorrecta -->
    <% if (error && error.length > 0) { %>
      <div class="error-msg">
        <span>🔒</span>
        <span><%= error[0] %></span>
      </div>
    <% } %>

    <!-- Formulario de contraseña -->
    <form id="ifdForm" action="/verificar-ifd" method="POST">
      <label class="label" for="password">Contraseña institucional</label>
      <div class="input-wrapper">
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Ingresá la contraseña del IFD"
          required
          autocomplete="current-password"
        />
        <button type="button" class="toggle-pw" onclick="togglePassword()" title="Ver contraseña">
          👁️
        </button>
      </div>
      <p class="hint">Solo para miembros del IFD Santa Rosa, Misiones</p>

      <button type="submit" class="btn-verificar" id="btnSubmit">
        Verificar y entrar
      </button>
    </form>

    <div class="divider">o</div>

    <a href="/logout">
      <button class="btn-logout">
        Usar otra cuenta de Google
      </button>
    </a>

    <div class="info-box">
      <strong>🔐 ¿Por qué se pide contraseña?</strong>
      Esta verificación garantiza que solo los docentes y estudiantes del IFD puedan acceder. Una vez verificado, no se te pedirá de nuevo.
    </div>
  </div>

  <script>
    function togglePassword() {
      const input = document.getElementById('password');
      const btn = document.querySelector('.toggle-pw');
      if (input.type === 'password') {
        input.type = 'text';
        btn.textContent = '🙈';
      } else {
        input.type = 'password';
        btn.textContent = '👁️';
      }
    }

    document.getElementById('ifdForm').addEventListener('submit', function(e) {
      const btn = document.getElementById('btnSubmit');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner"></span>Verificando...';
    });

    // Focus automático en el campo de contraseña
    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('password').focus();
    });

    // Enter para enviar
    document.getElementById('password').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        document.getElementById('ifdForm').submit();
      }
    });
  </script>
</body>
</html>
