# Google OAuth - Obtenelos en https://console.cloud.google.com
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret

# Session Secret - Generá uno seguro: https://generate-secret.vercel.app/32
SESSION_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Puerto y entorno
PORT=3000
NODE_ENV=production

# Admin
ADMIN_PASS=ifd2024

# URL de tu app publicada
APP_URL=https://ifd-meet.onrender.com

# ============================================
# PLUGNMEET - Videollamadas HD
# ============================================
# Opción 1: Usar servidor demo público (para pruebas)
PLUGNMEET_URL=https://demo.plugnmeet.com

