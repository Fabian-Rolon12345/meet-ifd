{
  "name": "meet-ifd",
  "version": "3.0.0",
  "description": "IFD Meet - Plataforma de Videoconferencias MediaSoup SFU",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "docker-build": "docker build -t ifd-meet:latest .",
    "docker-run": "docker run -p 3000:3000 -p 40000-49999:40000-49999/udp -p 40000-49999:40000-49999/tcp ifd-meet:latest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "connect-flash": "^0.1.1",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "mediasoup": "^3.12.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
